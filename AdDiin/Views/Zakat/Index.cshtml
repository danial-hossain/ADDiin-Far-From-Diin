@model AdDiin.Models.ViewModels.ZakatCalculatorViewModel
@{
    ViewData["Title"] = "Zakat Calculator & Fiqh Guidance | ADDiin";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="bg-gradient-to-r from-amber-950 via-slate-900 to-emerald-950 rounded-3xl p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
            <span class="px-3.5 py-1 bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xs font-bold rounded-full uppercase tracking-wider">
                Third Pillar of Islam
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Zakat Calculator & Guidance</h1>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                Accurately evaluate your annual Zakat (2.5%) based on current Gold & Silver Nisab thresholds. Fulfill your obligation transparently.
            </p>
        </div>

        <div class="p-5 bg-white/10 backdrop-blur-md rounded-2xl border border-white/15 text-center">
            <p class="text-xs text-amber-300 uppercase font-bold tracking-wider">Current Nisab (Silver)</p>
            <p class="text-2xl font-black text-white mt-1">৳115,500</p>
            <p class="text-[11px] text-slate-300">52.5 Tolas / 612.36 Grams</p>
        </div>
    </div>

    <!-- Calculator Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
        <div class="pb-3 border-b border-slate-100">
            <h3 class="font-extrabold text-slate-900 text-lg">Calculate Your Zakat</h3>
            <p class="text-xs text-slate-500">Enter your assets owned continuously for one full lunar year (Hawl)</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label class="text-xs font-bold text-slate-700">Cash in Hand & Bank Accounts (৳)</label>
                <input type="number" id="z_cash" value="0" min="0" oninput="calcZakat()" class="mt-1 w-full text-xs font-bold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
            </div>

            <div>
                <label class="text-xs font-bold text-slate-700">Value of Gold & Silver Owned (৳)</label>
                <input type="number" id="z_gold" value="0" min="0" oninput="calcZakat()" class="mt-1 w-full text-xs font-bold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
            </div>

            <div>
                <label class="text-xs font-bold text-slate-700">Business Inventory & Merchandise (৳)</label>
                <input type="number" id="z_business" value="0" min="0" oninput="calcZakat()" class="mt-1 w-full text-xs font-bold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
            </div>

            <div>
                <label class="text-xs font-bold text-slate-700">Investments, Shares & Savings Bonds (৳)</label>
                <input type="number" id="z_invest" value="0" min="0" oninput="calcZakat()" class="mt-1 w-full text-xs font-bold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
            </div>

            <div class="sm:col-span-2">
                <label class="text-xs font-bold text-red-600">Deductible Liabilities & Immediate Debts (৳)</label>
                <input type="number" id="z_debts" value="0" min="0" oninput="calcZakat()" class="mt-1 w-full text-xs font-bold px-3.5 py-2.5 bg-red-50/50 border border-red-200 rounded-xl" />
            </div>
        </div>

        <!-- Calculated Summary Box -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <span class="text-xs font-bold uppercase text-emerald-800 tracking-wider">Total Net Zakat Payable (2.5%)</span>
                <div class="text-3xl sm:text-4xl font-black text-emerald-950 font-mono mt-1" id="zakatResultDisplay">
                    ৳0
                </div>
                <p class="text-xs text-slate-600 mt-1" id="nisabStatus">Enter your asset values above</p>
            </div>

            <a href="/donate?category=zakat" id="payZakatBtn" class="px-6 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition text-nowrap">
                Pay Zakat Directly &rarr;
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const silverNisab = 115500;
    function calcZakat() {
        const cash = parseFloat(document.getElementById('z_cash').value) || 0;
        const gold = parseFloat(document.getElementById('z_gold').value) || 0;
        const business = parseFloat(document.getElementById('z_business').value) || 0;
        const invest = parseFloat(document.getElementById('z_invest').value) || 0;
        const debts = parseFloat(document.getElementById('z_debts').value) || 0;

        const netAssets = (cash + gold + business + invest) - debts;
        const resultEl = document.getElementById('zakatResultDisplay');
        const statusEl = document.getElementById('nisabStatus');

        if (netAssets >= silverNisab) {
            const zakat = Math.round(netAssets * 0.025);
            resultEl.textContent = '৳' + zakat.toLocaleString();
            statusEl.textContent = '✅ Your net assets (৳' + netAssets.toLocaleString() + ') exceed Nisab threshold. Zakat is obligatory.';
        } else {
            resultEl.textContent = '৳0';
            statusEl.textContent = 'ℹ️ Net assets below Nisab (৳' + silverNisab.toLocaleString() + '). Zakat is not obligatory.';
        }
    }
</script>
}
