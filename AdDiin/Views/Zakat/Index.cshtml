@model AdDiin.Models.ViewModels.ZakatCalculatorViewModel
@{
    ViewData["Title"] = "Zakat Calculator";
}

<div class="bg-emerald-dark text-white py-5">
    <div class="container text-center py-3">
        <h1 class="display-5 fw-extrabold mb-2">🤲 Islamic Zakat Calculator</h1>
        <p class="text-white-75 max-w-700 mx-auto">
            Calculate your obligatory 2.5% Zakat on eligible assets based on authentic Gold and Silver Nisab thresholds.
        </p>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        <!-- Calculator Form -->
        <div class="col-lg-7">
            <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <span class="fs-4">🧮</span>
                    <div>
                        <h4 class="fw-bold mb-0">Assets & Liabilities Details</h4>
                        <small class="text-muted">Enter all assets owned for 1 full lunar year</small>
                    </div>
                </div>

                <form asp-action="Calculate" method="post" id="zakatForm">
                    @Html.AntiForgeryToken()

                    <h6 class="fw-bold text-emerald border-bottom pb-2 mb-3">1. Liquid Cash & Savings</h6>
                    <div class="mb-3">
                        <label asp-for="Cash" class="form-label small fw-semibold">Cash in Hand, Bank Accounts & Savings (৳)</label>
                        <input asp-for="Cash" class="form-control" type="number" step="any" min="0" />
                    </div>

                    <h6 class="fw-bold text-emerald border-bottom pb-2 mb-3 mt-4">2. Gold & Silver Assets</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="GoldWeight" class="form-label small fw-semibold">Gold Weight (Grams)</label>
                            <input asp-for="GoldWeight" class="form-control" type="number" step="any" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GoldPrice" class="form-label small fw-semibold">Gold Price / Gram (৳)</label>
                            <input asp-for="GoldPrice" class="form-control" type="number" step="any" min="0" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SilverWeight" class="form-label small fw-semibold">Silver Weight (Grams)</label>
                            <input asp-for="SilverWeight" class="form-control" type="number" step="any" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SilverPrice" class="form-label small fw-semibold">Silver Price / Gram (৳)</label>
                            <input asp-for="SilverPrice" class="form-control" type="number" step="any" min="0" />
                        </div>
                    </div>

                    <h6 class="fw-bold text-emerald border-bottom pb-2 mb-3 mt-4">3. Business & Investments</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Investments" class="form-label small fw-semibold">Stocks, Mutual Funds & Bonds (৳)</label>
                            <input asp-for="Investments" class="form-control" type="number" step="any" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BusinessInventory" class="form-label small fw-semibold">Commercial Inventory Value (৳)</label>
                            <input asp-for="BusinessInventory" class="form-control" type="number" step="any" min="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OtherAssets" class="form-label small fw-semibold">Other Zakatable Financial Assets (৳)</label>
                        <input asp-for="OtherAssets" class="form-control" type="number" step="any" min="0" />
                    </div>

                    <h6 class="fw-bold text-danger border-bottom pb-2 mb-3 mt-4">4. Deductible Liabilities</h6>
                    <div class="mb-4">
                        <label asp-for="Debts" class="form-label small fw-semibold">Outstanding Short-Term Debts / Bills to Pay (৳)</label>
                        <input asp-for="Debts" class="form-control" type="number" step="any" min="0" />
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-emerald-gradient flex-grow-1 py-3 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-calculator me-1"></i> Calculate Zakat
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-3 px-4 rounded-pill">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Calculation Result / Information -->
        <div class="col-lg-5">
            @if (Model.HasCalculated)
            {
                <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm mb-4">
                    <h4 class="fw-bold mb-3 text-dark">Calculation Summary</h4>

                    @if (Model.IsEligible)
                    {
                        <div class="bg-emerald-light p-4 rounded-4 text-center border border-emerald border-opacity-25 mb-4">
                            <span class="badge bg-emerald text-white px-3 py-1 rounded-pill mb-2">ZAKAT OBLIGATION</span>
                            <div class="text-muted small">Your Payable Zakat (2.5%):</div>
                            <div class="display-4 fw-extrabold text-emerald-dark my-2">
                                ৳ @Model.ZakatPayable.ToString("N2")
                            </div>
                            <small class="text-muted">Purify your wealth and help the needy</small>
                        </div>

                        <div class="table-responsive small mb-4">
                            <table class="table table-borderless table-sm">
                                <tbody>
                                    <tr class="border-bottom">
                                        <td class="text-muted">Total Zakatable Assets:</td>
                                        <td class="text-end fw-bold">৳ @Model.TotalAssets.ToString("N2")</td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted">Deducted Liabilities:</td>
                                        <td class="text-end fw-bold text-danger">- ৳ @Model.Debts.ToString("N2")</td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted">Net Zakatable Wealth:</td>
                                        <td class="text-end fw-bold text-emerald">৳ @Model.NetWealth.ToString("N2")</td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted">Nisab Threshold (Silver basis):</td>
                                        <td class="text-end fw-bold">৳ @Model.NisabThresholdUsed.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Rate Applied:</td>
                                        <td class="text-end fw-bold">2.5%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <a asp-controller="Donate" asp-action="Index" asp-route-category="zakat" asp-route-amount="@Model.ZakatPayable" class="btn btn-warning text-dark w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-heart-fill"></i> Pay Zakat Online Now
                        </a>
                    }
                    else
                    {
                        <div class="bg-light p-4 rounded-4 text-center border mb-4">
                            <i class="bi bi-info-circle-fill fs-1 text-warning mb-2 d-block"></i>
                            <h5 class="fw-bold mb-2">Not Eligible for Zakat</h5>
                            <p class="text-muted small mb-0">
                                Your net wealth of <strong>৳ @Model.NetWealth.ToString("N2")</strong> is below the current Nisab threshold of <strong>৳ @Model.NisabThresholdUsed.ToString("N2")</strong>. Zakat is not obligatory on you at this time.
                            </p>
                        </div>
                    }
                </div>
            }

            <!-- Educational Info Card -->
            <div class="card card-custom p-4 border rounded-4 bg-light shadow-sm">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-book text-emerald me-2"></i> Zakat Rules at a Glance</h5>
                <ul class="list-unstyled small text-muted space-y-2 mb-0">
                    <li class="mb-2"><strong>Gold Nisab:</strong> 7.5 Tolas = 87.48 Grams of gold.</li>
                    <li class="mb-2"><strong>Silver Nisab:</strong> 52.5 Tolas = 612.36 Grams of silver (Standard benchmark for mixed wealth).</li>
                    <li class="mb-2"><strong>Rate:</strong> 2.5% on total net assets held for one Hawl (lunar year).</li>
                    <li><strong>Beneficiaries:</strong> Poor, needy, destitute, and designated categories in Surah At-Tawbah (9:60).</li>
                </ul>
            </div>
        </div>
    </div>
</div>