}
.scan-beam {
    position: absolute; left: 0; right: 0; height: 3px; z-index: 10; pointer-events: none;
    background: linear-gradient(to right, transparent, rgba(16,185,129,.58) 30%, rgba(52,211,153,.95) 50%, rgba(16,185,129,.58) 70%, transparent);
    box-shadow: 0 0 16px rgba(52,211,153,.45);
