@model AdDiin.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "ADDiin | Personal Islamic Growth Platform";
}

@section Styles {
<style>
/* ============================================================
   AD-DIIN CINEMATIC STORYTELLING — ENHANCED
   ============================================================ */

/* --- Reset home top margin --- */
.home-cinematic { margin-top: -1rem; }

/* ============================================================
   SCROLL REVEAL SYSTEM
   ============================================================ */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity .95s cubic-bezier(.2,.7,.2,1), transform .95s cubic-bezier(.2,.7,.2,1);
}
.reveal.from-left  { transform: translateX(-44px); }
.reveal.from-right { transform: translateX(44px); }
.reveal.scale-up   { transform: scale(.93) translateY(18px); }
.reveal.visible    { opacity: 1 !important; transform: none !important; }
.reveal-d1 { transition-delay: .10s; }
.reveal-d2 { transition-delay: .20s; }
.reveal-d3 { transition-delay: .30s; }
.reveal-d4 { transition-delay: .40s; }
.reveal-d5 { transition-delay: .50s; }

/* ============================================================
   STORY PROGRESS INDICATOR
   ============================================================ */
.story-nav {
    position: fixed; right: 1.25rem; top: 50%;
    transform: translateY(-50%); z-index: 300;
    display: flex; flex-direction: column; gap: .55rem; align-items: center;
}
.story-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(200,148,50,.22); border: 1px solid rgba(200,148,50,.18);
    cursor: pointer; transition: all .38s cubic-bezier(.2,.7,.2,1); position: relative;
    appearance: none; padding: 0; display: block;
}
.story-dot.active {
    width: 9px; height: 9px; background: #c89432;
    box-shadow: 0 0 12px rgba(200,148,50,.55), 0 0 24px rgba(200,148,50,.2);
}
.story-dot::after {
    content: attr(data-label); position: absolute; right: calc(100% + .7rem);
    top: 50%; transform: translateY(-50%); font-size: .56rem; font-weight: 800;
    color: rgba(200,148,50,.75); white-space: nowrap; opacity: 0;
    transition: opacity .22s; pointer-events: none; letter-spacing: .06em;
    text-transform: uppercase;
}
.story-dot:hover::after { opacity: 1; }
@@media (max-width: 1023px) { .story-nav { display: none; } }

/* ============================================================
   SHARED STORY TYPOGRAPHY
   ============================================================ */
.story-label {
    display: inline-flex; align-items: center; gap: .45rem;
    font-size: .6rem; font-weight: 800; letter-spacing: .14em;
    text-transform: uppercase; color: rgba(200,148,50,.82);
    padding: .3rem .8rem; border-radius: 999px;
    border: 1px solid rgba(200,148,50,.22); background: rgba(200,148,50,.07);
}
.story-label-green {
    color: rgba(52,211,153,.82); border-color: rgba(52,211,153,.22);
    background: rgba(52,211,153,.07);
}
.story-headline {
    font-weight: 900; letter-spacing: -.045em; line-height: 1.0; color: #fff;
}
.story-subtext { color: rgba(255,255,255,.52); line-height: 1.75; font-size: .96rem; }
.story-em {
    background: linear-gradient(135deg, #e8d698, #c89432);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.story-em-green {
    background: linear-gradient(135deg, #6ee7b7, #34d399);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}

/* ============================================================
   SECTION FLOW SEPARATORS
   ============================================================ */
.section-flow-down {
    position: absolute; bottom: -1px; left: 0; right: 0;
    height: 80px; pointer-events: none; z-index: 5;
}
.section-flow-up {
    position: absolute; top: -1px; left: 0; right: 0;
    height: 80px; pointer-events: none; z-index: 5;
}

/* ============================================================
   ISLAMIC GEOMETRIC PATTERN OVERLAY
   ============================================================ */
.geo-pattern {
    position: absolute; inset: 0; pointer-events: none;
    opacity: .045; z-index: 0;
    background-image:
        repeating-linear-gradient(
            0deg,
            rgba(200,148,50,.6) 0px, transparent 1px,
            transparent 64px, rgba(200,148,50,.6) 65px
        ),
        repeating-linear-gradient(
            90deg,
            rgba(200,148,50,.6) 0px, transparent 1px,
            transparent 64px, rgba(200,148,50,.6) 65px
        ),
        repeating-linear-gradient(
            45deg,
            rgba(200,148,50,.35) 0px, transparent 1px,
            transparent 46px, rgba(200,148,50,.35) 47px
        ),
        repeating-linear-gradient(
            -45deg,
            rgba(200,148,50,.35) 0px, transparent 1px,
            transparent 46px, rgba(200,148,50,.35) 47px
        );
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 80%);
}
.geo-pattern-edge {
    position: absolute; inset: 0; pointer-events: none; opacity: .03;
    background-image:
        repeating-linear-gradient(
            30deg,
            rgba(52,211,153,.7) 0px, transparent 1px, transparent 55px
        ),
        repeating-linear-gradient(
            -30deg,
            rgba(52,211,153,.7) 0px, transparent 1px, transparent 55px
        );
    mask-image: linear-gradient(to bottom, transparent 10%, black 40%, black 60%, transparent 90%);
}

/* ============================================================
   CHAPTER 0 — HERO
   ============================================================ */
.hero-cinematic {
    min-height: min(860px, 100svh);
    background:
        radial-gradient(ellipse at 78% 10%, rgba(200,148,50,.26), transparent 30rem),
        radial-gradient(ellipse at 6%  90%, rgba(11,155,112,.3),  transparent 32rem),
        radial-gradient(ellipse at 40% 50%, rgba(5,100,80,.32),   transparent 45rem),
        linear-gradient(145deg, #010c0a 0%, #031914 35%, #052e24 65%, #073a30 100%);
    position: relative; overflow: hidden; isolation: isolate;
    perspective: 1200px;
}
.hero-sky {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
        radial-gradient(circle at 78% 22%, rgba(238,216,143,.16) 0 1px, transparent 2px),
        radial-gradient(circle at 66% 13%, rgba(255,255,255,.3) 0 1px, transparent 2px),
        radial-gradient(circle at 89% 44%, rgba(127,217,181,.34) 0 1px, transparent 2px),
        radial-gradient(circle at 57% 31%, rgba(255,255,255,.22) 0 1px, transparent 2px);
    background-size: 240px 180px, 320px 220px, 280px 250px, 410px 290px;
    animation: sky-drift 28s linear infinite;
}
.hero-sky-cloud {
    position: absolute; z-index: 1; pointer-events: none;
    width: clamp(15rem, 27vw, 28rem); height: 4.6rem;
    border-radius: 999px; filter: blur(7px);
    background: linear-gradient(180deg, rgba(122,164,153,.2), rgba(6,32,28,.08));
    box-shadow: 3.8rem -1.8rem 0 -1rem rgba(156,192,177,.16), 8rem -.8rem 0 -1.3rem rgba(145,185,171,.14), 12rem .4rem 0 -1.6rem rgba(123,166,153,.12);
    opacity: .68; animation: cloud-drift 30s ease-in-out infinite alternate;
    translate: var(--mouse-x, 0px) var(--mouse-y, 0px);
    transition: translate .3s ease-out;
}
.hero-sky-cloud.cloud-left { left: -8rem; top: 24%; }
.hero-sky-cloud.cloud-right { right: -10rem; top: 42%; transform: scale(.82); opacity: .45; animation-delay: -8s; }
.hero-sky-cloud.cloud-low { left: 38%; bottom: 12%; transform: scale(.7); opacity: .3; animation-delay: -14s; }
@@keyframes sky-drift { from { background-position: 0 0, 0 0, 0 0, 0 0; } to { background-position: 60px 24px, -40px 18px, 30px -18px, -55px 30px; } }
@@keyframes cloud-drift { from { margin-left: -10px; } to { margin-left: 22px; } }

/* Hero grid */
.hero-grid {
    position: absolute; inset: 0; pointer-events: none; opacity: .08;
    background-image:
        linear-gradient(rgba(200,148,50,.8) 1px, transparent 1px),
        linear-gradient(90deg, rgba(200,148,50,.8) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 70% 70% at center, black 15%, transparent 75%);
    animation: grid-drift 30s linear infinite;
}
@@keyframes grid-drift { from{background-position:0 0} to{background-position:80px 80px} }

/* Hero rings */
.hero-ring {
    position: absolute; border-radius: 50%;
    border: 1px solid rgba(200,148,50,.12); pointer-events: none;
    translate: var(--mouse-x, 0px) var(--mouse-y, 0px);
    transition: translate .25s ease-out;
}
.hero-ring.r1 { width: 32rem; height: 32rem; top: -12rem; right: -6rem; animation: ring-breathe 12s ease-in-out infinite alternate; }
.hero-ring.r2 { width: 52rem; height: 52rem; top: -24rem; right: -16rem; border-color: rgba(200,148,50,.055); animation: ring-breathe 16s ease-in-out infinite alternate-reverse; }
.hero-ring.r3 { width: 22rem; height: 22rem; bottom: -6rem; left: -8rem; border-color: rgba(11,155,112,.2); animation: ring-breathe 10s ease-in-out infinite alternate; }
@@keyframes ring-breathe { from{opacity:.5;transform:scale(.95)} to{opacity:1;transform:scale(1.05)} }

/* Hero arch */
.hero-arch {
    position: absolute; pointer-events: none;
    width: clamp(260px, 30vw, 500px); height: clamp(340px, 40vw, 640px);
    right: -3%; bottom: -15%;
    border: 1px solid rgba(226,203,144,.22); border-bottom: 0;
    border-radius: 50% 50% 0 0;
    animation: arch-float 13s ease-in-out infinite;
    translate: var(--mouse-x, 0px) var(--mouse-y, 0px);
    transition: translate .2s ease-out;
}
.hero-arch::before, .hero-arch::after {
    content: ""; position: absolute; bottom: 0; width: 1px; height: 120%;
    background: rgba(226,203,144,.08);
}
.hero-arch::before { left: 18%; transform: rotate(6deg); }
.hero-arch::after  { right: 18%; transform: rotate(-6deg); }

/* Inner arch (nested depth) */
.hero-arch-inner {
    position: absolute; pointer-events: none;
    width: clamp(160px, 18vw, 320px); height: clamp(210px, 24vw, 400px);
    right: -1%; bottom: -10%;
    border: 1px solid rgba(226,203,144,.1); border-bottom: 0;
    border-radius: 50% 50% 0 0;
    animation: arch-float 13s 2s ease-in-out infinite;
    translate: var(--mouse-x, 0px) var(--mouse-y, 0px);
    transition: translate .24s ease-out;
}

/* Atmospheric 3D mosque silhouette */
.hero-mosque {
    position: absolute; z-index: 0; pointer-events: none;
    right: clamp(-5rem, -4vw, -1rem); bottom: -1px;
    width: min(62vw, 760px); height: min(43vw, 430px);
    perspective: 900px; transform-style: preserve-3d;
    opacity: 0; filter: drop-shadow(0 24px 34px rgba(0,0,0,.22));
    animation: mosque-float-3d 14s ease-in-out infinite;
    translate: var(--mouse-x, 0px) var(--mouse-y, 0px);
    transition: translate .18s ease-out;
}
.hero-3d-mosque {
    position: absolute;
    z-index: 2;
    right: clamp(-4rem, 1vw, 4rem);
    bottom: 0;
    width: min(64vw, 820px);
    height: min(58vw, 620px);
    pointer-events: none;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,.42));
}
.hero-mosque::before {
    content: "";
    position: absolute;
    inset: 18% 8% 0;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(127,217,181,.2), transparent 68%);
    filter: blur(24px);
    transform: translateZ(-40px) scale(1.15);
}
.mosque-ground {
    position: absolute; left: 4%; right: 0; bottom: 0; height: 42%;
    background: linear-gradient(180deg, rgba(5,44,35,.34), rgba(1,13,11,.9));
    clip-path: polygon(0 100%, 0 38%, 7% 38%, 7% 25%, 17% 25%, 17% 38%, 25% 38%, 25% 12%, 75% 12%, 75% 38%, 83% 38%, 83% 25%, 93% 25%, 93% 38%, 100% 38%, 100% 100%);
    transform: rotateX(58deg) translateZ(-24px) scaleY(.72);
    transform-origin: bottom center;
    box-shadow: 0 28px 35px rgba(0,0,0,.48), inset 0 12px 22px rgba(127,217,181,.08);
}
.mosque-main {
    position: absolute; left: 25%; bottom: 0; width: 50%; height: 48%;
    border: 1px solid rgba(226,203,144,.2); border-bottom: 0;
    background: linear-gradient(135deg, rgba(18,91,69,.24), rgba(2,25,20,.72));
    clip-path: polygon(0 100%, 0 32%, 12% 32%, 18% 13%, 27% 32%, 73% 32%, 82% 13%, 88% 32%, 100% 32%, 100% 100%);
    transform: rotateX(7deg) rotateY(-8deg) translateZ(20px);
    transform-style: preserve-3d;
    box-shadow:
        inset 0 18px 40px rgba(200,148,50,.05),
        18px 18px 0 rgba(2,24,19,.42),
        30px 30px 28px rgba(0,0,0,.3),
        0 0 36px rgba(127,217,181,.1);
}
.mosque-main::before {
    content: ""; position: absolute; left: 50%; bottom: 0;
    width: 22%; height: 62%; transform: translateX(-50%);
    border: 1px solid rgba(226,203,144,.25); border-bottom: 0;
    border-radius: 50% 50% 0 0;
    background: linear-gradient(180deg, rgba(200,148,50,.12), rgba(2,18,14,.72));
}
.mosque-main::after {
    content: ""; position: absolute; left: 50%; top: 19%; width: 34%; height: 28%;
    transform: translateX(-50%); border: 1px solid rgba(226,203,144,.16);
    border-radius: 50% 50% 8% 8%; background: rgba(200,148,50,.06);
    box-shadow: 9px 6px 0 rgba(2,24,19,.34);
}
.mosque-dome {
    position: absolute; left: 50%; bottom: 43%; width: 27%; height: 28%;
    transform: translateX(-50%) translateZ(64px) rotateX(-8deg);
    transform-style: preserve-3d;
    border: 1px solid rgba(226,203,144,.27); border-bottom: 0;
    border-radius: 50% 50% 12% 12%;
    background: radial-gradient(ellipse at 45% 25%, rgba(226,203,144,.25), rgba(5,59,44,.35) 58%, rgba(2,20,15,.65));
}
.mosque-dome::after {
    content: ""; position: absolute; left: 50%; top: -20%;
    width: 1px; height: 23%; background: rgba(226,203,144,.4);
    box-shadow: 0 -5px 0 -0.35px rgba(226,203,144,.45);
}
.mosque-minaret {
    position: absolute; bottom: 0; width: 7%; height: 88%;
    border: 1px solid rgba(226,203,144,.18);
    background: linear-gradient(90deg, rgba(2,25,20,.82), rgba(22,99,74,.28), rgba(2,25,20,.82));
    transform: translateZ(46px) rotateX(5deg) rotateY(-5deg);
    transform-style: preserve-3d;
    box-shadow: 10px 14px 0 rgba(1,16,13,.38), 18px 24px 20px rgba(0,0,0,.24);
}
.mosque-minaret::before {
    content: ""; position: absolute; left: 50%; top: -8%; width: 170%; height: 5%;
    transform: translateX(-50%); background: rgba(226,203,144,.3);
    box-shadow: 0 -7px 0 -1px rgba(226,203,144,.22);
}
.mosque-minaret::after {
    content: ""; position: absolute; left: 50%; top: -19%; width: 42%; height: 14%;
    transform: translateX(-50%); border: 1px solid rgba(226,203,144,.25);
    border-radius: 50% 50% 0 0; background: rgba(7,52,40,.7);
}
.mosque-window {
    position: absolute; z-index: 2; bottom: 20%; width: 7%; height: 18%;
    border: 1px solid rgba(255,241,181,.46); border-radius: 50% 50% 18% 18%;
    background: linear-gradient(180deg, rgba(255,246,193,.95), rgba(200,148,50,.26));
    box-shadow: 0 0 16px rgba(255,221,119,.6), inset 0 -8px 10px rgba(120,75,20,.2);
    animation: mosque-light 4s ease-in-out infinite alternate;
}
.mosque-window.w1 { left: 34%; }
.mosque-window.w2 { left: 46.5%; bottom: 24%; height: 23%; animation-delay: -.9s; }
.mosque-window.w3 { right: 34%; animation-delay: -1.8s; }
@@keyframes mosque-light { from { opacity: .65; filter: brightness(.9); } to { opacity: 1; filter: brightness(1.18); } }
.mosque-minaret.left { left: 10%; }
.mosque-minaret.right { right: 8%; height: 78%; }
@@keyframes mosque-float-3d {
    0%, 100% { transform: translateY(0) rotateX(calc(2deg + var(--tilt-y, 0deg))) rotateY(calc(-4deg + var(--tilt-x, 0deg))) rotateZ(-.4deg); }
    50% { transform: translateY(-10px) rotateX(calc(5deg + var(--tilt-y, 0deg))) rotateY(calc(4deg + var(--tilt-x, 0deg))) rotateZ(.4deg); }
}

/* 3D moon and cloud atmosphere */
.hero-moon-scene {
    position: absolute; z-index: 0; pointer-events: none;
    top: clamp(2rem, 7vh, 5rem); right: clamp(5%, 11vw, 13%);
    width: clamp(10rem, 18vw, 17rem); height: clamp(10rem, 18vw, 17rem);
    perspective: 900px; transform-style: preserve-3d;
    animation: moon-scene-float 12s ease-in-out infinite;
    translate: var(--mouse-x, 0px) var(--mouse-y, 0px);
    transition: translate .22s ease-out;
}
.hero-moon {
    position: absolute; inset: 10%; border-radius: 50%;
    overflow: hidden; transform: rotateY(-18deg) rotateX(8deg) translateZ(20px);
    background:
        radial-gradient(circle at 31% 29%, rgba(255,250,218,.98) 0 4%, transparent 5%),
        radial-gradient(circle at 65% 67%, rgba(12,35,31,.28) 0 7%, transparent 8%),
        radial-gradient(circle at 39% 69%, rgba(12,35,31,.2) 0 5%, transparent 6%),
        linear-gradient(105deg, #fff6c8 0 38%, #c0b995 52%, #172c29 69%, #061512 100%);
    box-shadow:
        -16px 10px 28px rgba(0,0,0,.55),
        inset -20px -10px 35px rgba(0,0,0,.62),
        inset 12px 8px 22px rgba(255,250,218,.3),
        0 0 28px rgba(235,215,142,.2), 0 0 76px rgba(200,148,50,.1);
}
.hero-moon::before {
    content: ""; position: absolute; inset: -8%;
    border-radius: 50%;
    background:
        radial-gradient(circle at 24% 40%, rgba(64,65,57,.18) 0 5%, transparent 6%),
        radial-gradient(circle at 52% 22%, rgba(64,65,57,.2) 0 4%, transparent 5%),
        radial-gradient(circle at 71% 48%, rgba(64,65,57,.2) 0 7%, transparent 8%),
        radial-gradient(circle at 41% 78%, rgba(64,65,57,.16) 0 6%, transparent 7%);
    mix-blend-mode: multiply; opacity: .75;
}
.hero-moon::after {
    content: ""; position: absolute; z-index: 2;
    top: -5%; left: -25%; width: 88%; height: 110%;
    border-radius: 50%;
    background:
        radial-gradient(circle at 72% 42%, rgba(12,35,31,.5) 0 5%, transparent 6%),
        linear-gradient(145deg, #08251f, #020c0a 72%);
    box-shadow: inset -10px -2px 18px rgba(0,0,0,.4), 8px 0 24px rgba(0,0,0,.28);
}
.moon-halo {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1px solid rgba(255,237,164,.18);
    box-shadow: 0 0 0 1.2rem rgba(255,223,129,.035), 0 0 0 2.8rem rgba(255,223,129,.018);
    animation: moon-halo-pulse 5s ease-in-out infinite alternate;
}
.moon-cloud {
    position: absolute; z-index: 2; height: 18%; width: 74%;
    border-radius: 999px; filter: blur(1.5px);
    background: linear-gradient(180deg, rgba(214,232,219,.32), rgba(46,79,69,.18));
    box-shadow: 2.2rem -.7rem 0 -.25rem rgba(204,226,213,.26), 4rem .1rem 0 -.65rem rgba(193,219,205,.2);
    opacity: .72; transform: translateZ(48px);
}
.moon-cloud::before, .moon-cloud::after {
    content: ""; position: absolute; bottom: 35%; border-radius: 50% 50% 35% 35%;
    background: inherit;
}
.moon-cloud::before { left: 22%; width: 28%; height: 130%; }
.moon-cloud::after { left: 47%; width: 24%; height: 105%; }
.moon-cloud.cloud-one { left: -5%; top: 42%; transform: translateZ(48px) rotate(-5deg); }
.moon-cloud.cloud-two { right: -12%; top: 66%; width: 62%; opacity: .48; transform: translateZ(10px) rotate(5deg); }
@@keyframes moon-scene-float {
    0%, 100% { transform: translate3d(0, 0, 0) rotateZ(-1deg); }
    50% { transform: translate3d(-8px, 10px, 18px) rotateZ(1deg); }
}
@@keyframes moon-halo-pulse {
    from { opacity: .55; transform: scale(.96); }
    to { opacity: 1; transform: scale(1.04); }
}
@@media (max-width: 767px) {
    .hero-moon-scene { top: 2.7rem; right: -2.5rem; opacity: .62; transform: scale(.78); }
}

@@media (max-width: 767px) {
    .hero-mosque { right: -20%; width: 125vw; height: 56vw; opacity: .58; }
    .hero-3d-mosque { right: -18%; width: 125vw; height: 78vw; opacity: .78; }
    .hero-sky-cloud.cloud-low { left: 18%; bottom: 19%; }
}

@@keyframes arch-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-16px)} }
.hero-content-anim { animation: hero-in .95s cubic-bezier(.2,.7,.2,1) both; translate: var(--mouse-x, 0px) var(--mouse-y, 0px); transition: translate .2s ease-out; }
.hero-card-anim    { animation: hero-card-in 1.05s .18s cubic-bezier(.2,.7,.2,1) both; translate: var(--mouse-x, 0px) var(--mouse-y, 0px); transition: translate .2s ease-out; }
.hero-float        { animation: arch-float 10s 1s ease-in-out infinite; }
@@keyframes hero-in      { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:none} }
@@keyframes hero-card-in { from{opacity:0;transform:translateY(40px) rotateX(12deg)} to{opacity:1;transform:none} }

/* Radial glow behind hero text */
.hero-glow {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    width: 60vw; height: 60vw; max-width: 700px; max-height: 700px;
    border-radius: 50%; pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(11,155,112,.12), transparent 65%);
    animation: glyph-pulse 5s ease-in-out infinite alternate;
    transition: translate .3s ease-out;
}

/* ============================================================
   CHAPTER 1 — WHY (CHAOS → CONVERGENCE)
   ============================================================ */
.ch-why {
    background: linear-gradient(165deg, #040e0c 0%, #061814 50%, #03100d 100%);
    min-height: 80vh; position: relative; overflow: hidden;
}
.chaos-fragment {
    position: absolute; font-size: .68rem; font-weight: 700;
    padding: .28rem .68rem; border-radius: 999px; backdrop-filter: blur(6px);
    pointer-events: none; opacity: 0; white-space: nowrap;
    transition: opacity .65s ease, transform 1.6s cubic-bezier(.2,.7,.2,1),
                left 1.6s cubic-bezier(.2,.7,.2,1), top 1.6s cubic-bezier(.2,.7,.2,1);
}
.chaos-fragment.scattered { opacity: 1; }
.chaos-fragment.converged { opacity: 0 !important; transform: scale(.06) !important; }
.cf-bg   { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.13); color: rgba(255,255,255,.72); }
.cf-gold { background: rgba(200,148,50,.1);   border: 1px solid rgba(200,148,50,.32);   color: rgba(200,148,50,.92); }
.cf-grn  { background: rgba(11,155,112,.1);   border: 1px solid rgba(11,155,112,.32);   color: rgba(52,211,153,.92); }
.ad-glyph {
    width: 7rem; height: 7rem; border-radius: 50%;
