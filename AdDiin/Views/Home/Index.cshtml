   FINAL CTA
   ============================================================ */
.ch-final {
    background:
        radial-gradient(ellipse at 50% 26%, rgba(200,148,50,.18), transparent 38rem),
        radial-gradient(ellipse at 26% 84%, rgba(11,155,112,.2),  transparent 32rem),
