}
@@keyframes scan-move { from{top:7%} to{top:90%} }
.chip { display: inline-flex; align-items: center; gap: .32rem; font-size: .62rem; font-weight: 800; padding: .26rem .6rem; border-radius: 999px; }
.chip-ok   { background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.3); color: rgba(52,211,153,.9); }
