}
.ai-src { display: inline-flex; align-items: center; gap: .3rem; font-size: .6rem; font-weight: 800; padding: .2rem .52rem; border-radius: 999px; background: rgba(200,148,50,.1); border: 1px solid rgba(200,148,50,.24); color: rgba(200,148,50,.9); }
.ai-typing { display: inline-flex; gap: 4px; align-items: center; padding: .42rem .68rem; }
