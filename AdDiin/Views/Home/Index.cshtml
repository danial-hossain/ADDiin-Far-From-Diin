}
.comm-card:hover {
    border-color: rgba(52,211,153,.32); background: rgba(11,155,112,.08);
    transform: translateY(-5px); box-shadow: 0 16px 40px rgba(11,155,112,.12);
}

/* ============================================================
   CHAPTER 9 — PERSONAL GROWTH
   ============================================================ */
.ch-growth {
    background:
        radial-gradient(ellipse at 62% 42%, rgba(11,155,112,.12), transparent 30rem),
        linear-gradient(167deg, #040c0a, #081a1c, #061418);
    position: relative; overflow: hidden;
}
.g-ring {
    border: 2px solid; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    transition: all .42s ease;
}
.g-ring:hover { transform: scale(1.08); }
.streak-bar {
    border-radius: .2rem .2rem 0 0; transform-origin: bottom;
    animation: streak-grow .9s cubic-bezier(.2,.7,.2,1) var(--delay,0s) both;
}
@@keyframes streak-grow { from{transform:scaleY(0);opacity:0} to{transform:scaleY(1);opacity:1} }

/* ============================================================
   CHAPTER 10 — ECOSYSTEM
   ============================================================ */
.ch-ecosystem {
    background:
        radial-gradient(ellipse at 50% 50%, rgba(11,155,112,.18), transparent 48rem),
        radial-gradient(ellipse at 8%  92%, rgba(200,148,50,.1),  transparent 26rem),
