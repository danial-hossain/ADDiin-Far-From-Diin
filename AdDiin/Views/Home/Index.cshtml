/* ============================================================
   CHAPTER 7 — GIVING
   ============================================================ */
.ch-zakat {
    background:
        radial-gradient(ellipse at 16% 82%, rgba(200,148,50,.12), transparent 30rem),
        radial-gradient(ellipse at 84% 18%, rgba(11,155,112,.06), transparent 22rem),
        linear-gradient(162deg, #060f0c, #091612, #07120e);
    position: relative; overflow: hidden;
}
/* Flowing particles (charity symbolism) */
.giving-particles {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden;
}
.giving-particle {
    position: absolute; border-radius: 50%; opacity: 0;
    animation: particle-flow var(--dur, 6s) var(--delay, 0s) ease-in-out infinite;
}
@@keyframes particle-flow {
    0%   { opacity:0; transform: translateY(100%) scale(.5); }
    15%  { opacity:.6; }
    85%  { opacity:.4; }
    100% { opacity:0; transform: translateY(-100%) scale(1.2); }
}

/* ============================================================
   CHAPTER 8 — COMMUNITY
   ============================================================ */
.ch-community {
    background:
        radial-gradient(ellipse at 50% 0, rgba(11,155,112,.14), transparent 38rem),
