/* ============================================================
   CHAPTER 6 — PRODUCT ANALYZER
   ============================================================ */
.ch-product {
    background:
        radial-gradient(ellipse at 84% 50%, rgba(16,185,129,.1), transparent 30rem),
        linear-gradient(147deg, #030c09, #051110, #040e0c);
    position: relative; overflow: hidden;
}
.product-mock {
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1);
