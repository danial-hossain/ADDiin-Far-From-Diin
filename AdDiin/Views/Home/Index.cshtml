    border: 1px solid rgba(255,255,255,.16); padding: .9rem 1.9rem; border-radius: 999px;
    transition: all .32s ease;
}
.cta-secondary:hover { color: #fff; border-color: rgba(255,255,255,.36); background: rgba(255,255,255,.06); }

/* ============================================================
   NARRATIVE REVEAL LINES (Progressive text)
   ============================================================ */
.narrative-line {
