    top: 50%; left: 50%; transform: translate(-50%,-50%);
    animation: orbit-spin 40s linear infinite;
}
.eco-orbit-ring.or1 { width: 78%; height: 78%; }
.eco-orbit-ring.or2 { width: 95%; height: 95%; border-color: rgba(11,155,112,.09); animation-duration: 60s; animation-direction: reverse; }
.eco-center {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 7rem; height: 7rem; border-radius: 50%;
    background: radial-gradient(circle at 38% 38%, rgba(200,148,50,.42), rgba(11,155,112,.3) 60%, transparent);
    border: 2px solid rgba(200,148,50,.52);
    display: flex; align-items: center; justify-content: center; font-size: 2rem; z-index: 5;
    animation: glyph-pulse 3.5s ease-in-out infinite alternate;
    box-shadow: 0 0 60px rgba(200,148,50,.22), 0 0 120px rgba(11,155,112,.14);
}
.eco-node {
    position: absolute; width: 4.75rem; height: 4.75rem; border-radius: 50%;
    background: rgba(3,38,30,.94); border: 1px solid rgba(200,148,50,.3);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .2rem;
    font-size: .52rem; font-weight: 800; text-align: center; color: rgba(200,148,50,.9);
    backdrop-filter: blur(10px); transition: all .38s ease; z-index: 3;
    transform: translate(-50%,-50%); text-decoration: none;
}
.eco-node:hover {
    border-color: rgba(200,148,50,.7); box-shadow: 0 0 24px rgba(200,148,50,.22);
    transform: translate(-50%,-50%) scale(1.16); color: rgba(200,148,50,1);
    background: rgba(5,55,45,.96);
}
.eco-icon { font-size: 1.2rem; }
