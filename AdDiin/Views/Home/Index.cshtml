                        {
                            var p = pList[pi];
                            var pt = DateTime.Today.Add(p.PrayerTimeValue).ToString("hh:mm tt");
                            var isNext = Model.NextPrayer != null && p.DisplayNameEn == Model.NextPrayer.DisplayNameEn;
                            <div class="prayer-pill @(isNext ? "is-next" : "")">
                                <div class="flex items-center gap-3">
                                    <span class="text-base">@pIcons[pi]</span>
                                    <div>
                                        <p class="text-sm font-bold text-white">@p.DisplayNameEn</p>
                                        <p class="text-[10px]" style="color:rgba(255,255,255,.36)">@p.DisplayNameBn</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    @if (isNext)
                                    {
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:rgba(200,148,50,.18);color:rgba(200,148,50,.94)">NEXT</span>
                                    }
                                    <span class="font-mono text-sm font-bold" style="color:rgba(255,255,255,.8)">@pt</span>
