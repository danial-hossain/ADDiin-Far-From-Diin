                    <div class="flex gap-1 rounded-xl overflow-hidden h-4 mb-4">
                        <div class="sky-bar flex-1" style="background:linear-gradient(135deg,#1c0f04,#3d2204)" title="Fajr"></div>
                        <div class="sky-bar flex-1" style="background:linear-gradient(135deg,#19390a,#0a5620)" title="Dhuhr"></div>
                        <div class="sky-bar flex-1" style="background:linear-gradient(135deg,#3d2b04,#6c4808)" title="Asr"></div>
                        <div class="sky-bar flex-1" style="background:linear-gradient(135deg,#2d0f28,#5c1f52)" title="Maghrib"></div>
                        <div class="sky-bar flex-1" style="background:linear-gradient(135deg,#050a1e,#0c163c)" title="Isha"></div>
                    </div>
                    <div class="space-y-2">
                        @{
                            var pList = (Model.AzanPrayers.Any() ? Model.AzanPrayers : Model.JamaatPrayers).Take(5).ToList();
                            var pIcons = new[] { "🌅", "☀️", "🌤️", "🌆", "🌙" };
                        }
