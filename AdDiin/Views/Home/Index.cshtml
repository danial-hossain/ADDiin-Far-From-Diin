@section Scripts {
<script>
(function () {
    'use strict';

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ===================================================
       HERO CANVAS PARTICLES
       =================================================== */
    var canvas = document.getElementById('heroCanvas');
    if (canvas && !reduceMotion) {
        var ctx = canvas.getContext('2d');
        var particles = [];
        var heroFrame = 0;
        var heroVisible = true;
        function resize() { canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight; }
        resize();
        window.addEventListener('resize', resize, { passive: true });
        function Particle() { this.reset(); }
        Particle.prototype.reset = function () {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.size = Math.random() * 1.5 + 0.25;
            this.opacity = Math.random() * 0.48 + 0.06;
            this.vx = (Math.random() - 0.5) * 0.25;
            this.vy = (Math.random() - 0.5) * 0.25;
            this.gold = Math.random() > 0.52;
        };
        Particle.prototype.update = function () {
            this.x += this.vx; this.y += this.vy;
            if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) this.reset();
        };
        Particle.prototype.draw = function () {
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fillStyle = this.gold
                ? 'rgba(200,148,50,' + this.opacity + ')'
                : 'rgba(52,211,153,' + (this.opacity * 0.5) + ')';
            ctx.fill();
        };
        for (var i = 0; i < 80; i++) particles.push(new Particle());
        function frame() {
            if (!heroVisible) {
                heroFrame = 0;
                return;
            }
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(function (p) { p.update(); p.draw(); });
            heroFrame = requestAnimationFrame(frame);
        }
        frame();

        if ('IntersectionObserver' in window) {
            var heroVisibilityObserver = new IntersectionObserver(function (entries) {
                heroVisible = entries.some(function (entry) { return entry.isIntersecting; });
                if (heroVisible && !heroFrame) frame();
            }, { threshold: 0.01 });
            heroVisibilityObserver.observe(canvas);
        }
    }

    /* ===================================================
       NARRATIVE LINE REVEALS (Hero headline)
       =================================================== */
    var narrativeLines = document.querySelectorAll('.narrative-line');
    if (!reduceMotion && 'IntersectionObserver' in window) {
        var nlObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    var lines = e.target.querySelectorAll ? e.target.querySelectorAll('.narrative-line') : [];
                    lines.forEach(function (line, i) {
                        setTimeout(function () { line.classList.add('revealed'); }, i * 140);
                    });
                    nlObs.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        var heroContentEl = document.querySelector('.hero-content-anim');
        if (heroContentEl) {
            // Trigger immediately on load since hero is always visible
            setTimeout(function () {
                narrativeLines.forEach(function (line, i) {
                    setTimeout(function () { line.classList.add('revealed'); }, i * 150 + 200);
                });
            }, 300);
        }
    } else {
        narrativeLines.forEach(function (line) { line.classList.add('revealed'); });
    }

    /* ===================================================
       SCROLL REVEAL
       =================================================== */
    var revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
        var revealObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
            });
        }, { threshold: 0.08, rootMargin: '0px 0px -28px 0px' });
        revealEls.forEach(function (el) { revealObs.observe(el); });
    } else {
        revealEls.forEach(function (el) { el.classList.add('visible'); });
    }

    /* ===================================================
       STORY PROGRESS DOTS
       =================================================== */
    var dots = document.querySelectorAll('.story-dot');
    var chapterIds = ['ch0','ch1','ch2','ch3','ch4','ch5','ch6','ch7','ch8','ch9','ch10','ch-final'];
    var chapters = chapterIds.map(function (id) { return document.getElementById(id); });

    dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
            if (chapters[i]) chapters[i].scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    if ('IntersectionObserver' in window) {
        var chObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) {
                    var idx = chapterIds.indexOf(e.target.id);
                    if (idx !== -1) {
                        dots.forEach(function (d) { d.classList.remove('active'); });
                        if (dots[idx]) dots[idx].classList.add('active');
                    }
                }
            });
        }, { threshold: 0.32 });
        chapters.forEach(function (c) { if (c) chObs.observe(c); });
    }

    /* ===================================================
       CHAPTER 1 — CHAOS → CONVERGENCE
       =================================================== */
    var cc = document.getElementById('chaosContainer');
    var ccMsg = document.getElementById('chaosCenterMsg');
    if (cc) {
        var frags = [
            { t: '📱 Notifications', c: 'cf-bg' },  { t: '❓ What is halal?', c: 'cf-gold' },
            { t: '📅 2:30 Meeting',  c: 'cf-bg' },  { t: '🔔 15 new alerts',  c: 'cf-bg' },
            { t: '🌐 Trending now',  c: 'cf-bg' },  { t: '💭 Is this permissible?', c: 'cf-gold' },
            { t: '🛒 What to buy?', c: 'cf-bg' },   { t: '📊 Social media',   c: 'cf-bg' },
            { t: '🎯 Tasks overdue', c: 'cf-bg' },  { t: '💰 Financial decisions', c: 'cf-gold' },
            { t: '🕌 Prayer time?', c: 'cf-grn' },  { t: '📖 Quran today?',  c: 'cf-grn' },
            { t: '🌙 Sunnah fasting?', c: 'cf-grn' }
        ];
        var pos = [
            [10,8],[32,5],[62,6],[80,10],[90,22],
            [5,38],[84,40],[14,57],[77,57],[22,74],
            [55,78],[40,83],[72,80]
        ];
        frags.forEach(function (f, i) {
            var el = document.createElement('div');
            el.className = 'chaos-fragment ' + f.c;
            el.textContent = f.t;
            var p = pos[i] || [Math.random()*80+5, Math.random()*80+5];
            el.style.left = p[0] + '%'; el.style.top = p[1] + '%';
            el.style.transform = 'translate(-50%,-50%)';
            cc.appendChild(el);
        });

        var chaosPhase = 0;
        if ('IntersectionObserver' in window) {
            var chaosObs = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting && chaosPhase === 0) {
                        chaosPhase = 1;
                        setTimeout(function () {
                            cc.querySelectorAll('.chaos-fragment').forEach(function (el) { el.classList.add('scattered'); });
                        }, 200);
                        setTimeout(function () {
                            cc.querySelectorAll('.chaos-fragment').forEach(function (el) {
                                el.style.left = '50%'; el.style.top = '50%'; el.classList.add('converged');
                            });
                            if (ccMsg) ccMsg.style.opacity = '1';
                        }, 3000);
                    }
                });
            }, { threshold: 0.38 });
            chaosObs.observe(cc);
        }
    }

    /* ===================================================
       CHAPTER 7 — GIVING PARTICLES
       =================================================== */
    var gpContainer = document.getElementById('givingParticles');
    if (gpContainer && !reduceMotion) {
        var gpColors = ['rgba(200,148,50,', 'rgba(52,211,153,', 'rgba(255,255,255,'];
        for (var gpi = 0; gpi < 18; gpi++) {
            var gp = document.createElement('div');
            gp.className = 'giving-particle';
            var gpSize = Math.random() * 5 + 2;
            var gpColor = gpColors[Math.floor(Math.random() * gpColors.length)];
            gp.style.cssText = [
                'width:' + gpSize + 'px',
                'height:' + gpSize + 'px',
                'left:' + (Math.random() * 90 + 5) + '%',
                'background:' + gpColor + (Math.random() * 0.35 + 0.1) + ')',
                'border-radius:50%',
                '--dur:' + (Math.random() * 5 + 5) + 's',
                '--delay:' + (Math.random() * 6) + 's'
            ].join(';');
            gpContainer.appendChild(gp);
        }
    }

    /* ===================================================
       NAVBAR GLASS ON DARK SECTIONS
       =================================================== */
    var header = document.querySelector('header');
    var darkSecs = document.querySelectorAll(
        '.hero-cinematic,.ch-why,.ch-daily,.ch-prayer,.ch-calendar,.ch-ai,.ch-product,.ch-zakat,.ch-community,.ch-growth,.ch-ecosystem,.ch-final'
    );
    var navDark = 0;
    if (header && 'IntersectionObserver' in window) {
        var navObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { navDark += e.isIntersecting ? 1 : -1; });
            if (navDark > 0) {
                header.style.setProperty('background', 'rgba(2,14,11,0.92)', 'important');
                header.style.setProperty('border-bottom-color', 'rgba(255,255,255,0.06)', 'important');
                // Make nav links white in dark mode
                header.querySelectorAll('nav a').forEach(function (a) {
                    a.style.color = 'rgba(255,255,255,0.75)';
                });
                var brand = header.querySelector('a > div > div > span:first-child');
                if (brand) brand.style.color = '#fff';
            } else {
                header.style.removeProperty('background');
                header.style.removeProperty('border-bottom-color');
                header.querySelectorAll('nav a').forEach(function (a) {
                    a.style.color = '';
                });
                var brand2 = header.querySelector('a > div > div > span:first-child');
                if (brand2) brand2.style.color = '';
            }
        }, { threshold: 0.04 });
        darkSecs.forEach(function (s) { if (s) navObs.observe(s); });
    }

    /* ===================================================
       PARALLAX MOUSE DEPTH ON HERO (subtle)
       =================================================== */
    if (!reduceMotion) {
        var heroSection = document.getElementById('ch0');
        if (heroSection) {
            var heroArch = heroSection.querySelector('.hero-arch');
            var heroRing1 = heroSection.querySelector('.hero-ring.r1');
            var heroGlow = heroSection.querySelector('.hero-glow');
            var depthLayers = [
                { element: heroSection.querySelector('.hero-content-anim'), x: 4, y: 3 },
                { element: heroSection.querySelector('.hero-card-anim'), x: 10, y: 7 },
                { element: heroSection.querySelector('.hero-mosque'), x: 18, y: 11 },
                { element: heroSection.querySelector('.hero-moon-scene'), x: -12, y: -8 },
                { element: heroSection.querySelector('.hero-sky-cloud.cloud-left'), x: 7, y: 4 },
                { element: heroSection.querySelector('.hero-sky-cloud.cloud-right'), x: -9, y: 5 },
                { element: heroSection.querySelector('.hero-arch-inner'), x: 14, y: 9 }
            ];
            var targetX = 0;
            var targetY = 0;
            var currentX = 0;
            var currentY = 0;
            var depthFrame = 0;

            function animateHeroDepth() {
                currentX += (targetX - currentX) * .08;
                currentY += (targetY - currentY) * .08;
                depthLayers.forEach(function (layer) {
                    if (!layer.element) return;
                    layer.element.style.setProperty('--mouse-x', (currentX * layer.x).toFixed(2) + 'px');
                    layer.element.style.setProperty('--mouse-y', (currentY * layer.y).toFixed(2) + 'px');
                });
                var mosque = heroSection.querySelector('.hero-mosque');
                if (mosque) {
                    mosque.style.setProperty('--tilt-x', (currentX * 5).toFixed(2) + 'deg');
                    mosque.style.setProperty('--tilt-y', (currentY * -3).toFixed(2) + 'deg');
                }
                if (heroArch) heroArch.style.setProperty('--mouse-x', (currentX * 11).toFixed(2) + 'px');
                if (heroArch) heroArch.style.setProperty('--mouse-y', (currentY * 8).toFixed(2) + 'px');
                if (heroRing1) heroRing1.style.setProperty('--mouse-x', (currentX * 6).toFixed(2) + 'px');
                if (heroRing1) heroRing1.style.setProperty('--mouse-y', (currentY * 4).toFixed(2) + 'px');
                if (heroGlow) {
                    heroGlow.style.setProperty('--mouse-x', (currentX * 16).toFixed(2) + 'px');
                    heroGlow.style.setProperty('--mouse-y', (currentY * 10).toFixed(2) + 'px');
                }
                depthFrame = window.requestAnimationFrame(animateHeroDepth);
            }

            document.addEventListener('mousemove', function (ev) {
                if (!heroSection.getBoundingClientRect || !heroSection.contains) return;
                var rect = heroSection.getBoundingClientRect();
                if (rect.bottom < 0 || rect.top > window.innerHeight) return;
                targetX = (ev.clientX / window.innerWidth - 0.5) * 2;
                targetY = (ev.clientY / window.innerHeight - 0.5) * 2;
            }, { passive: true });
            window.addEventListener('mouseleave', function () {
                targetX = 0;
                targetY = 0;
            }, { passive: true });
            animateHeroDepth();
        }
    }

})();
</script>
<script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.module.js';

    const canvas3d = document.getElementById('hero3dMosque');
    const hero3d = document.getElementById('ch0');
    if (canvas3d && hero3d) {
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(28, 1, .1, 100);
        camera.position.set(0, 4.2, 12);
        camera.lookAt(0, 2.5, 0);

        const renderer = new THREE.WebGLRenderer({ canvas: canvas3d, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        const mosque = new THREE.Group();
        mosque.position.set(.4, -2.15, 0);
        scene.add(mosque);

        const wall = new THREE.MeshStandardMaterial({ color: 0x174c3b, roughness: .72, metalness: .05 });
        const wallSide = new THREE.MeshStandardMaterial({ color: 0x09271f, roughness: .82, metalness: .03 });
        const roof = new THREE.MeshStandardMaterial({ color: 0x0d392d, roughness: .62, metalness: .12 });
        const gold = new THREE.MeshStandardMaterial({ color: 0xd4af37, roughness: .28, metalness: .72, emissive: 0x4a3005, emissiveIntensity: .28 });
        const glass = new THREE.MeshStandardMaterial({ color: 0x8ff0c2, emissive: 0x20b978, emissiveIntensity: 1.25, roughness: .24 });

        function addBox(size, position, material, parent = mosque) {
            const mesh = new THREE.Mesh(new THREE.BoxGeometry(size[0], size[1], size[2]), material);
            mesh.position.set(position[0], position[1], position[2]);
            parent.add(mesh);
            return mesh;
        }
        function addCylinder(radius, height, position, material, radial = 24, parent = mosque) {
            const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius * 1.08, height, radial), material);
            mesh.position.set(position[0], position[1], position[2]);
            parent.add(mesh);
            return mesh;
        }

        addBox([7.6, .3, 5.3], [0, .05, 0], wallSide);
        addBox([5.5, 3.15, 3.55], [0, 1.7, 0], wall);
        addBox([5.9, .18, 3.78], [0, 3.28, 0], roof);
        addBox([5.96, .09, 3.84], [0, 3.39, 0], gold);

        const dome = new THREE.Mesh(new THREE.SphereGeometry(1.72, 48, 28, 0, Math.PI * 2, 0, Math.PI / 2), roof);
        dome.scale.set(1.18, 1.08, 1.18);
        dome.position.set(0, 3.42, 0);
        mosque.add(dome);
        addCylinder(1.28, .12, [0, 3.42, 0], gold, 40);
        addCylinder(.09, 1.05, [0, 5.3, 0], gold, 16);
        const finial = new THREE.Mesh(new THREE.SphereGeometry(.18, 18, 12), gold);
        finial.position.set(0, 5.9, 0);
        mosque.add(finial);

        [[-3.15, 2.75], [3.15, 2.75]].forEach(function (pos) {
            addCylinder(.3, 5.55, [pos[0], 2.78, -.1], wallSide, 28);
            addCylinder(.46, .14, [pos[0], 4.9, -.1], gold, 28);
            addCylinder(.4, .12, [pos[0], 5.03, -.1], roof, 28);
            const cap = new THREE.Mesh(new THREE.ConeGeometry(.43, .82, 28), roof);
            cap.position.set(pos[0], 5.48, -.1);
            mosque.add(cap);
            addCylinder(.06, .62, [pos[0], 6.2, -.1], gold, 12);
            const finialSide = new THREE.Mesh(new THREE.SphereGeometry(.11, 14, 10), gold);
            finialSide.position.set(pos[0], 6.55, -.1);
            mosque.add(finialSide);
        });

        [-1.65, -.55, .55, 1.65].forEach(function (x) {
            addBox([.48, 1.25, .12], [x, 2.25, -1.84], glass);
            addBox([.48, 1.25, .12], [x, 2.25, 1.84], glass);
        });
        addBox([1.5, 1.62, .18], [0, 1.18, -1.86], wallSide);
        const door = new THREE.Mesh(new THREE.CylinderGeometry(.72, .72, .2, 32, 1, false, 0, Math.PI), glass);
        door.rotation.x = Math.PI / 2;
        door.position.set(0, 1.78, -1.98);
        mosque.add(door);

        const courtyard = new THREE.Mesh(new THREE.CylinderGeometry(4.15, 4.35, .24, 48), wallSide);
        courtyard.scale.z = .62;
        courtyard.position.set(0, -.2, 0);
        mosque.add(courtyard);

        scene.add(new THREE.HemisphereLight(0x9fe8c5, 0x031510, 1.7));
        const key = new THREE.DirectionalLight(0xffe7a2, 3.4);
        key.position.set(-5, 8, 6);
        scene.add(key);
        const fill = new THREE.PointLight(0x35e49a, 12, 12);
        fill.position.set(0, 3, 2);
        scene.add(fill);

        let targetRotateX = 0, targetRotateY = -.08;
        let rotateX = 0, rotateY = -.08;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) {
            hero3d.addEventListener('pointermove', function (event) {
                const rect = hero3d.getBoundingClientRect();
                targetRotateY = ((event.clientX - rect.left) / rect.width - .5) * .3;
                targetRotateX = ((event.clientY - rect.top) / rect.height - .5) * -.12;
            }, { passive: true });
            hero3d.addEventListener('pointerleave', function () {
                targetRotateX = 0;
                targetRotateY = -.08;
            }, { passive: true });
        }
        function resize3d() {
            const width = canvas3d.clientWidth || 640;
            const height = canvas3d.clientHeight || 480;
            renderer.setSize(width, height, false);
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
        }
        function render3d(time) {
            rotateX += (targetRotateX - rotateX) * .06;
            rotateY += (targetRotateY - rotateY) * .06;
            mosque.rotation.x = rotateX;
            mosque.rotation.y = rotateY + (reduced ? 0 : Math.sin(time * .00035) * .025);
            mosque.position.y = -2.15 + Math.sin(time * .0005) * .035;
            renderer.render(scene, camera);
            window.requestAnimationFrame(render3d);
        }
        resize3d();
        window.addEventListener('resize', resize3d, { passive: true });
        render3d(0);
    }
</script>
}
