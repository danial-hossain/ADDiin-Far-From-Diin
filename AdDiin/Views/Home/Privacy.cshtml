@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container my-5">
    <div class="card card-custom p-5 border rounded-4 bg-white shadow-sm">
        <h2 class="fw-bold mb-4 text-dark">Privacy & Data Protection Policy</h2>
        <p class="text-muted leading-relaxed">
            At Ad-Diin, we take user privacy, authentication security, and donation confidentiality with the utmost seriousness.
        </p>
        <h5 class="fw-bold mt-4">1. Data Collected</h5>
        <p class="text-muted small">We collect personal details (Name, Email, Phone Number, Address) strictly for user accounts, Milad booking coordination, and payment transaction logging.</p>
        
        <h5 class="fw-bold mt-4">2. Anonymous Donations</h5>
        <p class="text-muted small">Donors can opt to donate anonymously. In such cases, public receipts and reports do not reveal donor identity.</p>

        <h5 class="fw-bold mt-4">3. Security Measures</h5>
        <p class="text-muted small">User passwords are encrypted using ASP.NET Core Identity PBKDF2 with HMAC-SHA256. CSRF tokens protect all state-changing endpoints.</p>
    </div>
</div>