@{
    ViewData["Title"] = "About Us | ADDiin Platform";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="px-3.5 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full uppercase tracking-wider">
            Platform Vision & Mission
        </span>
        <h1 class="text-4xl font-black text-slate-900 tracking-tight">About ADDiin</h1>
        <p class="text-base text-slate-600 leading-relaxed font-normal">
            ADDiin — Personal Islamic Development & Community Engagement Platform
        </p>
    </div>

    <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-slate-200 space-y-6 text-sm text-slate-700 leading-relaxed">
        <h3 class="text-xl font-bold text-slate-900">Our Mission</h3>
        <p>
            An integrated digital platform that helps users stay consistent in their Islamic activities, track their personal progress, discover Islamic programs, and engage with their faith through modern technology.
        </p>

        <h3 class="text-xl font-bold text-slate-900 pt-4">User-Centric Architecture</h3>
        <p>
            ADDiin puts the believer at the center of their spiritual growth. Through intelligent habit trackers (My Deen), personalized Azan and prayer reminders, verified Islamic knowledge via Diin AI, and nationwide Islamic activity discovery, ADDiin equips Muslims worldwide to practice their faith with excellence (Ihsan) and consistency (Istiqamah).
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
            <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-center">
                <span class="text-2xl">📿</span>
                <h4 class="font-bold text-slate-900 text-sm mt-2">Personal Growth</h4>
                <p class="text-xs text-slate-600 mt-1">Dhikr counters, Quran bookmarks, Adhkar & Ruqyah checklists</p>
            </div>
            <div class="p-5 rounded-2xl bg-blue-50 border border-blue-200 text-center">
                <span class="text-2xl">🎟️</span>
                <h4 class="font-bold text-slate-900 text-sm mt-2">Community Programs</h4>
                <p class="text-xs text-slate-600 mt-1">Waz Mahfils, Quran competitions, and youth seminars</p>
            </div>
            <div class="p-5 rounded-2xl bg-amber-50 border border-amber-200 text-center">
                <span class="text-2xl">💡</span>
                <h4 class="font-bold text-slate-900 text-sm mt-2">Diin AI Guidance</h4>
                <p class="text-xs text-slate-600 mt-1">Authentic Islamic questions answered with Quran & Hadith</p>
            </div>
        </div>
    </div>
</div>
