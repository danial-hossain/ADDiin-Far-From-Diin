@model AdDiin.Models.ViewModels.AdminDonationsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Donations & Zakat Records";
}

<!-- Summary Statistics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <div class="text-muted small text-uppercase fw-semibold">Total Completed Collections</div>
            <div class="display-6 fw-extrabold text-emerald my-1">৳ @Model.TotalCompletedAmount.ToString("N2")</div>
            <small class="text-muted">Total valid received contributions</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <div class="text-muted small text-uppercase fw-semibold">Total Transactions</div>
            <div class="display-6 fw-extrabold text-dark my-1">@Model.TotalCount</div>
            <small class="text-muted">All donation intents & payments</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <div class="text-muted small text-uppercase fw-semibold">Pending / Incomplete</div>
            <div class="display-6 fw-extrabold text-warning my-1">@Model.PendingCount</div>
            <small class="text-muted">Unfinished checkout sessions</small>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card card-custom p-4 border-0 bg-white shadow-sm mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search by name, email, phone, or Tran ID..." />
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                <option value="general">General Fund</option>
                <option value="zakat">Zakat</option>
                <option value="iftar">Iftar</option>
                <option value="durjog">Disaster Relief</option>
                <option value="sitarto">Winter Clothes</option>
                <option value="gachropon">Tree Plantation</option>
                <option value="orphan">Orphan Care</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="completed">Completed</option>
                <option value="pending">Pending</option>
                <option value="failed">Failed</option>
                <option value="cancelled">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-emerald flex-grow-1">Filter</button>
            <a asp-action="Donations" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Transactions Table -->
<div class="card card-custom p-4 border-0 bg-white shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Transaction ID</th>
                    <th>Donor Details</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Gateway / Method</th>
                    <th>Status</th>
                    <th>Date & Time</th>
                    <th class="text-end">Receipt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Donations)
                {
                    <tr>
                        <td class="font-monospace fw-bold">@d.TranId</td>
                        <td>
                            <div class="fw-semibold">@(d.IsAnonymous ? "Anonymous" : (d.Name ?? "Direct Donor"))</div>
                            <small class="text-muted">@(d.Email ?? d.Phone ?? "N/A")</small>
                        </td>
                        <td class="text-uppercase"><span class="badge bg-light text-dark border">@d.Category</span></td>
                        <td class="fw-bold text-emerald fs-6">৳ @d.Amount.ToString("N2")</td>
                        <td class="text-uppercase text-muted">@(d.PaymentMethod ?? "SSLCommerz")</td>
                        <td>
                            @if (d.PaymentStatus == "completed")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Completed</span>
                            }
                            else if (d.PaymentStatus == "pending")
                            {
                                <span class="badge bg-warning bg-opacity-15 text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">@d.PaymentStatus</span>
                            }
                        </td>
                        <td class="text-muted">@d.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td class="text-end">
                            <a asp-controller="Donate" asp-action="Receipt" asp-route-tranId="@d.TranId" target="_blank" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill">
                                Receipt
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>