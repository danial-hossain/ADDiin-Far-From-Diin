@model AdDiin.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard | ADDiin Platform";
    Layout = "_AdminLayout";
}

<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-black text-slate-900">ADDiin Community Administration</h1>
        <p class="text-xs text-slate-500">Platform metrics, user activity, program registrations, and verified charity oversight</p>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Active Users</span>
                <i class="bi bi-people-fill text-purple-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">@Model.ActiveUsers</p>
            <p class="text-xs text-slate-500">Total Registered: @Model.TotalUsers</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Program Registrations</span>
                <i class="bi bi-card-checklist text-amber-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">@Model.PendingRegistrationsCount <span class="text-sm font-bold text-amber-600">Pending</span></p>
            <p class="text-xs text-slate-500">Total Applications: @Model.TotalRegistrationsCount</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Verified Donations</span>
                <i class="bi bi-cash-stack text-emerald-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">৳@Model.TotalDonationsCompleted.ToString("N0")</p>
            <p class="text-xs text-slate-500">Transactions: @Model.TotalDonationsCount</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Active Programs</span>
                <i class="bi bi-calendar-event-fill text-blue-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">@Model.ActivePrograms.Count</p>
            <p class="text-xs text-slate-500">Waz, Seminars, Gatherings</p>
        </div>
    </div>

    <!-- Recent Registrations & Recent Donations -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-6 bg-white p-6 rounded-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-extrabold text-slate-900 text-sm">Recent Program Registrations</h3>
                <a href="/admin/registrations" class="text-xs font-bold text-purple-700">View All &rarr;</a>
            </div>
            <div class="space-y-3">
                @if (Model.RecentRegistrations.Any())
                {
                    @foreach (var reg in Model.RecentRegistrations)
                    {
                        <div class="p-3 bg-slate-50 rounded-xl flex items-center justify-between text-xs">
                            <div>
                                <p class="font-bold text-slate-900">@reg.FullName</p>
                                <p class="text-slate-500 text-[11px]">@reg.Activity.Title</p>
                            </div>
                            <span class="px-2 py-0.5 rounded-full font-bold text-[10px] @(reg.Status == "Approved" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                @reg.Status
                            </span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 py-4 text-center">No recent registrations.</p>
                }
            </div>
        </div>

        <div class="lg:col-span-6 bg-white p-6 rounded-2xl border border-slate-200 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-extrabold text-slate-900 text-sm">Recent Verified Donations</h3>
                <a href="/Admin/Donations" class="text-xs font-bold text-purple-700">View All &rarr;</a>
            </div>
            <div class="space-y-3">
                @if (Model.RecentDonations.Any())
                {
                    @foreach (var don in Model.RecentDonations)
                    {
                        <div class="p-3 bg-slate-50 rounded-xl flex items-center justify-between text-xs">
                            <div>
                                <p class="font-bold text-slate-900">@(don.IsAnonymous ? "Anonymous" : don.Name)</p>
                                <p class="text-slate-500 text-[11px] uppercase">@don.Category Fund • @don.PaymentMethod</p>
                            </div>
                            <span class="font-black text-slate-900">
                                ৳@don.Amount.ToString("N0")
                            </span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 py-4 text-center">No recent donations.</p>
                }
            </div>
        </div>
    </div>
</div>
