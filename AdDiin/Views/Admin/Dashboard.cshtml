@model AdDiin.Models.ViewModels.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Executive Admin Dashboard";
}

<!-- Stat Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Donations</div>
                    <div class="fs-4 fw-extrabold text-emerald my-1">৳ @Model.TotalDonationsCompleted.ToString("N0")</div>
                    <small class="text-muted">@Model.TotalDonationsCount total records</small>
                </div>
                <div class="p-3 bg-emerald-light text-emerald rounded-3 fs-4">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Registered Users</div>
                    <div class="fs-4 fw-extrabold text-dark my-1">@Model.TotalUsers</div>
                    <small class="text-success fw-semibold">@Model.ActiveUsers active accounts</small>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-4">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Milad Bookings</div>
                    <div class="fs-4 fw-extrabold text-warning my-1">@Model.PendingMiladCount</div>
                    <small class="text-muted">@Model.TotalMiladCount total requests</small>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 fs-4">
                    <i class="bi bi-bookmark-star"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card card-custom p-3 border-0 bg-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Pending Inquiries</div>
                    <div class="fs-4 fw-extrabold text-danger my-1">@Model.UnreadContactCount</div>
                    <small class="text-muted">@Model.ActiveConversationsCount active support chats</small>
                </div>
                <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3 fs-4">
                    <i class="bi bi-chat-left-dots"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Category Breakdown Table -->
    <div class="col-lg-5">
        <div class="card card-custom p-4 border-0 bg-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-dark">Donations by Fund Category</h6>
                <a asp-action="Donations" class="small text-emerald text-decoration-none">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle small mb-0">
                    <tbody>
                        @foreach (var cat in Model.DonationsByCategory)
                        {
                            <tr>
                                <td class="text-uppercase fw-semibold py-2">@cat.Key</td>
                                <td class="text-end fw-bold text-emerald py-2">৳ @cat.Value.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Milad Bookings -->
    <div class="col-lg-7">
        <div class="card card-custom p-4 border-0 bg-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-dark">Pending & Recent Milad Requests</h6>
                <a asp-action="Milads" class="small text-emerald text-decoration-none">Manage All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead>
                        <tr class="text-muted">
                            <th>Occasion Title</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.RecentMiladRequests)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@m.Name</div>
                                    <small class="text-muted">@m.Phone</small>
                                </td>
                                <td>@m.MiladDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge @(m.Status == "approved" ? "bg-success" : (m.Status == "pending" ? "bg-warning text-dark" : "bg-secondary"))">
                                        @m.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Milads" class="btn btn-outline-secondary btn-sm py-0 px-2">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Recent Donations Log -->
<div class="card card-custom p-4 border-0 bg-white shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0 text-dark">Latest Donation Transactions</h6>
        <a asp-action="Donations" class="small text-emerald text-decoration-none">View Complete Audit Log</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tran ID</th>
                    <th>Donor Name</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.RecentDonations)
                {
                    <tr>
                        <td class="font-monospace fw-bold">@d.TranId</td>
                        <td>@(d.IsAnonymous ? "Anonymous Donor" : (d.Name ?? "Direct Donor"))</td>
                        <td class="text-uppercase"><span class="badge bg-light text-dark border">@d.Category</span></td>
                        <td class="fw-bold text-emerald">৳ @d.Amount.ToString("N2")</td>
                        <td class="text-uppercase text-muted">@(d.PaymentMethod ?? "Online")</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success">@d.PaymentStatus</span></td>
                        <td class="text-muted">@d.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>