@model List<AdDiin.Models.Entities.PrayerTime>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Prayer Times Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0">Prayer Times Schedule</h5>
    <button class="btn btn-emerald btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createPrayerModal">
        <i class="bi bi-plus-lg me-1"></i> Add Prayer Time
    </button>
</div>

<div class="card card-custom p-4 border-0 bg-white shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Order</th>
                    <th>Code</th>
                    <th>Display Name (EN)</th>
                    <th>Display Name (BN)</th>
                    <th>Time</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var time12 = DateTime.Today.Add(p.PrayerTimeValue).ToString("hh:mm tt");
                    <tr>
                        <td><span class="badge bg-light text-dark border">@p.DisplayOrder</span></td>
                        <td class="font-monospace">@p.PrayerName</td>
                        <td class="fw-bold">@p.DisplayNameEn</td>
                        <td>@p.DisplayNameBn</td>
                        <td class="fw-bold text-emerald fs-6 font-monospace">@time12</td>
                        <td><span class="badge bg-light text-dark border text-uppercase">@p.Category</span></td>
                        <td><span class="badge bg-emerald-light text-emerald text-uppercase">@p.PrayerType</span></td>
                        <td>
                            <form asp-action="PrayerTimeToggle" asp-route-id="@p.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-success" : "btn-secondary") py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                                    @(p.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <form asp-action="PrayerTimeDelete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this prayer entry?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="createPrayerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0">
            <form asp-action="PrayerTimeCreate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Prayer Time</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body space-y-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Identifier Code (Unique)</label>
                        <input name="PrayerName" class="form-control" placeholder="e.g. jummah_jamaat" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">English Name</label>
                            <input name="DisplayNameEn" class="form-control" placeholder="Jummah Jamaat" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Bengali Name</label>
                            <input name="DisplayNameBn" class="form-control" placeholder="জুম্মা জামাত" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Time (HH:MM:SS)</label>
                            <input name="PrayerTimeValue" type="time" step="1" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Display Order</label>
                            <input name="DisplayOrder" type="number" class="form-control" value="15" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Category</label>
                            <select name="Category" class="form-select">
                                <option value="fard">Fard</option>
                                <option value="nafl">Nafl</option>
                                <option value="sunnah">Sunnah</option>
                                <option value="wajib">Wajib</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Prayer Type</label>
                            <select name="PrayerType" class="form-select">
                                <option value="azan" selected>Azan</option>
                                <option value="optional">Optional / Nafl</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-emerald">Save Prayer Time</button>
                </div>
            </form>
        </div>
    </div>
</div>