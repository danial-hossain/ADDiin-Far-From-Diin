@model List<AdDiin.Models.Entities.PrayerTime>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Prayer Times & Wakt Schedule | Admin Panel";
    var currentSearch = ViewBag.Search as string ?? "";
    var currentCategory = ViewBag.Category as string ?? "";
    var currentType = ViewBag.Type as string ?? "";
    var totalPrayers = Model.Count;
    var activePrayers = Model.Count(p => p.IsActive);
    var fardCount = Model.Count(p => (p.Category ?? "").ToLower() == "fard");
    var naflCount = Model.Count(p => (p.Category ?? "").ToLower() == "nafl" || (p.Category ?? "").ToLower() == "sunnah");
}

<div class="space-y-6 pb-12">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-200 shadow-xs">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white text-2xl shadow-lg shadow-emerald-500/20">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Prayer Times & Wakt Schedule</h1>
                <p class="text-xs text-slate-500 mt-0.5">Configure Azan, Jamaat, and Nafl prayer time values, display names, and wakts</p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <a href="/PrayerTimes" target="_blank" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-bold transition">
                <i class="bi bi-box-arrow-up-right"></i> View Public Schedule
            </a>
            <button type="button" onclick="openCreateModal()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white text-xs font-extrabold rounded-xl shadow-md shadow-emerald-600/25 transition cursor-pointer">
                <i class="bi bi-plus-circle-fill text-sm"></i> Add Prayer Time
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Entries</p>
                <h3 class="text-2xl font-black text-slate-900 mt-1">@totalPrayers</h3>
                <span class="text-[11px] text-slate-400">All configured timings</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl font-bold">
                <i class="bi bi-alarm-fill"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-600">Active Schedules</p>
                <h3 class="text-2xl font-black text-slate-900 mt-1">@activePrayers</h3>
                <span class="text-[11px] text-slate-400">Live on prayer table</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
                <i class="bi bi-check2-circle"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-blue-600">Fard & Azan Prayers</p>
                <h3 class="text-2xl font-black text-slate-900 mt-1">@fardCount</h3>
                <span class="text-[11px] text-slate-400">Daily obligatory wakts</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl font-bold">
                <i class="bi bi-sun-fill"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-amber-600">Nafl & Sunnah Wakts</p>
                <h3 class="text-2xl font-black text-slate-900 mt-1">@naflCount</h3>
                <span class="text-[11px] text-slate-400">Tahajjud, Ishraq, Chasht</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                <i class="bi bi-moon-stars-fill"></i>
            </div>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
        <form method="get" class="flex items-center gap-2 max-w-md w-full">
            <input type="hidden" name="category" value="@currentCategory" />
            <input type="hidden" name="type" value="@currentType" />
            <div class="relative flex-1">
                <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="search" value="@currentSearch" placeholder="Search code, English or Bangla name..." class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition" />
            </div>
            @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentCategory) || !string.IsNullOrEmpty(currentType))
            {
                <a href="/Admin/PrayerTimes" class="px-2.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-semibold" title="Reset filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
            <button type="submit" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition cursor-pointer">Filter</button>
        </form>

        <!-- Category / Type Filter Pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto py-1 text-xs">
            <a href="/Admin/PrayerTimes?search=@currentSearch" class="px-3 py-1.5 rounded-xl font-bold whitespace-nowrap transition @(string.IsNullOrEmpty(currentCategory) && string.IsNullOrEmpty(currentType) ? "bg-emerald-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                All
            </a>
            <a href="/Admin/PrayerTimes?category=fard&search=@currentSearch" class="px-3 py-1.5 rounded-xl font-bold whitespace-nowrap transition @(currentCategory.ToLower() == "fard" ? "bg-emerald-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Fard
            </a>
            <a href="/Admin/PrayerTimes?category=nafl&search=@currentSearch" class="px-3 py-1.5 rounded-xl font-bold whitespace-nowrap transition @(currentCategory.ToLower() == "nafl" ? "bg-amber-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Nafl
            </a>
            <a href="/Admin/PrayerTimes?category=sunnah&search=@currentSearch" class="px-3 py-1.5 rounded-xl font-bold whitespace-nowrap transition @(currentCategory.ToLower() == "sunnah" ? "bg-purple-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Sunnah
            </a>
            <a href="/Admin/PrayerTimes?type=azan&search=@currentSearch" class="px-3 py-1.5 rounded-xl font-bold whitespace-nowrap transition @(currentType.ToLower() == "azan" ? "bg-teal-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Azan
            </a>
            <a href="/Admin/PrayerTimes?type=jamaat&search=@currentSearch" class="px-3 py-1.5 rounded-xl font-bold whitespace-nowrap transition @(currentType.ToLower() == "jamaat" ? "bg-indigo-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Jamaat
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        @if (!Model.Any())
        {
            <div class="py-16 text-center">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto text-slate-400 text-2xl mb-3">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h3 class="font-bold text-slate-800 text-sm">No Prayer Times Found</h3>
                <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">There are no prayer entries matching your criteria. Add a new prayer timing or clear your filters.</p>
                <button type="button" onclick="openCreateModal()" class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 text-white text-xs font-bold rounded-xl shadow-sm hover:bg-emerald-700 transition cursor-pointer">
                    <i class="bi bi-plus-lg"></i> Add First Prayer Time
                </button>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider text-[10px]">
                        <tr>
                            <th class="py-3.5 px-4">Order & Code</th>
                            <th class="py-3.5 px-4">Display Name (EN / BN)</th>
                            <th class="py-3.5 px-4">Scheduled Time</th>
                            <th class="py-3.5 px-4">Category</th>
                            <th class="py-3.5 px-4">Type</th>
                            <th class="py-3.5 px-4">Status</th>
                            <th class="py-3.5 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var p in Model)
                        {
                            var time12 = DateTime.Today.Add(p.PrayerTimeValue).ToString("hh:mm tt");
                            var time24 = p.PrayerTimeValue.ToString(@"hh\:mm\:ss");
                            var catClass = (p.Category ?? "").ToLower() switch
                            {
                                "fard" => "bg-emerald-100 text-emerald-800 border-emerald-200",
                                "nafl" => "bg-amber-100 text-amber-800 border-amber-200",
                                "sunnah" => "bg-purple-100 text-purple-800 border-purple-200",
                                "wajib" => "bg-sky-100 text-sky-800 border-sky-200",
                                _ => "bg-slate-100 text-slate-700 border-slate-200"
                            };

                            var typeClass = (p.PrayerType ?? "").ToLower() switch
                            {
                                "azan" => "bg-teal-50 text-teal-700 border-teal-200",
                                "jamaat" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                                _ => "bg-slate-50 text-slate-600 border-slate-200"
                            };

                            <tr class="hover:bg-slate-50/60 transition group">
                                <!-- Order & Code -->
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-slate-100 font-mono font-bold text-slate-600 text-[11px] border border-slate-200">
                                            @p.DisplayOrder
                                        </span>
                                        <span class="font-mono text-[11px] text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md border border-slate-200/60">
                                            @p.PrayerName
                                        </span>
                                    </div>
                                </td>

                                <!-- Display Names -->
                                <td class="py-4 px-4">
                                    <div class="space-y-0.5">
                                        <span class="font-bold text-slate-900 text-sm block">@p.DisplayNameEn</span>
                                        <span class="text-xs text-slate-500 font-medium block">@p.DisplayNameBn</span>
                                    </div>
                                </td>

                                <!-- Scheduled Time -->
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">
                                            <i class="bi bi-clock"></i>
                                        </div>
                                        <div>
                                            <span class="font-black text-emerald-700 text-sm font-mono block">@time12</span>
                                            <span class="text-[10px] text-slate-400 font-mono">@time24</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Category -->
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <span class="inline-block px-2.5 py-1 rounded-lg text-[10px] font-extrabold uppercase tracking-wide border @catClass">
                                        @p.Category
                                    </span>
                                </td>

                                <!-- Type -->
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <span class="inline-block px-2.5 py-1 rounded-lg text-[10px] font-extrabold uppercase tracking-wide border @typeClass">
                                        @p.PrayerType
                                    </span>
                                </td>

                                <!-- Status Toggle -->
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <form asp-action="PrayerTimeToggle" asp-route-id="@p.Id" method="post" class="inline m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Click to toggle active status" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold transition cursor-pointer @(p.IsActive ? "bg-emerald-100 text-emerald-800 hover:bg-emerald-200" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                                            <span class="w-1.5 h-1.5 rounded-full @(p.IsActive ? "bg-emerald-600" : "bg-slate-400")"></span>
                                            @(p.IsActive ? "Active" : "Inactive")
                                        </button>
                                    </form>
                                </td>

                                <!-- Actions -->
                                <td class="py-4 px-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <!-- Edit Modal Trigger -->
                                        <button type="button"
                                                onclick="openEditModal(this)"
                                                data-id="@p.Id"
                                                data-name="@p.PrayerName"
                                                data-displayen="@p.DisplayNameEn"
                                                data-displaybn="@p.DisplayNameBn"
                                                data-time="@p.PrayerTimeValue.ToString(@"hh\:mm\:ss")"
                                                data-category="@p.Category"
                                                data-type="@p.PrayerType"
                                                data-order="@p.DisplayOrder"
                                                data-isactive="@p.IsActive.ToString().ToLower()"
                                                class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition cursor-pointer"
                                                title="Edit Prayer Timing">
                                            <i class="bi bi-pencil-square text-xs"></i>
                                        </button>

                                        <!-- Delete Form -->
                                        <form asp-action="PrayerTimeDelete" asp-route-id="@p.Id" method="post" class="m-0 inline" onsubmit="return confirm('Are you sure you want to delete \'@p.DisplayNameEn\'?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-red-50 text-slate-600 hover:text-red-600 flex items-center justify-center transition cursor-pointer" title="Delete Prayer Timing">
                                                <i class="bi bi-trash3 text-xs"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ================= CREATE PRAYER MODAL ================= -->
<div id="createModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="relative w-full max-w-xl bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden my-8 animate-in fade-in zoom-in duration-200">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                    <i class="bi bi-plus-lg"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900">Add Prayer Time</h3>
                    <p class="text-[11px] text-slate-500">Configure new prayer timing or Azan wakt</p>
                </div>
            </div>
            <button type="button" onclick="closeCreateModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 flex items-center justify-center transition cursor-pointer">
                <i class="bi bi-x-lg text-xs"></i>
            </button>
        </div>

        <!-- Form -->
        <form asp-action="PrayerTimeCreate" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <!-- Identifier Code -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Identifier Code (Unique) <span class="text-red-500">*</span></label>
                <input type="text" name="PrayerName" required placeholder="e.g. jummah_jamaat, tahajjud_start, fajr_azan" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none" />
            </div>

            <!-- English & Bengali Display Names -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">English Display Name <span class="text-red-500">*</span></label>
                    <input type="text" name="DisplayNameEn" required placeholder="e.g. Jummah Jamaat" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Bengali Display Name <span class="text-red-500">*</span></label>
                    <input type="text" name="DisplayNameBn" required placeholder="e.g. জুম্মা জামাত" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none" />
                </div>
            </div>

            <!-- Time & Order -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Time (HH:MM:SS) <span class="text-red-500">*</span></label>
                    <input type="time" step="1" name="PrayerTimeValue" required value="13:15:00" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Display Order <span class="text-red-500">*</span></label>
                    <input type="number" name="DisplayOrder" value="10" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none" />
                </div>
            </div>

            <!-- Category & Type -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Category <span class="text-red-500">*</span></label>
                    <select name="Category" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none bg-white">
                        <option value="fard" selected>Fard</option>
                        <option value="nafl">Nafl</option>
                        <option value="sunnah">Sunnah</option>
                        <option value="wajib">Wajib</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Prayer Type <span class="text-red-500">*</span></label>
                    <select name="PrayerType" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none bg-white">
                        <option value="azan" selected>Azan</option>
                        <option value="jamaat">Jamaat</option>
                        <option value="optional">Optional / Nafl</option>
                    </select>
                </div>
            </div>

            <!-- Active Checkbox -->
            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="createIsActive" name="IsActive" value="true" checked class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500" />
                <label for="createIsActive" class="text-xs font-semibold text-slate-700 cursor-pointer">Active & visible in prayer timetable</label>
            </div>

            <!-- Footer -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
                <button type="button" onclick="closeCreateModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition cursor-pointer">Cancel</button>
                <button type="submit" class="px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-black shadow-md shadow-emerald-600/20 transition inline-flex items-center gap-2 cursor-pointer">
                    <i class="bi bi-check-lg"></i> Save Prayer Time
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ================= EDIT PRAYER MODAL ================= -->
<div id="editModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="relative w-full max-w-xl bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden my-8 animate-in fade-in zoom-in duration-200">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold">
                    <i class="bi bi-pencil-fill"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900">Edit Prayer Time</h3>
                    <p class="text-[11px] text-slate-500">Update prayer timing parameters or names</p>
                </div>
            </div>
            <button type="button" onclick="closeEditModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 flex items-center justify-center transition cursor-pointer">
                <i class="bi bi-x-lg text-xs"></i>
            </button>
        </div>

        <!-- Form -->
        <form id="editForm" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="Id" />

            <!-- Identifier Code -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Identifier Code (Unique) <span class="text-red-500">*</span></label>
                <input type="text" id="editPrayerName" name="PrayerName" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 outline-none" />
            </div>

            <!-- English & Bengali Display Names -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">English Display Name <span class="text-red-500">*</span></label>
                    <input type="text" id="editDisplayNameEn" name="DisplayNameEn" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Bengali Display Name <span class="text-red-500">*</span></label>
                    <input type="text" id="editDisplayNameBn" name="DisplayNameBn" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 outline-none" />
                </div>
            </div>

            <!-- Time & Order -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Time (HH:MM:SS) <span class="text-red-500">*</span></label>
                    <input type="time" step="1" id="editPrayerTimeValue" name="PrayerTimeValue" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Display Order <span class="text-red-500">*</span></label>
                    <input type="number" id="editDisplayOrder" name="DisplayOrder" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 outline-none" />
                </div>
            </div>

            <!-- Category & Type -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Category <span class="text-red-500">*</span></label>
                    <select id="editCategory" name="Category" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 outline-none bg-white">
                        <option value="fard">Fard</option>
                        <option value="nafl">Nafl</option>
                        <option value="sunnah">Sunnah</option>
                        <option value="wajib">Wajib</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Prayer Type <span class="text-red-500">*</span></label>
                    <select id="editPrayerType" name="PrayerType" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 outline-none bg-white">
                        <option value="azan">Azan</option>
                        <option value="jamaat">Jamaat</option>
                        <option value="optional">Optional / Nafl</option>
                    </select>
                </div>
            </div>

            <!-- Active Checkbox -->
            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="editIsActive" name="IsActive" value="true" class="w-4 h-4 text-purple-600 rounded border-slate-300 focus:ring-purple-500" />
                <label for="editIsActive" class="text-xs font-semibold text-slate-700 cursor-pointer">Active & visible in prayer timetable</label>
            </div>

            <!-- Footer -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
                <button type="button" onclick="closeEditModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition cursor-pointer">Cancel</button>
                <button type="submit" class="px-6 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-black shadow-md shadow-purple-600/20 transition inline-flex items-center gap-2 cursor-pointer">
                    <i class="bi bi-check-lg"></i> Update Prayer Time
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateModal() {
            document.getElementById('createModal').classList.remove('hidden');
        }

        function closeCreateModal() {
            document.getElementById('createModal').classList.add('hidden');
        }

        function openEditModal(button) {
            const id = button.getAttribute('data-id');
            const form = document.getElementById('editForm');
            form.action = `/Admin/PrayerTimeEdit/${id}`;

            document.getElementById('editId').value = id;
            document.getElementById('editPrayerName').value = button.getAttribute('data-name') || '';
            document.getElementById('editDisplayNameEn').value = button.getAttribute('data-displayen') || '';
            document.getElementById('editDisplayNameBn').value = button.getAttribute('data-displaybn') || '';
            document.getElementById('editPrayerTimeValue').value = button.getAttribute('data-time') || '00:00:00';
            document.getElementById('editCategory').value = (button.getAttribute('data-category') || 'fard').toLowerCase();
            document.getElementById('editPrayerType').value = (button.getAttribute('data-type') || 'azan').toLowerCase();
            document.getElementById('editDisplayOrder').value = button.getAttribute('data-order') || '0';

            const isActive = button.getAttribute('data-isactive') === 'true';
            document.getElementById('editIsActive').checked = isActive;

            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        // Close modals on clicking backdrop
        window.addEventListener('click', function(e) {
            const createModal = document.getElementById('createModal');
            const editModal = document.getElementById('editModal');
            if (e.target === createModal) closeCreateModal();
            if (e.target === editModal) closeEditModal();
        });

        // Close on ESC
        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeCreateModal();
                closeEditModal();
            }
        });
    </script>
}