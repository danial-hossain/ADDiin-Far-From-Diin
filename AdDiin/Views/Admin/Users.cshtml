@model AdDiin.Models.ViewModels.AdminUsersViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Accounts Management";
}

<div class="card card-custom p-4 border-0 bg-white shadow-sm mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search by name, email, or phone..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="all">All Statuses</option>
                <option value="active">Active Accounts</option>
                <option value="inactive">Inactive / Blocked</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-emerald flex-grow-1">Filter</button>
            <a asp-action="Users" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="card card-custom p-4 border-0 bg-white shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle-sm bg-emerald text-white fw-bold">
                                    @(u.FullName.FirstOrDefault())
                                </div>
                                <div>
                                    <div class="fw-bold">@u.FullName</div>
                                    <small class="text-muted">@u.City</small>
                                </div>
                            </div>
                        </td>
                        <td>@u.Email</td>
                        <td>@(u.PhoneNumber ?? "N/A")</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">Blocked</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <form asp-action="ToggleUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill py-0 px-2">
                                    @(u.IsActive ? "Block" : "Activate")
                                </button>
                            </form>
                            <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this user?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>