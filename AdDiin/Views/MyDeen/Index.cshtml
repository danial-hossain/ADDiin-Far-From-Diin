@model AdDiin.Models.ViewModels.MyDeenHubViewModel
@{
    ViewData["Title"] = "My Deen | Personal Islamic Activity Hub";
}

<!-- My Deen Hub Container -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Top Hub Header & Streak Dashboard -->
    <div class="bg-gradient-to-r from-emerald-900 via-teal-900 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <div class="lg:col-span-8 space-y-3">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 rounded-full text-xs font-bold">
                    <span>🕌 Personal Islamic Hub</span>
                    <span>•</span>
                    <span class="text-amber-300">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">My Deen Dashboard</h1>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
                    Track your daily prayers, Dhikr targets, Quran reading goals, Adhkar, and Ruqyah practices to build lifelong spiritual consistency (Istiqamah).
                </p>
                
                <!-- Quick Metrics Bar -->
                <div class="pt-3 flex flex-wrap gap-4 items-center">
                    <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2.5 rounded-2xl">
                        <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center text-xl font-bold">
                            🔥
                        </div>
                        <div>
                            <p class="text-[11px] text-slate-300 uppercase font-bold tracking-wider">Active Streak</p>
                            <p class="text-lg font-extrabold text-white" id="streakCountDisplay">@Model.CurrentStreak Days</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2.5 rounded-2xl">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-xl font-bold">
                            🎯
                        </div>
                        <div>
                            <p class="text-[11px] text-slate-300 uppercase font-bold tracking-wider">Today's Progress</p>
                            <p class="text-lg font-extrabold text-emerald-300" id="headerProgressDisplay">@Model.DailyProgressPercent%</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2.5 rounded-2xl">
                        <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center text-xl font-bold">
                            📈
                        </div>
                        <div>
                            <p class="text-[11px] text-slate-300 uppercase font-bold tracking-wider">Monthly Consistency</p>
                            <p class="text-lg font-extrabold text-white">@Model.MonthlyProgressPercent%</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Header Progress Ring -->
            <div class="lg:col-span-4 flex flex-col items-center justify-center bg-white/5 border border-white/10 p-6 rounded-3xl backdrop-blur-md">
                <p class="text-xs uppercase font-bold tracking-wider text-slate-300 mb-3">Overall Daily Score</p>
                <div class="relative w-32 h-32 flex items-center justify-center">
                    <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                        <path class="text-slate-700" stroke-width="3.5" stroke="currentColor" fill="none"
                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        <path id="circleProgressPath" class="text-emerald-400 transition-all duration-500" stroke-width="3.5" stroke-dasharray="@Model.DailyProgressPercent, 100" stroke-linecap="round" stroke="currentColor" fill="none"
                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                    </svg>
                    <div class="absolute text-center">
                        <span id="circleProgressText" class="text-2xl font-black text-white">@Model.DailyProgressPercent%</span>
                        <p class="text-[10px] text-slate-400 uppercase font-semibold">Completed</p>
                    </div>
                </div>
                <p class="text-xs text-slate-400 mt-3 text-center">Complete your 10 daily pillars below</p>
            </div>
        </div>
    </div>

    <!-- 7-Day Consistency Matrix Bar -->
    <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="font-bold text-slate-900 text-base">Weekly Consistency Matrix (Last 7 Days)</h3>
                <p class="text-xs text-slate-500">Your daily habits and spiritual discipline over the past week</p>
            </div>
            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full">
                Weekly Average: @Model.WeeklyAveragePercent%
            </span>
        </div>

        <div class="grid grid-cols-7 gap-2 sm:gap-4 pt-2">
            @foreach (var day in Model.WeeklyProgress)
            {
                var isCurrent = day.Date.Date == DateTime.Today.Date;
                <div class="flex flex-col items-center p-3 rounded-2xl border @(isCurrent ? "border-emerald-500 bg-emerald-50/50" : "border-slate-100 bg-slate-50/80") text-center transition-all">
                    <span class="text-xs font-bold uppercase @(isCurrent ? "text-emerald-800" : "text-slate-500")">@day.DayName</span>
                    <span class="text-[11px] text-slate-400 mb-2">@day.Date.ToString("dd MMM")</span>
                    
                    <!-- Progress Bar vertical -->
                    <div class="w-4 h-20 bg-slate-200 rounded-full flex flex-col justify-end overflow-hidden p-0.5 my-1">
                        <div class="w-full bg-gradient-to-t from-emerald-600 to-teal-400 rounded-full transition-all duration-500" style="height: @(day.Percentage)%;"></div>
                    </div>

                    <span class="text-xs font-extrabold text-slate-800 mt-1">@day.Percentage%</span>
                    <div class="flex gap-1 text-[10px] text-slate-400 mt-1">
                        <span title="Prayers done">🕌 @day.PrayersDone/5</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- MAIN GRID: 1. Daily Goals & 2. Interactive Modules -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- LEFT COLUMN (5 Cols): Daily Goals Checklist -->
        <div class="lg:col-span-5 space-y-6">
            
            <!-- Daily Islamic Goals Checklist -->
            <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-sm border border-slate-200 space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                            <i class="bi bi-check2-circle text-lg"></i>
                        </div>
                        <div>
                            <h3 class="font-extrabold text-slate-900 text-base">Daily Islamic Goals</h3>
                            <p class="text-xs text-slate-500">Tap to check off today's practices</p>
                        </div>
                    </div>
                    <span id="goalCountBadge" class="text-xs font-bold px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full">
                        @Model.DailyProgressPercent% Complete
                    </span>
                </div>

                <!-- 5 Daily Prayers Section -->
                <div class="space-y-2">
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center justify-between">
                        <span>1. Five Daily Prayers</span>
                        <span class="text-[11px] text-emerald-700 font-semibold">Obligatory (Fard)</span>
                    </p>
                    <div class="grid grid-cols-5 gap-2">
                        @{
                            var prayers = new[]
                            {
                                new { Key = "fajr", Name = "Fajr", Done = Model.TodayGoals.Fajr },
                                new { Key = "dhuhr", Name = "Dhuhr", Done = Model.TodayGoals.Dhuhr },
                                new { Key = "asr", Name = "Asr", Done = Model.TodayGoals.Asr },
                                new { Key = "maghrib", Name = "Maghrib", Done = Model.TodayGoals.Maghrib },
                                new { Key = "isha", Name = "Isha", Done = Model.TodayGoals.Isha },
                            };
                        }
                        @foreach (var p in prayers)
                        {
                            <button type="button" 
                                    onclick="toggleGoal('@p.Key', this)"
                                    data-active="@(p.Done ? "true" : "false")"
                                    class="goal-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border transition-all @(p.Done ? "bg-emerald-600 border-emerald-600 text-white shadow-xs font-bold" : "bg-slate-50 border-slate-200 text-slate-700 hover:border-emerald-400 font-medium")">
                                <span class="text-xs">@p.Name</span>
                                <i class="bi @(p.Done ? "bi-check-circle-fill text-white" : "bi-circle text-slate-400") mt-1 text-sm"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Quran, Adhkar, Dhikr, Ruqyah, Charity Toggles -->
                <div class="space-y-2.5 pt-2 border-t border-slate-100">
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">2. Personal Habits & Sunnah</p>
                    
                    <!-- Quran Goal Toggle -->
                    <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-emerald-300 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
                                <i class="bi bi-book"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Recite Daily Quran Goal</p>
                                <p class="text-[11px] text-slate-500">Target: @Model.TodayQuran.DailyTarget Pages / day</p>
                            </div>
                        </div>
                        <input type="checkbox" id="goal_quran" 
                               onchange="toggleGoal('quran', this)"
                               @(Model.TodayGoals.QuranRead ? "checked" : "")
                               class="w-5 h-5 accent-emerald-600 rounded cursor-pointer" />
                    </div>

                    <!-- Morning Adhkar Toggle -->
                    <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-emerald-300 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center">
                                <i class="bi bi-sun-fill"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Morning Adhkar</p>
                                <p class="text-[11px] text-slate-500">Recited post-Fajr or morning</p>
                            </div>
                        </div>
                        <input type="checkbox" id="goal_morningadhkar" 
                               onchange="toggleGoal('morningadhkar', this)"
                               @(Model.TodayGoals.MorningAdhkar ? "checked" : "")
                               class="w-5 h-5 accent-emerald-600 rounded cursor-pointer" />
                    </div>

                    <!-- Evening Adhkar Toggle -->
                    <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-emerald-300 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center">
                                <i class="bi bi-moon-fill"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Evening Adhkar</p>
                                <p class="text-[11px] text-slate-500">Recited post-Asr or Maghrib</p>
                            </div>
                        </div>
                        <input type="checkbox" id="goal_eveningadhkar" 
                               onchange="toggleGoal('eveningadhkar', this)"
                               @(Model.TodayGoals.EveningAdhkar ? "checked" : "")
                               class="w-5 h-5 accent-emerald-600 rounded cursor-pointer" />
                    </div>

                    <!-- Dhikr Target Toggle -->
                    <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-emerald-300 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center">
                                <i class="bi bi-heart-pulse"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Complete Dhikr Target</p>
                                <p class="text-[11px] text-slate-500">Target: @Model.Settings.DailyDhikrTarget Recitations</p>
                            </div>
                        </div>
                        <input type="checkbox" id="goal_dhikr" 
                               onchange="toggleGoal('dhikr', this)"
                               @(Model.TodayGoals.DhikrTarget ? "checked" : "")
                               class="w-5 h-5 accent-emerald-600 rounded cursor-pointer" />
                    </div>

                    <!-- Ruqyah Routine Toggle -->
                    <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-emerald-300 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Ruqyah Recitation Practice</p>
                                <p class="text-[11px] text-slate-500">Personal Sunnah protection routine</p>
                            </div>
                        </div>
                        <input type="checkbox" id="goal_ruqyah" 
                               onchange="toggleGoal('ruqyah', this)"
                               @(Model.TodayGoals.RuqyahRoutine ? "checked" : "")
                               class="w-5 h-5 accent-emerald-600 rounded cursor-pointer" />
                    </div>

                    <!-- Sadaqah / Charity Toggle -->
                    <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-emerald-300 transition">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
                                <i class="bi bi-gift"></i>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-slate-800">Give Daily Sadaqah / Act of Kindness</p>
                                <p class="text-[11px] text-slate-500">Charity, smiling, helping someone</p>
                            </div>
                        </div>
                        <input type="checkbox" id="goal_charity" 
                               onchange="toggleGoal('charity', this)"
                               @(Model.TodayGoals.CharityGiven ? "checked" : "")
                               class="w-5 h-5 accent-emerald-600 rounded cursor-pointer" />
                    </div>
                </div>
            </div>

            <!-- Reminder & Preferences Settings Box -->
            <div class="bg-slate-50 rounded-3xl p-6 border border-slate-200">
                <div class="flex items-center justify-between mb-4">
                    <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                        <i class="bi bi-sliders text-emerald-600"></i> My Deen Target Settings
                    </h4>
                    <span class="text-[11px] text-slate-500">Customizable</span>
                </div>

                <form asp-controller="MyDeen" asp-action="UpdateSettings" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="text-xs font-bold text-slate-700">Daily Dhikr Target</label>
                        <input type="number" name="DailyDhikrTarget" value="@Model.Settings.DailyDhikrTarget" min="33" max="10000" class="mt-1 w-full text-xs px-3 py-2 bg-white border border-slate-300 rounded-xl" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-700">Daily Quran Goal (Pages)</label>
                        <input type="number" name="DailyQuranPagesTarget" value="@Model.Settings.DailyQuranPagesTarget" min="1" max="100" class="mt-1 w-full text-xs px-3 py-2 bg-white border border-slate-300 rounded-xl" />
                    </div>
                    <div>
                        <label class="text-xs font-bold text-slate-700">Monthly Charity Target (৳)</label>
                        <input type="number" name="MonthlyDonationGoal" value="@Model.Settings.MonthlyDonationGoal" min="0" step="100" class="mt-1 w-full text-xs px-3 py-2 bg-white border border-slate-300 rounded-xl" />
                    </div>
                    
                    <button type="submit" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-xs transition mt-2">
                        Save Goals & Preferences
                    </button>
                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN (7 Cols): Interactive Tabs (Dhikr, Quran, Adhkar, Ruqyah) -->
        <div class="lg:col-span-7 space-y-6">
            
            <!-- Module Navigation Tabs -->
            <div class="bg-white rounded-3xl p-2 shadow-sm border border-slate-200 flex flex-wrap gap-1.5" id="myDeenTabs">
                <button type="button" onclick="switchDeenTab('dhikr')" class="tab-btn flex-1 py-2.5 px-4 rounded-2xl text-xs font-bold transition-all bg-emerald-600 text-white shadow-xs" data-tab="dhikr">
                    📿 Dhikr Counter
                </button>
                <button type="button" onclick="switchDeenTab('quran')" class="tab-btn flex-1 py-2.5 px-4 rounded-2xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100" data-tab="quran">
                    📖 Quran Goal
                </button>
                <button type="button" onclick="switchDeenTab('adhkar')" class="tab-btn flex-1 py-2.5 px-4 rounded-2xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100" data-tab="adhkar">
                    ☀️ Adhkar Routine
                </button>
                <button type="button" onclick="switchDeenTab('ruqyah')" class="tab-btn flex-1 py-2.5 px-4 rounded-2xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100" data-tab="ruqyah">
                    🛡️ Ruqyah Practice
                </button>
            </div>

            <!-- TAB 1: DHIKR COUNTER -->
            <div id="tab_dhikr" class="tab-content block space-y-6">
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 text-center relative">
                    <div class="max-w-md mx-auto space-y-4">
                        
                        <!-- Dhikr Selector -->
                        <div class="flex items-center justify-between gap-3 text-left">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Select Dhikr</label>
                            <select id="dhikrSelect" onchange="onDhikrSelectChange(this)" class="text-xs font-bold bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 focus:ring-2 focus:ring-emerald-500">
                                @foreach (var p in Model.DhikrPresets)
                                {
                                    <option value="@p.Name" data-arabic="@p.Arabic" data-meaning="@p.Meaning" data-target="@p.DefaultTarget" data-count="@p.CurrentCount">
                                        @p.Name (@p.CurrentCount / @p.DefaultTarget)
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Active Dhikr Display -->
                        <div class="p-6 bg-gradient-to-br from-emerald-50 to-teal-50/60 rounded-3xl border border-emerald-200 text-center space-y-2">
                            <h2 id="dhikrArabicDisplay" class="text-3xl sm:text-4xl font-bold font-arabic text-emerald-950 leading-relaxed">
                                @Model.DhikrPresets.First().Arabic
                            </h2>
                            <p id="dhikrNameDisplay" class="text-base font-extrabold text-slate-800">
                                @Model.DhikrPresets.First().Name
                            </p>
                            <p id="dhikrMeaningDisplay" class="text-xs text-slate-600 italic">
                                "@Model.DhikrPresets.First().Meaning"
                            </p>
                        </div>

                        <!-- Interactive Circular Tap Button -->
                        <div class="py-4 flex flex-col items-center justify-center">
                            <button type="button" 
                                    id="tasbihTapBtn"
                                    onclick="incrementDhikr()"
                                    class="w-48 h-48 rounded-full bg-gradient-to-br from-emerald-500 via-emerald-600 to-teal-700 text-white shadow-2xl hover:shadow-emerald-500/50 hover:scale-105 active:scale-95 transition-all duration-150 flex flex-col items-center justify-center select-none cursor-pointer border-4 border-white ring-4 ring-emerald-200">
                                <span class="text-xs uppercase font-bold tracking-widest text-emerald-200 mb-1">TAP / CLICK</span>
                                <span id="tasbihCounterNum" class="text-5xl font-black font-mono tracking-tight">@Model.DhikrPresets.First().CurrentCount</span>
                                <span id="tasbihTargetLabel" class="text-xs text-emerald-200 mt-1 font-semibold">Target: @Model.DhikrPresets.First().DefaultTarget</span>
                            </button>
                        </div>

                        <!-- Target Reached Alert Banner -->
                        <div id="targetAchievedBanner" class="hidden p-3 bg-amber-100 border border-amber-300 text-amber-900 rounded-2xl text-xs font-bold animate-bounce">
                            🎉 MashaAllah! You achieved your target for this Dhikr.
                        </div>

                        <!-- Dhikr Controls: Reset, Target, Save -->
                        <div class="flex items-center justify-center gap-3 pt-2">
                            <button type="button" onclick="resetDhikrCounter()" class="px-4 py-2 text-xs font-bold rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 transition">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </button>
                            <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl">
                                <button type="button" onclick="setDhikrTarget(33)" class="px-2.5 py-1 text-xs font-bold rounded-lg hover:bg-white transition">33</button>
                                <button type="button" onclick="setDhikrTarget(100)" class="px-2.5 py-1 text-xs font-bold rounded-lg hover:bg-white transition">100</button>
                                <button type="button" onclick="setDhikrTarget(300)" class="px-2.5 py-1 text-xs font-bold rounded-lg hover:bg-white transition">300</button>
                                <button type="button" onclick="setDhikrTarget(1000)" class="px-2.5 py-1 text-xs font-bold rounded-lg hover:bg-white transition">1k</button>
                            </div>
                        </div>

                        <p class="text-xs text-slate-400 pt-2">
                            ✨ Tap anywhere on the large green dial or press Spacebar on desktop to count.
                        </p>
                    </div>
                </div>
            </div>

            <!-- TAB 2: QURAN GOAL -->
            <div id="tab_quran" class="tab-content hidden space-y-6">
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <div>
                            <h3 class="font-extrabold text-slate-900 text-lg">Daily Quran Reading Goal</h3>
                            <p class="text-xs text-slate-500">Track daily recitation, pages completed, and Surah bookmarks</p>
                        </div>
                        <span class="px-3 py-1 bg-amber-100 text-amber-800 text-xs font-bold rounded-full">
                            Goal: @Model.TodayQuran.DailyTarget Pages / day
                        </span>
                    </div>

                    <!-- Quran Progress Card -->
                    <div class="p-6 bg-gradient-to-br from-amber-500/10 via-emerald-500/5 to-teal-500/10 rounded-3xl border border-amber-200/80 space-y-4">
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div>
                                <p class="text-xs uppercase font-bold text-amber-800 tracking-wider">Current Reading Bookmark</p>
                                <h4 class="text-2xl font-black text-slate-900 mt-1" id="quranSurahDisplay">@Model.TodayQuran.CurrentSurah</h4>
                                <p class="text-xs text-slate-600" id="quranAyahDisplay">Ayah: @Model.TodayQuran.CurrentAyah</p>
                            </div>
                            
                            <div class="text-center sm:text-right">
                                <span class="text-4xl font-black text-emerald-800 font-mono" id="quranPagesDisplay">@Model.TodayQuran.PagesReadToday</span>
                                <span class="text-sm font-bold text-slate-500">/ @Model.TodayQuran.DailyTarget Pages</span>
                                <p class="text-xs text-emerald-700 font-bold mt-0.5">Read Today</p>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        @{
                            var quranPercent = (int)Math.Min(100, Math.Round((double)Model.TodayQuran.PagesReadToday / Math.Max(1, Model.TodayQuran.DailyTarget) * 100));
                        }
                        <div class="w-full bg-amber-200/60 rounded-full h-3.5 overflow-hidden">
                            <div id="quranProgressBar" class="bg-gradient-to-r from-amber-500 to-emerald-600 h-full rounded-full transition-all duration-300" style="width: @quranPercent%;"></div>
                        </div>
                    </div>

                    <!-- Interactive Log Controls -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs font-bold text-slate-700">Select Surah Bookmark</label>
                            <input type="text" id="quranSurahInput" value="@Model.TodayQuran.CurrentSurah" class="mt-1 w-full text-xs font-semibold px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" placeholder="e.g. Surah Al-Kahf" />
                        </div>
                        <div>
                            <label class="text-xs font-bold text-slate-700">Current Ayah Number</label>
                            <input type="number" id="quranAyahInput" value="@Model.TodayQuran.CurrentAyah" min="1" class="mt-1 w-full text-xs font-semibold px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
                        </div>
                    </div>

                    <!-- Pages Read Quick Increment Buttons -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-slate-700">Quick Increment Pages Read Today</label>
                        <div class="flex items-center gap-3">
                            <button type="button" onclick="adjustQuranPages(1)" class="flex-1 py-2.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-800 font-bold text-xs rounded-xl transition">
                                +1 Page
                            </button>
                            <button type="button" onclick="adjustQuranPages(5)" class="flex-1 py-2.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-800 font-bold text-xs rounded-xl transition">
                                +5 Pages
                            </button>
                            <button type="button" onclick="adjustQuranPages(10)" class="flex-1 py-2.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-800 font-bold text-xs rounded-xl transition">
                                +10 Pages (1/2 Juz)
                            </button>
                            <button type="button" onclick="adjustQuranPages(20)" class="flex-1 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs transition">
                                +20 (Full Juz)
                            </button>
                        </div>
                    </div>

                    <button type="button" onclick="saveQuranProgress()" class="w-full py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-sm rounded-2xl shadow-md transition">
                        Save Quran Reading Progress
                    </button>
                </div>
            </div>

            <!-- TAB 3: ADHKAR (MORNING & EVENING) -->
            <div id="tab_adhkar" class="tab-content hidden space-y-6">
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <div>
                            <h3 class="font-extrabold text-slate-900 text-lg">Morning & Evening Adhkar</h3>
                            <p class="text-xs text-slate-500">Prophetic fortress and spiritual remembrance checklist</p>
                        </div>
                        <div class="flex gap-2">
                            <button type="button" onclick="showAdhkarSubTab('morning')" id="adhkarSubMorningBtn" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-100 text-amber-900">
                                ☀️ Morning
                            </button>
                            <button type="button" onclick="showAdhkarSubTab('evening')" id="adhkarSubEveningBtn" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600">
                                🌙 Evening
                            </button>
                        </div>
                    </div>

                    <!-- Morning Adhkar List -->
                    <div id="adhkarMorningList" class="space-y-4">
                        @foreach (var item in Model.MorningAdhkar)
                        {
                            <div class="p-5 rounded-2xl border @(item.IsCompleted ? "border-emerald-300 bg-emerald-50/40" : "border-slate-200 bg-slate-50/60") space-y-3 transition">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <span class="px-2 py-0.5 bg-amber-100 text-amber-800 text-[10px] font-bold rounded-md">Repeat @item.TargetCount x</span>
                                        <h4 class="font-bold text-slate-900 text-sm mt-1">@item.Title</h4>
                                    </div>
                                    <input type="checkbox" 
                                           onchange="toggleAdhkar('Morning', '@item.Key', '@item.Title', this)"
                                           @(item.IsCompleted ? "checked" : "")
                                           class="w-5 h-5 accent-emerald-600 rounded cursor-pointer mt-1" />
                                </div>
                                <p class="text-lg font-arabic font-bold text-emerald-950 text-right leading-loose">
                                    @item.Arabic
                                </p>
                                <p class="text-xs text-slate-600 italic">
                                    @item.Transliteration
                                </p>
                                <p class="text-xs text-slate-800 font-medium">
                                    <strong>Meaning:</strong> @item.Translation
                                </p>
                                <div class="p-2.5 bg-white rounded-xl border border-slate-200 text-[11px] text-emerald-800 font-semibold flex items-center gap-2">
                                    <i class="bi bi-award-fill text-amber-500"></i>
                                    <span>Virtue: @item.Benefit</span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Evening Adhkar List -->
                    <div id="adhkarEveningList" class="hidden space-y-4">
                        @foreach (var item in Model.EveningAdhkar)
                        {
                            <div class="p-5 rounded-2xl border @(item.IsCompleted ? "border-purple-300 bg-purple-50/40" : "border-slate-200 bg-slate-50/60") space-y-3 transition">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <span class="px-2 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded-md">Repeat @item.TargetCount x</span>
                                        <h4 class="font-bold text-slate-900 text-sm mt-1">@item.Title</h4>
                                    </div>
                                    <input type="checkbox" 
                                           onchange="toggleAdhkar('Evening', '@item.Key', '@item.Title', this)"
                                           @(item.IsCompleted ? "checked" : "")
                                           class="w-5 h-5 accent-emerald-600 rounded cursor-pointer mt-1" />
                                </div>
                                <p class="text-lg font-arabic font-bold text-purple-950 text-right leading-loose">
                                    @item.Arabic
                                </p>
                                <p class="text-xs text-slate-600 italic">
                                    @item.Transliteration
                                </p>
                                <p class="text-xs text-slate-800 font-medium">
                                    <strong>Meaning:</strong> @item.Translation
                                </p>
                                <div class="p-2.5 bg-white rounded-xl border border-slate-200 text-[11px] text-purple-800 font-semibold flex items-center gap-2">
                                    <i class="bi bi-shield-fill-check text-purple-600"></i>
                                    <span>Virtue: @item.Benefit</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- TAB 4: RUQYAH PRACTICE -->
            <div id="tab_ruqyah" class="tab-content hidden space-y-6">
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <div>
                            <h3 class="font-extrabold text-slate-900 text-lg">Ruqyah & Spiritual Protection Practice</h3>
                            <p class="text-xs text-slate-500">Authentic Prophetic recitation for spiritual shielding, healing, and peace</p>
                        </div>
                        <span class="px-3 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded-full">
                            Daily Recitation Checklist
                        </span>
                    </div>

                    <div class="p-4 bg-blue-50 border border-blue-200 rounded-2xl text-xs text-blue-900 space-y-1">
                        <p class="font-bold flex items-center gap-1.5"><i class="bi bi-info-circle-fill"></i> Guidelines for Self-Ruqyah Recitation:</p>
                        <p class="text-blue-800">Recite with purity (Wudu), unwavering conviction that healing is from Allah alone (Ash-Shafi), and follow the Prophetic Sunnah of cupping palms and blowing lightly.</p>
                    </div>

                    <div class="space-y-4">
                        @foreach (var routine in Model.RuqyahRoutines)
                        {
                            <div class="p-5 rounded-2xl border @(routine.IsCompleted ? "border-blue-300 bg-blue-50/40" : "border-slate-200 bg-slate-50/60") space-y-3 transition">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <span class="px-2 py-0.5 bg-blue-100 text-blue-800 text-[10px] font-bold rounded-md">Recitation: @routine.RecitationCount x</span>
                                        <h4 class="font-bold text-slate-900 text-sm mt-1">@routine.Title</h4>
                                    </div>
                                    <input type="checkbox" 
                                           onchange="toggleRuqyah('Daily Protection', '@routine.Key', '@routine.Title', this)"
                                           @(routine.IsCompleted ? "checked" : "")
                                           class="w-5 h-5 accent-emerald-600 rounded cursor-pointer mt-1" />
                                </div>
                                <p class="text-lg font-arabic font-bold text-slate-900 text-right leading-loose">
                                    @routine.Arabic
                                </p>
                                <p class="text-xs text-slate-600 italic">
                                    @routine.Transliteration
                                </p>
                                <p class="text-xs text-slate-800 font-medium">
                                    <strong>Translation:</strong> @routine.Translation
                                </p>
                                <div class="p-3 bg-white rounded-xl border border-slate-200 space-y-1 text-xs">
                                    <p class="text-[11px] text-emerald-800 font-bold flex items-center gap-1.5">
                                        <i class="bi bi-check-circle-fill text-emerald-600"></i> How to Practice: @routine.Instructions
                                    </p>
                                    <p class="text-[11px] text-slate-500 italic">
                                        Virtue: @routine.Benefit
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    // Tab switcher
    function switchDeenTab(tabName) {
        document.querySelectorAll('.tab-btn').forEach(btn => {
            if (btn.getAttribute('data-tab') === tabName) {
                btn.className = 'tab-btn flex-1 py-2.5 px-4 rounded-2xl text-xs font-bold transition-all bg-emerald-600 text-white shadow-xs';
            } else {
                btn.className = 'tab-btn flex-1 py-2.5 px-4 rounded-2xl text-xs font-bold transition-all text-slate-600 hover:bg-slate-100';
            }
        });

        document.querySelectorAll('.tab-content').forEach(tab => tab.classList.add('hidden'));
        const activeTab = document.getElementById('tab_' + tabName);
        if (activeTab) activeTab.classList.remove('hidden');
    }

    function showAdhkarSubTab(type) {
        if (type === 'morning') {
            document.getElementById('adhkarMorningList').classList.remove('hidden');
            document.getElementById('adhkarEveningList').classList.add('hidden');
            document.getElementById('adhkarSubMorningBtn').className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-100 text-amber-900';
            document.getElementById('adhkarSubEveningBtn').className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600';
        } else {
            document.getElementById('adhkarMorningList').classList.add('hidden');
            document.getElementById('adhkarEveningList').classList.remove('hidden');
            document.getElementById('adhkarSubMorningBtn').className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600';
            document.getElementById('adhkarSubEveningBtn').className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-purple-100 text-purple-900';
        }
    }

    // Toggle Goal Ajax
    function toggleGoal(goalName, element) {
        const isCheckbox = element.type === 'checkbox';
        let isDone;
        if (isCheckbox) {
            isDone = element.checked;
        } else {
            const current = element.getAttribute('data-active') === 'true';
            isDone = !current;
            element.setAttribute('data-active', isDone ? 'true' : 'false');
            if (isDone) {
                element.className = 'goal-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border transition-all bg-emerald-600 border-emerald-600 text-white shadow-xs font-bold';
                element.querySelector('i').className = 'bi bi-check-circle-fill text-white mt-1 text-sm';
            } else {
                element.className = 'goal-btn flex flex-col items-center justify-center p-2.5 rounded-2xl border transition-all bg-slate-50 border-slate-200 text-slate-700 hover:border-emerald-400 font-medium';
                element.querySelector('i').className = 'bi bi-circle text-slate-400 mt-1 text-sm';
            }
        }

        const formData = new FormData();
        formData.append('goalName', goalName);
        formData.append('isCompleted', isDone);

        fetch('/MyDeen/ToggleGoal', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                updateProgressDisplays(data.percentage, data.streak);
            }
        })
        .catch(err => console.error(err));
    }

    function updateProgressDisplays(percent, streak) {
        const headerProg = document.getElementById('headerProgressDisplay');
        if (headerProg) headerProg.textContent = percent + '%';

        const countBadge = document.getElementById('goalCountBadge');
        if (countBadge) countBadge.textContent = percent + '% Complete';

        const circleText = document.getElementById('circleProgressText');
        if (circleText) circleText.textContent = percent + '%';

        const circlePath = document.getElementById('circleProgressPath');
        if (circlePath) circlePath.setAttribute('stroke-dasharray', percent + ', 100');

        const streakEl = document.getElementById('streakCountDisplay');
        if (streakEl && streak) streakEl.textContent = streak + ' Days';
    }

    // Interactive Tasbih Dhikr
    let currentDhikrCount = parseInt('@Model.DhikrPresets.First().CurrentCount');
    let currentDhikrTarget = parseInt('@Model.DhikrPresets.First().DefaultTarget');
    let currentDhikrName = '@Model.DhikrPresets.First().Name';

    function onDhikrSelectChange(select) {
        const opt = select.options[select.selectedIndex];
        currentDhikrName = opt.value;
        currentDhikrCount = parseInt(opt.getAttribute('data-count')) || 0;
        currentDhikrTarget = parseInt(opt.getAttribute('data-target')) || 100;

        document.getElementById('dhikrArabicDisplay').textContent = opt.getAttribute('data-arabic');
        document.getElementById('dhikrNameDisplay').textContent = currentDhikrName;
        document.getElementById('dhikrMeaningDisplay').textContent = `"${opt.getAttribute('data-meaning')}"`;
        document.getElementById('tasbihCounterNum').textContent = currentDhikrCount;
        document.getElementById('tasbihTargetLabel').textContent = `Target: ${currentDhikrTarget}`;
        
        checkDhikrTargetAchieved();
    }

    function incrementDhikr() {
        currentDhikrCount++;
        document.getElementById('tasbihCounterNum').textContent = currentDhikrCount;

        // Vibrate if mobile browser supports haptics
        if (navigator.vibrate) {
            navigator.vibrate(20);
        }

        checkDhikrTargetAchieved();
        debounceSaveDhikr();
    }

    function checkDhikrTargetAchieved() {
        const banner = document.getElementById('targetAchievedBanner');
        if (currentDhikrCount >= currentDhikrTarget) {
            banner?.classList.remove('hidden');
        } else {
            banner?.classList.add('hidden');
        }
    }

    function resetDhikrCounter() {
        currentDhikrCount = 0;
        document.getElementById('tasbihCounterNum').textContent = '0';
        checkDhikrTargetAchieved();
        debounceSaveDhikr();
    }

    function setDhikrTarget(val) {
        currentDhikrTarget = val;
        document.getElementById('tasbihTargetLabel').textContent = `Target: ${val}`;
        checkDhikrTargetAchieved();
        debounceSaveDhikr();
    }

    let dhikrSaveTimeout;
    function debounceSaveDhikr() {
        clearTimeout(dhikrSaveTimeout);
        dhikrSaveTimeout = setTimeout(() => {
            const formData = new FormData();
            formData.append('dhikrName', currentDhikrName);
            formData.append('count', currentDhikrCount);
            formData.append('target', currentDhikrTarget);

            fetch('/MyDeen/SaveDhikr', {
                method: 'POST',
                body: formData
            }).then(() => {
                // Check if target achieved to toggle goal in UI
                if (currentDhikrCount >= currentDhikrTarget) {
                    const chk = document.getElementById('goal_dhikr');
                    if (chk && !chk.checked) chk.checked = true;
                }
            });
        }, 500);
    }

    // Spacebar tap for desktop tasbih
    window.addEventListener('keydown', function(e) {
        if (e.code === 'Space' && e.target === document.body) {
            e.preventDefault();
            incrementDhikr();
        }
    });

    // Quran Progress
    let currentQuranPages = parseInt('@Model.TodayQuran.PagesReadToday');
    let quranTarget = parseInt('@Model.TodayQuran.DailyTarget');

    function adjustQuranPages(amount) {
        currentQuranPages += amount;
        document.getElementById('quranPagesDisplay').textContent = currentQuranPages;
        const pct = Math.min(100, Math.round(currentQuranPages / Math.max(1, quranTarget) * 100));
        document.getElementById('quranProgressBar').style.width = pct + '%';
    }

    function saveQuranProgress() {
        const surah = document.getElementById('quranSurahInput').value;
        const ayah = parseInt(document.getElementById('quranAyahInput').value) || 1;

        const formData = new FormData();
        formData.append('goalType', 'pages');
        formData.append('target', quranTarget);
        formData.append('surah', surah);
        formData.append('ayah', ayah);
        formData.append('pagesRead', currentQuranPages);

        fetch('/MyDeen/SaveQuran', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                document.getElementById('quranSurahDisplay').textContent = surah;
                document.getElementById('quranAyahDisplay').textContent = 'Ayah: ' + ayah;
                alert('Quran reading progress saved successfully!');
            }
        });
    }

    // Adhkar & Ruqyah Toggles
    function toggleAdhkar(type, key, title, checkbox) {
        const formData = new FormData();
        formData.append('adhkarType', type);
        formData.append('itemKey', key);
        formData.append('title', title);
        formData.append('isCompleted', checkbox.checked);

        fetch('/MyDeen/ToggleAdhkar', { method: 'POST', body: formData });
    }

    function toggleRuqyah(routineType, key, title, checkbox) {
        const formData = new FormData();
        formData.append('routineType', routineType);
        formData.append('itemKey', key);
        formData.append('title', title);
        formData.append('isCompleted', checkbox.checked);

        fetch('/MyDeen/ToggleRuqyah', { method: 'POST', body: formData });
    }
</script>
}
