@model List<AdDiin.Models.Entities.Conversation>
@{
    ViewData["Title"] = "Direct Support & Messages";
    var active = ViewBag.ActiveConversation as AdDiin.Models.Entities.Conversation;
}

<div class="container my-5">
    <div class="card card-custom border rounded-4 bg-white shadow-sm overflow-hidden" style="min-height: 550px;">
        <div class="row g-0">
            <!-- Conversations List Sidebar -->
            <div class="col-md-4 border-end bg-light">
                <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-chat-dots text-emerald me-2"></i> Conversations</h6>
                </div>

                <div class="list-group list-group-flush overflow-y-auto" style="max-height: 480px;">
                    @if (!Model.Any())
                    {
                        <div class="p-4 text-center text-muted small">No active conversations.</div>
                    }
                    else
                    {
                        @foreach (var c in Model)
                        {
                            var isActive = active != null && active.Id == c.Id;
                            <a asp-action="Index" asp-route-id="@c.Id" class="list-group-item list-group-item-action p-3 @(isActive ? "bg-emerald-light border-emerald" : "")">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-dark text-truncate">@(c.Subject ?? "Support Request")</strong>
                                    <small class="text-muted" style="font-size: 0.7rem;">@c.UpdatedAt?.ToString("hh:mm tt")</small>
                                </div>
                                <div class="text-muted small text-truncate">
                                    @(c.Messages.LastOrDefault()?.MessageContent ?? "No messages yet")
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>

            <!-- Active Chat Area -->
            <div class="col-md-8 d-flex flex-column" style="height: 550px;">
                @if (active != null)
                {
                    <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">@active.Subject</h6>
                            <small class="text-muted">Chat with Mosque Support / Imam</small>
                        </div>
                        <span class="badge @(active.Status == "active" ? "bg-success" : "bg-secondary")">@active.Status</span>
                    </div>

                    <!-- Messages Stream -->
                    <div class="chat-box flex-grow-1 p-3 overflow-y-auto" id="chatBox">
                        @if (!active.Messages.Any())
                        {
                            <div class="text-center text-muted my-5 small">
                                Start the conversation by sending a message below.
                            </div>
                        }
                        else
                        {
                            @foreach (var msg in active.Messages)
                            {
                                var isMe = msg.SenderType == (User.IsInRole("Admin") ? "admin" : "user");
                                <div class="mb-3 d-flex flex-column @(isMe ? "align-items-end" : "align-items-start")">
                                    <div class="@(isMe ? "chat-bubble-user" : "chat-bubble-bot")">
                                        @msg.MessageContent
                                    </div>
                                    <small class="text-muted mt-1 px-1" style="font-size: 0.7rem;">
                                        @msg.CreatedAt.ToString("hh:mm tt") @(isMe && msg.IsRead ? "✓✓ Read" : "")
                                    </small>
                                </div>
                            }
                        }
                    </div>

                    <!-- Message Input Form -->
                    <div class="p-3 border-top bg-white">
                        <form asp-action="SendMessage" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="conversationId" value="@active.Id" />
                            <input type="text" name="messageContent" class="form-control rounded-pill" placeholder="Write your message..." required autocomplete="off" />
                            <button type="submit" class="btn btn-emerald-gradient rounded-pill px-4 fw-bold">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                        Select a conversation to start chatting.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chatBox = document.getElementById('chatBox');
        if (chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
}