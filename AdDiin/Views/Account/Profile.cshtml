@model AdDiin.Models.ViewModels.UserProfileDashboardViewModel
@{
    ViewData["Title"] = $"{Model.User.FullName} | Islamic Profile & Progress";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Profile Hero Header -->
    <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-teal-950 rounded-3xl p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
            <div class="w-20 h-20 rounded-3xl bg-emerald-600 text-white font-extrabold text-3xl flex items-center justify-center shadow-lg border-2 border-emerald-400/40">
                @(Model.User.FullName?.FirstOrDefault() ?? 'U')
            </div>
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <h1 class="text-2xl sm:text-3xl font-extrabold">@Model.User.FullName</h1>
                    <span class="px-2.5 py-0.5 bg-emerald-500/30 text-emerald-300 text-xs font-bold rounded-full border border-emerald-500/30">
                        @Model.ProfileForm.Role
                    </span>
                </div>
                <p class="text-slate-300 text-xs sm:text-sm">@Model.User.Email • Member since @Model.User.CreatedAt.ToString("MMMM yyyy")</p>
                <div class="flex items-center gap-3 pt-2 text-xs">
                    <span class="px-3 py-1 bg-amber-500/20 text-amber-300 font-bold rounded-xl border border-amber-500/30">
                        🔥 @Model.CurrentStreak Day Streak
                    </span>
                    <span class="px-3 py-1 bg-emerald-500/20 text-emerald-300 font-bold rounded-xl border border-emerald-500/30">
                        🎯 @Model.OverallCompletionRate% Consistency
                    </span>
                </div>
            </div>
        </div>

        <div class="flex gap-2">
            <a href="/my-deen" class="px-5 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition flex items-center gap-2">
                <i class="bi bi-compass-fill"></i> Open My Deen Hub
            </a>
        </div>
    </div>

    <!-- Statistics Overview Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Prayer Consistency</span>
                <i class="bi bi-clock-history text-emerald-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">@Model.PrayerCompletionRate%</p>
            <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                <div class="bg-emerald-600 h-full rounded-full" style="width: @Model.PrayerCompletionRate%;"></div>
            </div>
        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Quran Recitation</span>
                <i class="bi bi-book text-amber-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">@Model.QuranProgressPages <span class="text-sm font-bold text-slate-400">Pages</span></p>
            <p class="text-xs text-slate-500">Total pages tracked</p>
        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Dhikr Recitations</span>
                <i class="bi bi-heart-pulse text-teal-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">@Model.DhikrTotalCount</p>
            <p class="text-xs text-slate-500">Glorifications counted</p>
        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 space-y-2">
            <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase">
                <span>Charity Given</span>
                <i class="bi bi-gift text-purple-600 text-base"></i>
            </div>
            <p class="text-3xl font-black text-slate-900">৳@Model.LifetimeDonated.ToString("N0")</p>
            <p class="text-xs text-slate-500">Goal: ৳@Model.MonthlyDonationGoal.ToString("N0") / month</p>
        </div>
    </div>

    <!-- Achievements & Badges -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200/80 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-100 gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shadow-xs border border-amber-200/60">
                    <i class="bi bi-award-fill"></i>
                </div>
                <div>
                    <h3 class="font-extrabold text-slate-900 text-base sm:text-lg">Spiritual Milestones & Badges</h3>
                    <p class="text-xs text-slate-500">Earn badges through consistent prayer, dhikr targets, and charity</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-800 bg-emerald-50 px-3.5 py-1.5 rounded-full border border-emerald-200/60">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    @Model.Badges.Count(b => b.IsUnlocked) of @Model.Badges.Count Unlocked
                </span>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3.5">
            @foreach (var badge in Model.Badges)
            {
                <div class="group relative flex flex-col items-center justify-between p-4 rounded-2xl border text-center transition-all duration-200 @(badge.IsUnlocked ? "border-amber-200/80 bg-gradient-to-b from-amber-50/60 to-orange-50/20 shadow-xs hover:shadow-md hover:border-amber-300" : "border-slate-100 bg-slate-50/70 hover:bg-slate-50")">
                    <div class="flex flex-col items-center w-full">
                        <div class="w-13 h-13 rounded-2xl mx-auto flex items-center justify-center text-2xl mb-2.5 transition-transform duration-200 group-hover:scale-105 @(badge.IsUnlocked ? "bg-white text-amber-500 shadow-sm border border-amber-100" : "bg-slate-200/80 text-slate-400")">
                            @if (badge.Icon.StartsWith("bi-") || badge.Icon.StartsWith("fa"))
                            {
                                <i class="bi @badge.Icon text-2xl @(badge.IsUnlocked ? "text-amber-500" : "text-slate-400")"></i>
                            }
                            else
                            {
                                <span>@badge.Icon</span>
                            }
                        </div>
                        <h4 class="font-bold text-xs @(badge.IsUnlocked ? "text-slate-900" : "text-slate-600")">@badge.Title</h4>
                        <p class="text-[11px] text-slate-400 mt-1 leading-snug line-clamp-2">@badge.Description</p>
                        @if (!string.IsNullOrEmpty(badge.ProgressText))
                        {
                            <span class="text-[10px] font-semibold text-slate-400 mt-1.5 px-2 py-0.5 rounded-md bg-slate-100/80">
                                @badge.ProgressText
                            </span>
                        }
                    </div>

                    <div class="mt-3 pt-2 w-full border-t @(badge.IsUnlocked ? "border-amber-100" : "border-slate-200/60") flex items-center justify-center">
                        @if (badge.IsUnlocked)
                        {
                            <span class="inline-flex items-center gap-1 text-[10px] font-extrabold text-amber-700 bg-amber-100/80 px-2.5 py-0.5 rounded-full">
                                <i class="bi bi-check-circle-fill text-[9px] text-amber-600"></i> Unlocked
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-slate-400">
                                <i class="bi bi-lock-fill text-[9px]"></i> Locked
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Personal Info & Activity Logs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left 6 cols: Personal Information & Edit -->
        <div class="lg:col-span-6 space-y-6">
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="font-extrabold text-slate-900 text-base">Personal Information</h3>
                    <a href="/Account/ChangePassword" class="text-xs font-bold text-emerald-700 hover:text-emerald-800">
                        Change Password &rarr;
                    </a>
                </div>

                <form asp-controller="Account" asp-action="UpdateInfo" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="text-xs font-bold text-slate-700">Full Name</label>
                        <input type="text" name="FullName" value="@Model.ProfileForm.FullName" class="mt-1 w-full text-xs font-semibold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" required />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs font-bold text-slate-700">Phone Number</label>
                            <input type="tel" name="PhoneNumber" value="@Model.ProfileForm.PhoneNumber" class="mt-1 w-full text-xs font-semibold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
                        </div>
                        <div>
                            <label class="text-xs font-bold text-slate-700">City / District</label>
                            <input type="text" name="City" value="@Model.ProfileForm.City" class="mt-1 w-full text-xs font-semibold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
                        </div>
                    </div>

                    <div>
                        <label class="text-xs font-bold text-slate-700">Address</label>
                        <input type="text" name="Address" value="@Model.ProfileForm.Address" class="mt-1 w-full text-xs font-semibold px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
                    </div>

                    <button type="submit" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-xs transition">
                        Update Profile Information
                    </button>
                </form>
            </div>
        </div>

        <!-- Right 6 cols: Recent Activities & Charity Logs -->
        <div class="lg:col-span-6 space-y-6">
            
            <!-- My Activities Log -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="font-extrabold text-slate-900 text-base">My Registered Programs</h3>
                    <a href="/my-activities" class="text-xs font-bold text-emerald-700 hover:text-emerald-800">View All &rarr;</a>
                </div>

                <div class="space-y-3">
                    @if (Model.RegisteredPrograms.Any())
                    {
                        @foreach (var r in Model.RegisteredPrograms)
                        {
                            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-between">
                                <div class="space-y-0.5">
                                    <h4 class="font-bold text-slate-900 text-xs truncate max-w-xs">@r.Activity.Title</h4>
                                    <p class="text-[11px] text-slate-500">@r.Activity.Category • @(r.Activity.ProgramDate?.ToString("MMM dd, yyyy") ?? "TBA")</p>
                                </div>
                                <span class="px-2.5 py-1 text-[10px] font-bold rounded-full @(r.Status == "Approved" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                    @r.Status
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-slate-500 text-center py-4">No registered activities yet.</p>
                    }
                </div>
            </div>

            <!-- My Charity Log -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="font-extrabold text-slate-900 text-base">Recent Charity & Zakat</h3>
                    <a href="/my-donations" class="text-xs font-bold text-emerald-700 hover:text-emerald-800">View History &rarr;</a>
                </div>

                <div class="space-y-3">
                    @if (Model.DonationHistory.Any())
                    {
                        @foreach (var d in Model.DonationHistory)
                        {
                            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-between">
                                <div class="space-y-0.5">
                                    <h4 class="font-bold text-slate-900 text-xs uppercase">@d.Category Fund</h4>
                                    <p class="text-[11px] text-slate-500">@d.CreatedAt.ToString("MMM dd, yyyy") • @d.PaymentMethod</p>
                                </div>
                                <span class="font-extrabold text-xs text-slate-900">
                                    ৳@d.Amount.ToString("N0")
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-slate-500 text-center py-4">No donations recorded yet.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
