@model AdDiin.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="container my-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card card-custom p-4 border rounded-4 bg-white text-center">
                <div class="avatar-circle-lg bg-emerald text-white fw-bold mx-auto mb-3 fs-2">
                    @(Model.FullName.FirstOrDefault())
                </div>
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <p class="text-muted small mb-2">@Model.Email</p>
                <span class="badge bg-emerald-light text-emerald px-3 py-1 rounded-pill mb-3">@Model.Role</span>
                
                <hr class="my-3" />
                <div class="text-start small text-muted space-y-2">
                    <div><i class="bi bi-telephone me-2 text-emerald"></i> @(Model.PhoneNumber ?? "Not provided")</div>
                    <div><i class="bi bi-geo-alt me-2 text-emerald"></i> @(Model.City ?? "Dhaka"), @(Model.Address ?? "Bangladesh")</div>
                    <div><i class="bi bi-calendar me-2 text-emerald"></i> Member since @Model.CreatedAt.ToString("MMM yyyy")</div>
                </div>

                <div class="mt-4">
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                        <i class="bi bi-key me-1"></i> Change Password
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white">
                <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-pencil-square text-emerald me-2"></i> Edit Profile Information</h4>

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control py-2" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address (Read-only)</label>
                            <input asp-for="Email" class="form-control py-2 bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control py-2" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold">City</label>
                            <input asp-for="City" class="form-control py-2" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PostalCode" class="form-label fw-semibold">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control py-2" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth</label>
                            <input asp-for="DateOfBirth" class="form-control py-2" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold">Gender</label>
                            <select asp-for="Gender" class="form-select py-2">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label fw-semibold">Address</label>
                        <input asp-for="Address" class="form-control py-2" />
                    </div>

                    <button type="submit" class="btn btn-emerald-gradient px-4 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>