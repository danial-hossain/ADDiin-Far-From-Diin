@model AdDiin.Models.ViewModels.VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify Your Email";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm text-center">
                <div class="brand-logo-icon mx-auto mb-3 fs-2 bg-emerald text-white">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Verify Email Address</h3>
                <p class="text-muted small mb-4">
                    We sent a 6-digit verification code to <strong>@Model.Email</strong>
                </p>

                <form asp-action="VerifyEmail" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <input asp-for="Code" class="form-control text-center fs-2 font-monospace tracking-widest py-3 border-emerald rounded-3" placeholder="000000" maxlength="6" autofocus />
                        <span asp-validation-for="Code" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-emerald-gradient w-100 py-3 rounded-pill fw-bold shadow-sm mb-3">
                        Verify & Continue
                    </button>
                </form>

                <form asp-action="ResendCode" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit" class="btn btn-link text-emerald small text-decoration-none p-0">
                        <i class="bi bi-arrow-repeat me-1"></i> Resend Verification Code
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>