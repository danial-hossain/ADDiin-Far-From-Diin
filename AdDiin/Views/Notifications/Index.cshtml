@model AdDiin.Models.ViewModels.NotificationsPageViewModel
@{
    ViewData["Title"] = "Notifications & Reminders | ADDiin";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header -->
    <div class="bg-gradient-to-r from-emerald-950 via-teal-950 to-slate-900 rounded-3xl p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
            <span class="px-3.5 py-1 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold rounded-full uppercase tracking-wider">
                <i class="bi bi-bell-fill me-1"></i> Reminders & Alerts
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Notifications & Islamic Reminders</h1>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                Stay updated with prayer alerts, Sunnah fasting reminders, Islamic calendar events, and registered activity notifications.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-4 py-3 bg-white/10 hover:bg-white/20 text-white font-bold text-xs rounded-2xl border border-white/20 shadow-sm transition flex items-center gap-2">
                    <i class="bi bi-check2-all"></i> Mark All as Read
                </button>
            </form>
            <a href="/my-deen" class="px-4 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-2xl shadow-md transition flex items-center gap-2">
                <i class="bi bi-compass-fill"></i> My Deen
            </a>
        </div>
    </div>

    <!-- Main Feed (Single Centered Column like Facebook) -->
    <div class="max-w-4xl mx-auto space-y-4">
        @if (!Model.Notifications.Any())
        {
            <div class="bg-white rounded-3xl p-16 text-center border border-slate-200 space-y-3">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto text-slate-400 text-2xl">
                    <i class="bi bi-bell-slash"></i>
                </div>
                <h4 class="text-base font-bold text-slate-800">No Notifications</h4>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">
                    You're all caught up! When new Islamic events, donation receipts, or program updates happen, they will appear here.
                </p>
            </div>
        }
        else
        {
            @foreach (var notif in Model.Notifications)
            {
                var iconClass = notif.Category switch
                {
                    "prayer" => "bi-clock-fill text-emerald-600 bg-emerald-50 border-emerald-200",
                    "fasting" => "bi-brightness-high-fill text-amber-600 bg-amber-50 border-amber-200",
                    "event" => "bi-moon-stars-fill text-purple-600 bg-purple-50 border-purple-200",
                    "activity" => "bi-calendar-event-fill text-blue-600 bg-blue-50 border-blue-200",
                    "donation" => "bi-heart-fill text-rose-600 bg-rose-50 border-rose-200",
                    _ => "bi-bell-fill text-emerald-600 bg-emerald-50 border-emerald-200"
                };

                var iconName = notif.Category switch
                {
                    "prayer" => "bi-clock-fill",
                    "fasting" => "bi-brightness-high-fill",
                    "event" => "bi-moon-stars-fill",
                    "activity" => "bi-calendar-event-fill",
                    "donation" => "bi-heart-fill",
                    _ => "bi-bell-fill"
                };

                <div id="notif-card-@notif.Id" class="bg-white rounded-2xl p-4 sm:p-5 border @(notif.IsRead ? "border-slate-200/80 bg-white" : "border-emerald-300 bg-emerald-50/20 shadow-xs") flex items-start justify-between gap-4 transition-all hover:border-slate-300">
                    <div class="flex items-start gap-4">
                        <div class="w-11 h-11 rounded-2xl border flex items-center justify-center text-lg shrink-0 @iconClass">
                            <i class="bi @iconName"></i>
                        </div>
                        <div class="space-y-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h4 class="text-sm font-extrabold text-slate-900">@notif.Title</h4>
                                @if (!notif.IsRead)
                                {
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    <span class="px-2 py-0.5 text-[9px] font-black rounded-full uppercase bg-emerald-100 text-emerald-800">New</span>
                                }
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">@notif.Message</p>
                            <div class="flex items-center gap-3 pt-1 text-[11px] text-slate-400">
                                <span><i class="bi bi-clock me-1"></i>@notif.CreatedAt.ToString("MMM dd, yyyy • hh:mm tt")</span>
                                @if (!string.IsNullOrEmpty(notif.LinkUrl))
                                {
                                    <a href="@notif.LinkUrl" class="font-bold text-emerald-700 hover:text-emerald-800">View &rarr;</a>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-1 shrink-0">
                        @if (!notif.IsRead)
                        {
                            <button type="button" onclick="markAsRead(@notif.Id)" class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-emerald-700 rounded-xl hover:bg-emerald-50 border border-slate-200 transition flex items-center gap-1">
                                <i class="bi bi-check-lg"></i>
                                <span>Mark read</span>
                            </button>
                        }
                        <button type="button" onclick="deleteNotification(@notif.Id)" class="p-1.5 text-slate-400 hover:text-red-600 rounded-xl hover:bg-red-50 transition" title="Delete notification">
                            <i class="bi bi-trash3 text-sm"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    async function markAsRead(id) {
        try {
            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('id', id);
            formData.append('__RequestVerificationToken', token);

            const res = await fetch(`/Notifications/MarkRead?id=${id}`, {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                const card = document.getElementById(`notif-card-${id}`);
                if (card) {
                    card.classList.remove('border-emerald-300', 'bg-emerald-50/20');
                    card.classList.add('border-slate-200/80');
                    const dot = card.querySelector('.bg-emerald-500');
                    if (dot) dot.remove();
                    const newBadge = card.querySelector('.bg-emerald-100');
                    if (newBadge) newBadge.remove();
                    const btn = card.querySelector('button');
                    if (btn) btn.remove();
                }

                // Update navbar bell badge
                const badge = document.getElementById('navNotifBadge');
                if (badge) {
                    if (data.unreadCount > 0) {
                        badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;
                    } else {
                        badge.classList.add('hidden');
                    }
                }
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function deleteNotification(id) {
        try {
            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('id', id);
            formData.append('__RequestVerificationToken', token);

            const res = await fetch(`/Notifications/Delete?id=${id}`, {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                const card = document.getElementById(`notif-card-${id}`);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    setTimeout(() => card.remove(), 250);
                }

                const badge = document.getElementById('navNotifBadge');
                if (badge) {
                    if (data.unreadCount > 0) {
                        badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;
                    } else {
                        badge.classList.add('hidden');
                    }
                }
            }
        } catch (e) {
            console.error(e);
        }
    }
</script>
}
