@model AdDiin.Models.ViewModels.DonationSuccessViewModel
@{
    ViewData["Title"] = "Donation Successful";
}

<div class="container my-5 text-center">
    <div class="card card-custom p-5 border-0 shadow-lg rounded-4 max-w-700 mx-auto bg-white">
        <div class="w-80 h-80 bg-emerald-light text-emerald rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 fs-1 shadow-sm" style="width: 80px; height: 80px;">
            <i class="bi bi-check-lg"></i>
        </div>

        <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill fw-bold mb-2">PAYMENT COMPLETED</span>
        <h2 class="fw-extrabold text-dark mb-1">JazakAllah Khair for Your Donation!</h2>
        <p class="text-muted small mb-4">May Allah (SWT) accept your charity, bless your wealth, and grant you immense reward in both worlds.</p>

        <!-- Receipt Card -->
        <div class="p-4 bg-light rounded-4 text-start border mb-4">
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted small">Transaction ID (Token):</span>
                <strong class="font-monospace text-emerald">@Model.TranId</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted small">Donation Category:</span>
                <strong class="text-dark">@Model.CategoryName</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted small">Amount Donated:</span>
                <strong class="text-emerald fs-5">৳ @Model.Amount.ToString("N2") BDT</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted small">Donor Name:</span>
                <strong class="text-dark">@Model.DonorName</strong>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted small">Date & Time:</span>
                <span class="text-muted">@Model.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a asp-action="Receipt" asp-route-tranId="@Model.TranId" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold" target="_blank">
                <i class="bi bi-printer me-1"></i> Print Official Receipt
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="MyDonations" class="btn btn-emerald-gradient px-4 py-2 rounded-pill fw-semibold">
                    <i class="bi bi-wallet2 me-1"></i> View My Donation History
                </a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill">
                Back to Home
            </a>
        </div>
    </div>
</div>