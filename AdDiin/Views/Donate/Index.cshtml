@model AdDiin.Models.ViewModels.DonationInitiateViewModel
@{
    ViewData["Title"] = "Verified Charity & Donations | ADDiin";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="bg-gradient-to-r from-emerald-950 via-teal-900 to-slate-900 rounded-3xl p-8 sm:p-10 text-white shadow-xl text-center space-y-3">
        <span class="px-3.5 py-1 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold rounded-full uppercase tracking-wider">
            Verified Humanitarian Giving
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Channel Your Sadaqah & Zakat</h1>
        <p class="text-slate-300 text-xs sm:text-sm max-w-xl mx-auto leading-relaxed">
            100% transparent digital giving. Automatic digital receipt generated instantly with transaction verification.
        </p>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
        <form asp-controller="Donate" asp-action="ProcessDonation" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            
            <!-- Category Selection -->
            <div>
                <label class="text-xs font-bold text-slate-700 uppercase">Select Charity Cause</label>
                <select name="Category" class="mt-1 w-full text-xs font-bold bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-3">
                    <option value="zakat" selected="@(Model.Category == "zakat")">Zakat Fund (Destitute & Debt Relief)</option>
                    <option value="orphan" selected="@(Model.Category == "orphan")">Orphan Care & Student Sponsorship</option>
                    <option value="sitarto" selected="@(Model.Category == "sitarto")">Winter Warmth & Blanket Distribution</option>
                    <option value="iftar" selected="@(Model.Category == "iftar")">Ramadan Food Packs & Iftar</option>
                    <option value="durjog" selected="@(Model.Category == "durjog")">Emergency Disaster & Flood Relief</option>
                    <option value="general" selected="@(Model.Category == "general")">General Sadaqah & Islamic Education</option>
                </select>
            </div>

            <!-- Amount Presets -->
            <div>
                <label class="text-xs font-bold text-slate-700 uppercase">Donation Amount (BDT)</label>
                <div class="grid grid-cols-4 gap-2.5 my-2">
                    <button type="button" onclick="setAmount(500)" class="py-2.5 bg-slate-100 hover:bg-emerald-50 hover:border-emerald-400 border border-slate-200 text-xs font-bold rounded-xl transition">৳500</button>
                    <button type="button" onclick="setAmount(1000)" class="py-2.5 bg-slate-100 hover:bg-emerald-50 hover:border-emerald-400 border border-slate-200 text-xs font-bold rounded-xl transition">৳1,000</button>
                    <button type="button" onclick="setAmount(5000)" class="py-2.5 bg-slate-100 hover:bg-emerald-50 hover:border-emerald-400 border border-slate-200 text-xs font-bold rounded-xl transition">৳5,000</button>
                    <button type="button" onclick="setAmount(10000)" class="py-2.5 bg-slate-100 hover:bg-emerald-50 hover:border-emerald-400 border border-slate-200 text-xs font-bold rounded-xl transition">৳10,000</button>
                </div>
                <input type="number" id="donationAmountInput" name="Amount" value="@Model.Amount" min="10" required class="w-full text-base font-black px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl font-mono" placeholder="Custom Amount in BDT" />
            </div>

            <!-- Donor Details -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div>
                    <label class="text-xs font-bold text-slate-700">Donor Name</label>
                    <input type="text" name="Name" value="@Model.Name" required class="mt-1 w-full text-xs font-semibold px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-700">Email Address (for Receipt)</label>
                    <input type="email" name="Email" value="@Model.Email" required class="mt-1 w-full text-xs font-semibold px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-700">Phone Number</label>
                    <input type="tel" name="Phone" value="@Model.Phone" required class="mt-1 w-full text-xs font-semibold px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-700">Payment Gateway</label>
                    <select name="PaymentMethod" class="mt-1 w-full text-xs font-bold bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5">
                        <option value="bkash">bKash Online</option>
                        <option value="nagad">Nagad Direct</option>
                        <option value="rocket">Rocket</option>
                        <option value="card">Visa / Mastercard / Amex</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input type="checkbox" name="IsAnonymous" value="true" id="anonChk" class="w-4 h-4 accent-emerald-600 rounded" />
                <label for="anonChk" class="text-xs text-slate-600">Make this donation anonymous (Hide name on public donor list)</label>
            </div>

            <button type="submit" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm rounded-2xl shadow-lg shadow-emerald-900/30 transition">
                Proceed to Secure Donation (SSLCommerz)
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function setAmount(val) {
        document.getElementById('donationAmountInput').value = val;
    }
</script>
}
