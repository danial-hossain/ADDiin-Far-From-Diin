@using Microsoft.AspNetCore.Identity
@using AdDiin.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isAdmin = User.IsInRole("Admin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ad-Diin | Smart Mosque Management Platform</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        emerald: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            200: '#a7f3d0',
                            300: '#6ee7b7',
                            400: '#34d399',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                            950: '#022c22',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                        arabic: ['Amiri', 'serif']
                    }
                }
            }
        }
    </script>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans antialiased">
    <!-- Header / Navbar (Matching original React Header.tsx) -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <!-- Logo & Brand -->
                <a href="/" class="flex items-center gap-3 group text-decoration-none">
                    <div class="w-11 h-11 bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-xl flex items-center justify-center text-white text-2xl shadow-md group-hover:scale-105 transition-transform duration-200">
                        <span>🕌</span>
                    </div>
                    <div>
                        <div class="flex items-baseline gap-1.5">
                            <span class="text-2xl font-extrabold text-slate-900 tracking-tight">Ad-Diin</span>
                            <span class="text-xl font-bold font-arabic text-amber-500">الدين</span>
                        </div>
                        <p class="text-[10px] text-slate-500 tracking-wider uppercase font-semibold">Smart Mosque Platform</p>
                    </div>
                </a>

                <!-- Desktop Navigation -->
                <nav class="hidden lg:flex items-center gap-1">
                    <a href="/" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">Home</a>
                    <a href="/prayer-times" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">Prayer Times</a>
                    <a href="/events" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">Events</a>
                    <a href="/activities" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">Activities</a>
                    <a href="/zakat" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">Zakat</a>
                    <a href="/diin-ai" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors flex items-center gap-1">
                        <span class="px-1.5 py-0.5 text-[10px] font-bold bg-emerald-100 text-emerald-800 rounded-full">AI</span> Diin AI
                    </a>
                    <a href="/milad" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">Milad Booking</a>
                    <a href="/about" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">About</a>
                    <a href="/contact" class="px-3 py-2 text-sm font-medium rounded-lg text-slate-700 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors">Contact</a>
                </nav>

                <!-- Actions / Auth -->
                <div class="flex items-center gap-3">
                    <!-- Quick Donate Button -->
                    <a href="/donate" class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-semibold text-sm px-4 py-2.5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
                        <i class="bi bi-heart-fill text-amber-300"></i>
                        <span>Donate</span>
                    </a>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <!-- User Dropdown Menu -->
                        <div class="relative group">
                            <button type="button" class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 px-3 py-2 rounded-xl text-sm font-semibold text-slate-800 transition">
                                <div class="w-8 h-8 rounded-full bg-emerald-700 text-white flex items-center justify-center font-bold text-xs">
                                    @(currentUser?.FullName?.FirstOrDefault() ?? 'U')
                                </div>
                                <span class="hidden md:inline">@(currentUser?.FullName?.Split(' ').FirstOrDefault() ?? "Account")</span>
                                <i class="bi bi-chevron-down text-xs text-slate-500"></i>
                            </button>

                            <!-- Dropdown Box -->
                            <div class="absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 hidden group-hover:block transition-all">
                                <div class="px-4 py-2.5 border-b border-slate-100">
                                    <p class="text-sm font-bold text-slate-900 truncate">@currentUser?.FullName</p>
                                    <p class="text-xs text-slate-500 truncate">@currentUser?.Email</p>
                                    @if (isAdmin)
                                    {
                                        <span class="inline-block mt-1 px-2 py-0.5 bg-red-100 text-red-700 text-[10px] font-bold rounded-full">Administrator</span>
                                    }
                                </div>

                                @if (isAdmin)
                                {
                                    <a href="/admin/panel" class="flex items-center gap-2.5 px-4 py-2 text-sm text-red-600 font-semibold hover:bg-red-50">
                                        <i class="bi bi-speedometer2"></i> Admin Panel
                                    </a>
                                    <div class="my-1 border-t border-slate-100"></div>
                                }

                                <a href="/user-profile" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700">
                                    <i class="bi bi-person text-emerald-600"></i> My Profile
                                </a>
                                <a href="/my-donations" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700">
                                    <i class="bi bi-wallet2 text-emerald-600"></i> My Donations
                                </a>
                                <a href="/my-milad-requests" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700">
                                    <i class="bi bi-calendar-check text-emerald-600"></i> My Milad Requests
                                </a>
                                <a href="/messaging" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700">
                                    <i class="bi bi-chat-dots text-emerald-600"></i> Support Messages
                                </a>

                                <div class="my-1 border-t border-slate-100"></div>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w-full text-left flex items-center gap-2.5 px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Auth buttons -->
                        <div class="flex items-center gap-2">
                            <a href="/user-login" class="text-sm font-semibold text-slate-700 hover:text-emerald-700 px-3 py-2 rounded-lg hover:bg-slate-100 transition">
                                Login
                            </a>
                            <a href="/user-registration" class="hidden sm:inline-block text-sm font-semibold text-emerald-700 border border-emerald-600 hover:bg-emerald-50 px-3.5 py-2 rounded-xl transition">
                                Register
                            </a>
                        </div>
                    }

                    <!-- Mobile Menu Button -->
                    <button type="button" id="mobileMenuBtn" class="lg:hidden p-2 text-slate-700 hover:bg-slate-100 rounded-lg">
                        <i class="bi bi-list text-2xl"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Dropdown Navigation -->
            <div id="mobileMenu" class="hidden lg:hidden border-t border-slate-200 py-3 space-y-1">
                <a href="/" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Home</a>
                <a href="/prayer-times" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Prayer Times</a>
                <a href="/events" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Events</a>
                <a href="/activities" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Activities</a>
                <a href="/zakat" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Zakat Calculator</a>
                <a href="/diin-ai" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Diin AI Assistant</a>
                <a href="/milad" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Milad Booking</a>
                <a href="/about" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">About Us</a>
                <a href="/contact" class="block px-3 py-2 text-base font-medium rounded-lg text-slate-700 hover:bg-emerald-50">Contact</a>
            </div>
        </div>
    </header>

    <!-- Main Body -->
    <main class="flex-1">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <partial name="_NotificationToast" />
        </div>
        @RenderBody()
    </main>

    <!-- Footer (Matching original React Footer.tsx) -->
    <footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
                <!-- Col 1: Brand & Purpose -->
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center text-white text-xl">
                            <span>🕌</span>
                        </div>
                        <div>
                            <span class="text-xl font-bold text-white">Ad-Diin</span>
                            <p class="text-xs text-emerald-400 font-semibold">Smart Mosque Platform</p>
                        </div>
                    </div>
                    <p class="text-sm text-slate-400 leading-relaxed">
                        A centralized platform for mosque daily operations, transparent community donations, verified Zakat calculation, and authentic Islamic learning.
                    </p>
                    <div class="p-3 bg-slate-800/60 rounded-xl border border-slate-700/50">
                        <div class="flex items-center gap-2 text-xs font-bold text-amber-400 mb-1">
                            <i class="bi bi-award-fill"></i>
                        </div>
                        <p class="text-[11px] text-slate-400">
                            Empowering religious institutions through modern digital public infrastructure and financial transparency.
                        </p>
                    </div>
                </div>

                <!-- Col 2: Quick Links -->
                <div>
                    <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Quick Links</h4>
                    <ul class="space-y-2.5 text-sm">
                        <li><a href="/" class="hover:text-emerald-400 transition-colors">Home</a></li>
                        <li><a href="/prayer-times" class="hover:text-emerald-400 transition-colors">Prayer Times</a></li>
                        <li><a href="/events" class="hover:text-emerald-400 transition-colors">Islamic Events</a></li>
                        <li><a href="/activities" class="hover:text-emerald-400 transition-colors">Ongoing Activities</a></li>
                        <li><a href="/zakat" class="hover:text-emerald-400 transition-colors">Zakat Calculator</a></li>
                        <li><a href="/diin-ai" class="hover:text-emerald-400 transition-colors">Diin AI Assistant</a></li>
                    </ul>
                </div>

                <!-- Col 3: Community Services -->
                <div>
                    <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Services & Welfare</h4>
                    <ul class="space-y-2.5 text-sm">
                        <li><a href="/donate?category=zakat" class="hover:text-emerald-400 transition-colors">Zakat Fund</a></li>
                        <li><a href="/donate?category=iftar" class="hover:text-emerald-400 transition-colors">Ramadan Iftar Drive</a></li>
                        <li><a href="/donate?category=durjog" class="hover:text-emerald-400 transition-colors">Disaster Relief Fund</a></li>
                        <li><a href="/donate?category=sitarto" class="hover:text-emerald-400 transition-colors">Winter Clothes Campaign</a></li>
                        <li><a href="/milad" class="hover:text-emerald-400 transition-colors">Milad & Dua Mehfil</a></li>
                        <li><a href="/sdg9" class="hover:text-emerald-400 transition-colors">SDG 9 Innovation Report</a></li>
                    </ul>
                </div>

                <!-- Col 4: Mosque Contact -->
                <div>
                    <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Mosque Complex</h4>
                    <ul class="space-y-3 text-sm text-slate-400">
                        <li class="flex items-start gap-2.5">
                            <i class="bi bi-geo-alt-fill text-emerald-400 mt-1"></i>
                            <span>Tejgaon / Dhanmondi Central Mosque Complex, Dhaka-1208, Bangladesh</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <i class="bi bi-telephone-fill text-emerald-400"></i>
                            <span>+880 1700-000000 / +880 1811-111111</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <i class="bi bi-envelope-fill text-emerald-400"></i>
                            <span>info@addiin.com</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-slate-800 mt-12 pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
                <p>&copy; @DateTime.UtcNow.Year Ad-Diin Platform. All rights reserved.</p>
                <div class="flex gap-6">
                    <a href="/privacy" class="hover:text-slate-400 transition">Privacy Policy</a>
                    <a href="/contact" class="hover:text-slate-400 transition">Support</a>
                    <a href="/sdg9" class="hover:text-slate-400 transition">SDG 9 Alignment</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        document.getElementById('mobileMenuBtn')?.addEventListener('click', function() {
            document.getElementById('mobileMenu')?.classList.toggle('hidden');
        });
    </script>
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>