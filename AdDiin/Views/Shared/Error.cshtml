@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container my-5 text-center">
    <div class="card card-custom p-5 border rounded-4 bg-white shadow-sm max-w-600 mx-auto">
        <div class="text-danger display-1 mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h2 class="fw-bold text-dark">An Error Occurred</h2>
        <p class="text-muted mb-4">We encountered an issue processing your request. Please try again or contact administration.</p>
        
        @if (Model.ShowRequestId)
        {
            <div class="bg-light p-3 rounded mb-4 text-muted small font-monospace">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </div>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-emerald-gradient px-4 py-2 rounded-pill fw-bold">
            <i class="bi bi-house-door me-1"></i> Return to Homepage
        </a>
    </div>
</div>