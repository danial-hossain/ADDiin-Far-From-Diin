@using Microsoft.AspNetCore.Identity
@using AdDiin.Models.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var adminUser = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ad-Diin Admin Management Portal</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light admin-body">
    <div class="admin-wrapper d-flex">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar bg-dark text-white d-flex flex-column" id="adminSidebar">
            <div class="admin-sidebar-header p-3 border-bottom border-secondary d-flex align-items-center justify-content-between">
                <a asp-controller="Admin" asp-action="Dashboard" class="text-white text-decoration-none d-flex align-items-center gap-2">
                    <div class="brand-logo-icon bg-emerald text-white p-1 rounded">
                        <span>🕌</span>
                    </div>
                    <div>
                        <div class="fw-bold fs-5">Ad-Diin</div>
                        <div class="small text-emerald-light" style="font-size: 0.7rem;">Admin Management</div>
                    </div>
                </a>
                <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggleClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Admin Navigation Links -->
            <nav class="admin-nav flex-grow-1 p-3 overflow-y-auto">
                <div class="text-uppercase text-secondary fw-bold small mb-2 px-2" style="font-size: 0.7rem;">Main Menu</div>
                
                <a asp-controller="Admin" asp-action="Dashboard" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a asp-controller="Admin" asp-action="Users" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                    <i class="bi bi-people"></i> Users Management
                </a>
                <a asp-controller="Admin" asp-action="PrayerTimes" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PrayerTimes" ? "active" : "")">
                    <i class="bi bi-clock-history"></i> Prayer Times
                </a>
                <a asp-controller="Admin" asp-action="Events" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Events" ? "active" : "")">
                    <i class="bi bi-calendar3"></i> Islamic Events
                </a>
                <a asp-controller="Admin" asp-action="Milads" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Milads" ? "active" : "")">
                    <i class="bi bi-bookmark-star"></i> Milad Bookings
                </a>
                <a asp-controller="Admin" asp-action="Donations" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Donations" ? "active" : "")">
                    <i class="bi bi-cash-stack"></i> Donations & Zakat
                </a>
                <a asp-controller="Admin" asp-action="Activities" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Activities" ? "active" : "")">
                    <i class="bi bi-images"></i> Activities
                </a>
                <a asp-controller="Admin" asp-action="Messages" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Messages" ? "active" : "")">
                    <i class="bi bi-chat-left-text"></i> Messages & Support
                </a>
                <a asp-controller="Admin" asp-action="Contact" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")">
                    <i class="bi bi-envelope-open"></i> Contact Inquiries
                </a>
                <a asp-controller="Admin" asp-action="About" class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")">
                    <i class="bi bi-info-square"></i> About Content
                </a>

                <div class="text-uppercase text-secondary fw-bold small mt-4 mb-2 px-2" style="font-size: 0.7rem;">Quick Links</div>
                <a asp-controller="Home" asp-action="Index" class="admin-nav-link" target="_blank">
                    <i class="bi bi-box-arrow-up-right"></i> View Public Site
                </a>
            </nav>

            <!-- Admin Profile Footer -->
            <div class="admin-sidebar-footer p-3 border-top border-secondary bg-black bg-opacity-25">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 text-truncate">
                        <div class="avatar-circle-sm bg-emerald text-white fw-bold">
                            @(adminUser?.FullName?.FirstOrDefault() ?? 'A')
                        </div>
                        <div class="text-truncate">
                            <div class="fw-bold small text-white text-truncate">@adminUser?.FullName</div>
                            <div class="text-secondary small text-truncate" style="font-size: 0.75rem;">@adminUser?.Email</div>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger p-0" title="Logout">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-main flex-grow-1 d-flex flex-column min-vh-100">
            <!-- Top Admin Header Bar -->
            <header class="bg-white border-bottom shadow-sm px-4 py-3 sticky-top">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary btn-sm d-lg-none" id="sidebarToggleOpen">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-emerald btn-sm rounded-pill px-3">
                            <i class="bi bi-globe me-1"></i> Public Website
                        </a>
                        <span class="badge bg-emerald-light text-emerald px-3 py-2 rounded-pill">
                            <i class="bi bi-shield-lock-fill me-1"></i> Admin Session
                        </span>
                    </div>
                </div>
            </header>

            <!-- Body -->
            <main class="admin-content p-4 flex-grow-1">
                <partial name="_NotificationToast" />
                @RenderBody()
            </main>

            <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
                &copy; @DateTime.UtcNow.Year Ad-Diin Smart Mosque Management System • AUST CSE 3200 Software Development-V
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5.3.3 JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sidebarToggleOpen')?.addEventListener('click', function() {
            document.getElementById('adminSidebar')?.classList.add('show');
        });
        document.getElementById('sidebarToggleClose')?.addEventListener('click', function() {
            document.getElementById('adminSidebar')?.classList.remove('show');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
