@model AdDiin.Models.Entities.IslamicEvent
@{
    ViewData["Title"] = Model.EventName;
}

<div class="container my-5">
    <div class="card card-custom p-5 border rounded-4 bg-white shadow-sm max-w-700 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="badge bg-emerald-light text-emerald px-3 py-2 rounded-pill text-uppercase">@Model.EventType</span>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-arrow-left"></i> Back to Events</a>
        </div>

        <h2 class="fw-bold text-dark mb-2">@Model.EventName</h2>
        <div class="text-muted mb-4 d-flex gap-3 small">
            <span><i class="bi bi-moon-stars text-warning me-1"></i> @Model.HijriDate</span>
            <span>•</span>
            <span><i class="bi bi-calendar3 me-1 text-emerald"></i> @Model.EventDate.ToString("dddd, MMMM dd, yyyy")</span>
        </div>

        <hr class="my-3" />

        <div class="my-4">
            <h5 class="fw-bold">Significance & Details:</h5>
            <p class="text-muted leading-relaxed">
                @Model.Description
            </p>
        </div>

        <div class="p-4 bg-light rounded-4 text-center mt-4 border">
            <h6 class="fw-bold mb-2">Mosque Congregation & Programs</h6>
            <p class="text-muted small mb-3">Special Bayan, Dua Mehfil, and community dinners will be organized on this occasion.</p>
            <a asp-controller="Milad" asp-action="Create" class="btn btn-emerald-gradient btn-sm px-4 py-2 rounded-pill fw-bold">
                Book a Dua on this blessed day
            </a>
        </div>
    </div>
</div>