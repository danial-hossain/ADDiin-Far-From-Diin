@model IEnumerable<AdDiin.Models.Entities.ProgramRegistration>
@{
    ViewData["Title"] = "My Registered Activities | ADDiin";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl shadow-xs">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900">My Registered Activities & Programs</h1>
                <p class="text-xs text-slate-500">Track your registration status, upcoming programs, and attendance history</p>
            </div>
        </div>
        <a href="/activities" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs transition">
            Explore More Programs
        </a>
    </div>

    <div class="space-y-4">
        @if (Model.Any())
        {
            @foreach (var reg in Model)
            {
                <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 hover:shadow-md transition-shadow flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center text-2xl">
                            🕌
                        </div>
                        <div class="space-y-1">
                            <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-md uppercase">
                                @reg.Activity.Category
                            </span>
                            <h3 class="font-bold text-slate-900 text-base">@reg.Activity.Title</h3>
                            <div class="flex flex-wrap gap-4 text-xs text-slate-500 pt-1">
                                <span><i class="bi bi-calendar-event text-emerald-600"></i> @(reg.Activity.ProgramDate?.ToString("MMM dd, yyyy") ?? "TBA")</span>
                                <span><i class="bi bi-clock text-emerald-600"></i> @reg.Activity.StartTime</span>
                                <span><i class="bi bi-geo-alt text-emerald-600"></i> @reg.Activity.Location</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col md:items-end gap-2 w-full md:w-auto">
                        <div class="flex items-center gap-2">
                            @if (reg.Status == "Approved")
                            {
                                <span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-black rounded-full">
                                    Approved
                                </span>
                            }
                            else if (reg.Status == "Pending")
                            {
                                <span class="px-3 py-1 bg-amber-100 text-amber-800 text-xs font-black rounded-full">
                                    Pending Review
                                </span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-red-100 text-red-800 text-xs font-black rounded-full">
                                    Rejected
                                </span>
                            }
                        </div>
                        <a href="/activities/@reg.ActivityId" class="text-xs font-bold text-slate-700 hover:text-emerald-700">
                            View Program Details &rarr;
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="p-16 text-center bg-white rounded-3xl border border-slate-200 space-y-3">
                <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto">
                    <i class="bi bi-calendar-plus"></i>
                </div>
                <h3 class="font-bold text-slate-800 text-base">No Program Registrations Yet</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">Explore upcoming Waz Mahfils, Seminars, and Competitions to register.</p>
                <a href="/activities" class="inline-block mt-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs transition">
                    Browse Islamic Programs
                </a>
            </div>
        }
    </div>
</div>
