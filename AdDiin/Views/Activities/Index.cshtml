@model List<AdDiin.Models.Entities.Activity>
@{
    ViewData["Title"] = "Ongoing Activities & Programs";
}

<div class="bg-emerald-dark text-white py-5">
    <div class="container text-center py-3">
        <h1 class="display-5 fw-extrabold mb-2">🕌 Mosque Activities & Programs</h1>
        <p class="text-white-75 max-w-700 mx-auto">
            Discover our active educational courses, charity initiatives, youth empowerment drives, and environmental programs.
        </p>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-grid display-3 mb-2"></i>
                <p>No activities listed currently.</p>
            </div>
        }
        else
        {
            @foreach (var act in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card card-custom h-100 border-0 shadow-sm overflow-hidden rounded-4 d-flex flex-column">
                        @if (!string.IsNullOrEmpty(act.ImageUrl))
                        {
                            <img src="@act.ImageUrl" class="card-img-top" alt="@act.Title" style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-emerald-light d-flex align-items-center justify-content-center" style="height: 220px;">
                                <span class="fs-1">🕌</span>
                            </div>
                        }
                        <div class="card-body p-4 d-flex flex-column">
                            <span class="badge bg-emerald-light text-emerald align-self-start mb-2 text-uppercase">@act.Category</span>
                            <h5 class="card-title fw-bold">@act.Title</h5>
                            <p class="card-text text-muted small leading-relaxed flex-grow-1">
                                @act.Description
                            </p>
                            <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                                <a asp-action="Details" asp-route-id="@act.Id" class="btn btn-outline-emerald btn-sm rounded-pill px-3">
                                    Read Full Details <i class="bi bi-arrow-right"></i>
                                </a>
                                <a asp-controller="Donate" asp-action="Index" class="btn btn-warning text-dark btn-sm rounded-pill px-3 fw-bold">
                                    Support
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>