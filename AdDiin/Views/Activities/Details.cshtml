@model AdDiin.Models.Entities.Activity
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm max-w-800 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="badge bg-emerald-light text-emerald px-3 py-2 rounded-pill text-uppercase">@Model.Category</span>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill"><i class="bi bi-arrow-left"></i> Back to Activities</a>
        </div>

        <h2 class="fw-bold text-dark mb-3">@Model.Title</h2>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded-4 mb-4 shadow-sm w-100" style="max-height: 380px; object-fit: cover;" alt="@Model.Title" />
        }

        <div class="text-muted leading-relaxed fs-6 mb-4">
            @Model.Description
        </div>

        <div class="p-4 bg-emerald-light rounded-4 border border-emerald border-opacity-25 text-center mt-4">
            <h5 class="fw-bold text-emerald-dark mb-2">Support & Participate in this Activity</h5>
            <p class="text-muted small mb-3">Your donations and voluntary participation help keep this community service thriving.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Donate" asp-action="Index" class="btn btn-emerald-gradient px-4 py-2 rounded-pill fw-bold">
                    <i class="bi bi-heart-fill me-1"></i> Donate for this Cause
                </a>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-emerald px-4 py-2 rounded-pill">
                    Volunteer
                </a>
            </div>
        </div>
    </div>
</div>