        }

        .product-analyzer-page .analysis-progress-state h2 {
            color: #e7fff4;
            font-size: clamp(1.25rem, 3vw, 1.75rem);
            font-weight: 800;
        }

        .product-analyzer-page .analysis-progress-state p {
            color: #91c5b2;
            font-size: .8rem;
        }

        .product-analyzer-page .analysis-close-button {
            width: 2.2rem;
            height: 2.2rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            border: 1px solid rgba(95, 218, 174, .28);
            border-radius: .7rem;
            color: #9ed6bd;
            background: rgba(4, 39, 29, .72);
            transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease;
        }

        .product-analyzer-page .analysis-close-button:hover {
            color: #e7fff4;
            background: rgba(25, 168, 121, .65);
            border-color: #5de4b5;
            transform: translateY(-1px);
        }

        .product-analyzer-page .pipeline-step.is-processing .step-indicator i {
            animation: analyzer-spin .9s linear infinite;
        }

        .product-analyzer-page .pipeline-step.is-processing::after {
            content: "Processing...";
            margin-left: auto;
            color: #65edbe;
            font-size: .62rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .product-analyzer-page .pipeline-step.is-pending {
            opacity: .58;
        }

        .product-analyzer-page .pipeline-step.is-pending::after {
            content: "Waiting...";
            margin-left: auto;
            color: #78a898;
            font-size: .62rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .product-analyzer-page .pipeline-step.is-failed {
            border-left-color: #fb7185 !important;
            background: rgba(127, 29, 54, .25) !important;
        }

        .product-analyzer-page .pipeline-step.is-processing {
            border-left-color: #50e0ae !important;
            background: rgba(21, 135, 96, .28) !important;
            box-shadow: 0 0 18px rgba(38, 205, 151, .12);
        }

        .product-analyzer-page .pipeline-step.is-failed::after {
            content: "Failed";
            margin-left: auto;
            color: #fda4af;
            font-size: .62rem;
            font-weight: 800;
        }

        @@keyframes analyzer-progress {
            0% { transform: translateX(-120%); }
            100% { transform: translateX(360%); }
        }

        @@keyframes analyzer-spin {
            to { transform: rotate(360deg); }
        }

        @@keyframes analyzer-reveal {
            from { opacity: 0; transform: translateY(14px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 991.98px) {
            .product-analyzer-page .workspace-grid > .lg\:col-span-7,
            .product-analyzer-page .workspace-grid > .lg\:col-span-5 {
