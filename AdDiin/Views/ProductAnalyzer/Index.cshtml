@{
    ViewData["Title"] = "AI Halal/Haram Product Analyzer | ADDiin";
}

@section Styles {
    <style>
/* The analyzer uses a dedicated visual system so OCR, pipeline, and
   decision surfaces remain readable over the shared dark site theme. */
        .ai-analyzer-bg {
            background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.08) 0%, rgba(15, 23, 42, 0.02) 50%, transparent 100%);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .glass-dark-card {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.96) 0%, rgba(6, 78, 59, 0.92) 100%);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(16, 185, 129, 0.25);
        }

        .drop-zone {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: repeating-linear-gradient(
                0deg,
                rgba(241, 245, 249, 0.5),
                rgba(241, 245, 249, 0.5) 10px,
                rgba(255, 255, 255, 0.5) 10px,
                rgba(255, 255, 255, 0.5) 20px
            );
        }

        .drop-zone.dragover {
            border-color: #10b981 !important;
            background-color: #ecfdf5 !important;
            transform: scale(1.01);
        }

        /* Scanning Animation Line */
        .scanner-container {
            position: relative;
            overflow: hidden;
        }

        .scanner-laser {
            position: absolute;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent 0%, #10b981 50%, transparent 100%);
            box-shadow: 0 0 15px 3px rgba(16, 185, 129, 0.8);
            animation: scanLine 2.2s infinite ease-in-out;
            z-index: 20;
        }

        @@keyframes scanLine {
            0% { top: 0%; opacity: 0; }
            15% { opacity: 1; }
            85% { opacity: 1; }
            100% { top: 100%; opacity: 0; }
        }

        .step-indicator {
            transition: all 0.3s ease;
        }

        /* Keep the analyzer's data surfaces readable against the shared dark theme. */
        .product-analyzer-page .glass-card {
            background: rgba(255, 255, 255, 0.88);
            border-color: rgba(226, 232, 240, 0.8);
            color: #10231f;
        }

        .product-analyzer-page .surface-cream {
            background-color: #faf7f0 !important;
            border-color: #dce9e3 !important;
            color: #10231f;
        }

        .product-analyzer-page .surface-cream .text-slate-900,
        .product-analyzer-page .surface-cream .text-slate-800,
        .product-analyzer-page .surface-cream .text-slate-700,
        .product-analyzer-page .surface-cream .text-slate-600,
        .product-analyzer-page .surface-cream .text-slate-500,
        .product-analyzer-page .surface-cream .text-slate-400,
        .product-analyzer-page .surface-cream label,
        .product-analyzer-page .surface-cream input,
        .product-analyzer-page .surface-cream select,
        .product-analyzer-page .surface-cream textarea {
            color: inherit !important;
        }

        .product-analyzer-page .surface-cream .text-slate-900 { color: #10231f !important; }
        .product-analyzer-page .surface-cream .text-slate-800 { color: #19352c !important; }
        .product-analyzer-page .surface-cream .text-slate-700 { color: #29463c !important; }
        .product-analyzer-page .surface-cream .text-slate-600 { color: #496259 !important; }
        .product-analyzer-page .surface-cream .text-slate-500 { color: #637873 !important; }
        .product-analyzer-page .surface-cream .text-slate-400 { color: #82938c !important; }

        .product-analyzer-page .pipeline-step {
            background: rgba(248, 250, 252, 0.9);
            border-color: #e2e8f0;
        }

        .product-analyzer-page .pipeline-step.is-active {
            background: #ecfdf5;
            border-color: #a7f3d0;
        }

        .product-analyzer-page .pipeline-step .text-slate-800 {
            color: #19352c !important;
        }

        .product-analyzer-page .pipeline-step .text-slate-500 {
            color: #637873 !important;
        }

        @@media (max-width: 767.98px) {
            .product-analyzer-page .pipeline-step {
                padding: .75rem;
            }
        }

        /* Product Analyzer visual system */
        .product-analyzer-page {
            --analyzer-ink: #17352b;
            --analyzer-muted: #61776e;
            --analyzer-green: #079b70;
            --analyzer-green-dark: #075844;
            --analyzer-border: #d9e8df;
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(circle at 8% 8%, rgba(31, 180, 133, .16), transparent 26rem),
                radial-gradient(circle at 92% 20%, rgba(200, 148, 50, .10), transparent 22rem),
                linear-gradient(145deg, #071f19 0%, #0c3025 48%, #102d23 100%);
            color: var(--analyzer-ink);
        }

        .product-analyzer-page::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: .22;
            background-image: radial-gradient(rgba(255,255,255,.16) 1px, transparent 1px);
            background-size: 26px 26px;
            mask-image: linear-gradient(to bottom, black, transparent 68%);
        }

        .product-analyzer-page > .max-w-7xl {
            position: relative;
            z-index: 1;
            max-width: 88rem;
        }

        .product-analyzer-page .hero-panel {
            min-height: 18rem;
            padding: clamp(1.5rem, 4vw, 3.25rem);
            background:
                linear-gradient(125deg, rgba(4, 32, 25, .97), rgba(7, 91, 67, .92) 58%, rgba(15, 118, 86, .88)),
                radial-gradient(circle at 78% 20%, rgba(255,255,255,.14), transparent 18rem);
            border: 1px solid rgba(115, 229, 185, .30);
            box-shadow: 0 24px 70px rgba(0, 0, 0, .28), inset 0 1px rgba(255,255,255,.10);
            animation: analyzer-rise .7s cubic-bezier(.2,.75,.2,1) both;
        }

        .product-analyzer-page .hero-panel h1,
        .product-analyzer-page .hero-panel p,
        .product-analyzer-page .hero-panel .text-white {
            color: #f6fbf8 !important;
        }

        .product-analyzer-page .hero-panel .text-slate-300 {
            color: #c4ddd2 !important;
        }

        .product-analyzer-page .hero-panel h1 {
            max-width: 48rem;
            font-size: clamp(2rem, 4.2vw, 4rem);
            line-height: 1.08;
            letter-spacing: -.045em;
        }

        .product-analyzer-page .hero-panel .engine-widget {
            border: 1px solid rgba(187, 244, 220, .20);
            background: rgba(0, 34, 25, .34);
            box-shadow: 0 14px 30px rgba(0,0,0,.16);
        }

        .product-analyzer-page .demo-toolbar,
        .product-analyzer-page .mode-toolbar {
            background: rgba(250, 247, 240, .97) !important;
            border: 1px solid rgba(212, 231, 220, .96) !important;
            box-shadow: 0 12px 30px rgba(0, 0, 0, .14);
            animation: analyzer-rise .7s .08s cubic-bezier(.2,.75,.2,1) both;
        }

        .product-analyzer-page .demo-toolbar {
            padding: .85rem 1.15rem;
        }

        .product-analyzer-page .demo-toolbar button {
            min-height: 2.35rem;
            box-shadow: 0 3px 8px rgba(18, 54, 42, .08);
        }

        .product-analyzer-page .mode-toolbar {
            padding: .8rem 1rem;
        }

        .product-analyzer-page .mode-toolbar > div:last-child {
            background: #e8f1eb !important;
            border-color: #d1e2d6 !important;
        }

        .product-analyzer-page .mode-toolbar button.surface-cream {
            background: #ffffff !important;
            color: var(--analyzer-ink) !important;
            border-color: #d8e8df !important;
            box-shadow: 0 5px 14px rgba(16, 52, 41, .12);
        }

        .product-analyzer-page .workspace-grid > * {
            animation: analyzer-rise .7s .16s cubic-bezier(.2,.75,.2,1) both;
        }

        .product-analyzer-page .workspace-grid > *:nth-child(2) {
            animation-delay: .24s;
        }

        .product-analyzer-page .upload-card,
        .product-analyzer-page .pipeline-card,
        .product-analyzer-page .ocr-card,
        .product-analyzer-page .info-card {
            box-shadow: 0 18px 42px rgba(0, 0, 0, .14), 0 2px 0 rgba(255,255,255,.7) inset;
        }

        .product-analyzer-page .upload-card {
            background: rgba(250, 247, 240, .98) !important;
        }

        .product-analyzer-page .upload-card .drop-zone {
            min-height: 17rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-color: #b9d8c9;
            background:
                linear-gradient(135deg, rgba(236, 253, 245, .78), rgba(255,255,255,.84)),
                repeating-linear-gradient(135deg, transparent 0 12px, rgba(7, 155, 112, .035) 12px 24px);
        }

        .product-analyzer-page .upload-card .drop-zone:hover {
            border-color: var(--analyzer-green);
            box-shadow: 0 0 0 5px rgba(7, 155, 112, .09), 0 14px 28px rgba(7, 155, 112, .10);
            transform: translateY(-2px);
        }

        .product-analyzer-page .pipeline-card {
            background: rgba(250, 247, 240, .98) !important;
        }

        .product-analyzer-page .pipeline-card .pipeline-step {
            min-height: 4.4rem;
            align-items: center;
            background: #f8fcfa;
            border-color: #d8e8df;
            box-shadow: 0 4px 12px rgba(26, 75, 57, .05);
            transition: transform .25s ease, box-shadow .25s ease, background .25s ease, border-color .25s ease;
        }

        .product-analyzer-page .pipeline-card .pipeline-step:hover {
            transform: translateX(4px);
            box-shadow: 0 8px 18px rgba(26, 75, 57, .10);
        }

        .product-analyzer-page .pipeline-card .pipeline-step.is-active {
            background: linear-gradient(100deg, #e8fbf2, #f7fffb);
            border-color: #81d7b0;
            box-shadow: 0 8px 22px rgba(7, 155, 112, .13);
        }

        .product-analyzer-page .pipeline-card .step-indicator {
            background: #ffffff;
            color: var(--analyzer-green-dark);
            border-color: #c5dfd1;
        }

        .product-analyzer-page .pipeline-card .is-active .step-indicator {
            animation: analyzer-pulse 1.8s ease-in-out infinite;
        }

        .product-analyzer-page .ocr-card,
        .product-analyzer-page .info-card {
            background: rgba(250, 247, 240, .98) !important;
        }

        .product-analyzer-page #resultsMainContainer {
            animation: analyzer-rise .7s .22s cubic-bezier(.2,.75,.2,1) both;
        }

        .product-analyzer-page #resultsMainContainer > .flex h2,
        .product-analyzer-page > .max-w-7xl > .space-y-6 > .flex h3 {
            color: #f1faf5 !important;
        }

        .product-analyzer-page #resultsMainContainer .surface-cream,
        .product-analyzer-page #historyCardsContainer .surface-cream {
            background: rgba(250, 247, 240, .98) !important;
        }

        .product-analyzer-page #historyCardsContainer > * {
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .product-analyzer-page #historyCardsContainer > *:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 28px rgba(0,0,0,.16);
        }

        @@keyframes analyzer-rise {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes analyzer-pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(7, 155, 112, .20); }
            50% { box-shadow: 0 0 0 7px rgba(7, 155, 112, 0); }
        }

        @@media (max-width: 991.98px) {
            .product-analyzer-page .hero-panel {
                min-height: auto;
            }
        }

        @@media (max-width: 767.98px) {
            .product-analyzer-page {
                padding-top: 1.1rem !important;
            }

            .product-analyzer-page .demo-toolbar,
            .product-analyzer-page .mode-toolbar {
                align-items: stretch;
            }

            .product-analyzer-page .mode-toolbar > div:last-child {
                width: 100%;
            }

            .product-analyzer-page .hero-panel h1 {
                font-size: 2.15rem;
            }

            .product-analyzer-page .hero-panel .engine-widget {
                min-width: 0;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .product-analyzer-page *,
            .product-analyzer-page *::before,
            .product-analyzer-page *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }

        /* Premium workspace refinements */
        .product-analyzer-page {
            background: #08291f;
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        .product-analyzer-page > .max-w-7xl {
            max-width: 76rem;
        }

        .product-analyzer-page .hero-panel {
            min-height: 0;
            padding: clamp(1.5rem, 3vw, 2.75rem);
            background: #0d382b;
            border: 1px solid rgba(128, 220, 183, .26);
            box-shadow: 0 20px 48px rgba(0, 0, 0, .2);
        }

        .product-analyzer-page .hero-panel h1 {
            max-width: 42rem;
            font-size: clamp(2.25rem, 4.5vw, 4.15rem);
            line-height: 1.02;
        }

        .product-analyzer-page .hero-panel h1 span {
            background: none;
            color: #54d8af;
        }

        .product-analyzer-page .hero-panel p {
            max-width: 38rem;
            color: #b9d9cd !important;
            font-size: .95rem;
        }

        .product-analyzer-page .hero-panel > div:first-child::after {
            content: "◌  OCR  ·  KB  ·  AI";
            position: absolute;
            right: 2.5rem;
            bottom: 1.5rem;
            color: rgba(164, 235, 207, .32);
            font-size: .62rem;
            font-weight: 800;
            letter-spacing: .18em;
        }

        .product-analyzer-page .engine-widget {
            min-width: 15rem;
            padding: 1rem 1.1rem;
            border-radius: 1rem;
            background: rgba(3, 27, 21, .5);
            border-color: rgba(164, 235, 207, .26);
        }

        .product-analyzer-page .engine-widget .text-xl {
            font-size: .9rem;
        }

        .product-analyzer-page .demo-toolbar,
        .product-analyzer-page .mode-toolbar {
            box-shadow: 0 8px 24px rgba(0, 0, 0, .12);
        }

        .product-analyzer-page .demo-toolbar {
            padding: .65rem .9rem;
        }

        .product-analyzer-page .demo-toolbar button {
            min-height: 2rem;
            padding: .4rem .7rem;
            border: 0;
            box-shadow: none;
            font-size: .68rem;
        }

        .product-analyzer-page .mode-toolbar {
            padding: .55rem .75rem;
            border-radius: 1rem;
        }

        .product-analyzer-page .mode-toolbar > div:last-child {
            padding: .25rem;
            border-radius: .8rem;
        }

        .product-analyzer-page .mode-toolbar button {
            min-height: 2.25rem;
            padding: .55rem 1rem;
        }

        .product-analyzer-page .workspace-grid {
            gap: 1.25rem;
            align-items: start;
        }

        .product-analyzer-page .workspace-grid > .lg\:col-span-7 {
            grid-column: span 7 / span 7;
        }

        .product-analyzer-page .workspace-grid > .lg\:col-span-5 {
            grid-column: span 5 / span 5;
        }

        .product-analyzer-page .upload-card,
        .product-analyzer-page .pipeline-card,
        .product-analyzer-page .ocr-card,
        .product-analyzer-page .info-card {
            border-radius: 1.15rem;
            box-shadow: 0 12px 28px rgba(0, 0, 0, .13);
        }

        .product-analyzer-page .upload-card,
        .product-analyzer-page .pipeline-card {
            padding: 1.25rem;
        }

        .product-analyzer-page .upload-card {
            gap: 1rem;
        }

        .product-analyzer-page .upload-card .drop-zone {
            min-height: 14rem;
            padding: 2rem;
            border-radius: 1rem;
            background: #f4fbf7;
        }

        .product-analyzer-page .upload-card .drop-zone > div:first-of-type {
            width: 3.5rem;
            height: 3.5rem;
            margin-bottom: .75rem;
            border-radius: 1rem;
            font-size: 1.4rem;
        }

        .product-analyzer-page .pipeline-card {
            padding-bottom: 1.4rem;
        }

        .product-analyzer-page .pipeline-card .pipeline-step {
            position: relative;
            min-height: 3.6rem;
            padding: .7rem .75rem;
            border: 0;
            border-left: 2px solid #d8e8df;
            border-radius: 0 .7rem .7rem 0;
            box-shadow: none;
            background: transparent;
        }

        .product-analyzer-page .pipeline-card .pipeline-step.is-active {
            border-left-color: #079b70;
            background: #e8f8f0;
            box-shadow: none;
        }

        .product-analyzer-page .pipeline-card .pipeline-step.is-complete {
            border-left-color: #7acbad;
            background: rgba(232, 248, 240, .55);
        }

        .product-analyzer-page .pipeline-card .pipeline-step:hover {
            transform: translateX(2px);
            box-shadow: none;
        }

        .product-analyzer-page .pipeline-card .step-indicator {
            width: 2rem;
            height: 2rem;
            border-radius: .7rem;
        }

        .product-analyzer-page .pipeline-card .pipeline-step:not(.is-active) .step-indicator {
            background: #f1f6f3;
        }

        .product-analyzer-page .info-card {
            padding: 1rem 1.15rem;
            background: #10352a !important;
            border-color: rgba(128, 220, 183, .22);
        }

        .product-analyzer-page .ocr-card {
            padding: 1rem 1.15rem;
        }

        .product-analyzer-page #resultsMainContainer {
            padding-top: 0;
        }

        .product-analyzer-page #masterStatusCard {
            padding: 1.5rem;
            border-radius: 1.15rem;
            box-shadow: 0 16px 36px rgba(0, 0, 0, .16);
        }

        .product-analyzer-page #masterStatusCard #statusHeading {
            font-size: clamp(1.55rem, 3vw, 2.4rem);
            letter-spacing: -.035em;
        }

        .product-analyzer-page #masterStatusCard #confidenceScoreDisplay {
            font-size: 2.25rem;
        }

        .product-analyzer-page #resultsMainContainer .surface-cream {
            border-radius: 1.15rem;
            padding: 1.25rem;
        }

        .product-analyzer-page .result-details {
            border-top: 1px solid rgba(255, 255, 255, .12);
            padding-top: .75rem;
        }

        .product-analyzer-page .result-details summary {
            cursor: pointer;
            color: #a7ead0;
            font-size: .72rem;
            font-weight: 800;
            list-style: none;
        }

        .product-analyzer-page .result-details summary::-webkit-details-marker {
            display: none;
        }

        .product-analyzer-page .result-details summary::before {
            content: "+";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.1rem;
            height: 1.1rem;
            margin-right: .45rem;
            border: 1px solid rgba(167, 234, 208, .4);
            border-radius: 50%;
        }

        .product-analyzer-page .result-details[open] summary::before {
            content: "−";
        }

        /* Neon dark theme: keep analyzer surfaces consistent with the product shell. */
        .product-analyzer-page .glass-card,
        .product-analyzer-page .surface-cream,
        .product-analyzer-page .demo-toolbar,
        .product-analyzer-page .mode-toolbar,
        .product-analyzer-page .upload-card,
        .product-analyzer-page .pipeline-card,
        .product-analyzer-page .ocr-card,
        .product-analyzer-page .info-card,
        .product-analyzer-page #resultsMainContainer .surface-cream,
        .product-analyzer-page #historyCardsContainer .surface-cream {
            background: rgba(8, 38, 30, .92) !important;
            border-color: rgba(63, 206, 157, .22) !important;
            color: #e1f6ec !important;
            box-shadow: 0 14px 34px rgba(0, 0, 0, .22), inset 0 1px rgba(141, 255, 211, .05);
        }

        .product-analyzer-page .surface-cream .text-slate-900,
        .product-analyzer-page .surface-cream .text-slate-800,
        .product-analyzer-page .surface-cream .text-slate-700,
        .product-analyzer-page .surface-cream .text-slate-600,
        .product-analyzer-page .surface-cream .text-slate-500,
        .product-analyzer-page .surface-cream .text-slate-400,
        .product-analyzer-page .surface-cream label,
        .product-analyzer-page .surface-cream h2,
        .product-analyzer-page .surface-cream h3,
        .product-analyzer-page .surface-cream h4,
        .product-analyzer-page .surface-cream p {
            color: #d5eee3 !important;
        }

        .product-analyzer-page .surface-cream .text-slate-500,
        .product-analyzer-page .surface-cream .text-slate-400 {
            color: #8eb8a9 !important;
        }

        .product-analyzer-page .demo-toolbar,
        .product-analyzer-page .mode-toolbar {
            background: rgba(7, 46, 35, .96) !important;
            border-color: rgba(60, 224, 164, .28) !important;
        }

        .product-analyzer-page .mode-toolbar > div:last-child {
            background: rgba(2, 25, 19, .72) !important;
            border-color: rgba(62, 203, 157, .24) !important;
        }

        .product-analyzer-page .mode-toolbar button.surface-cream,
        .product-analyzer-page .mode-toolbar button[class*="surface-cream"] {
            background: #18a879 !important;
            border-color: #52e0b0 !important;
            color: #031b14 !important;
            box-shadow: 0 0 18px rgba(24, 168, 121, .28);
        }

        .product-analyzer-page .mode-toolbar button:not(.surface-cream) {
            color: #a9d3c2 !important;
        }

        .product-analyzer-page .upload-card .drop-zone {
            background:
                linear-gradient(135deg, rgba(11, 65, 49, .92), rgba(4, 34, 26, .96)),
                repeating-linear-gradient(135deg, transparent 0 12px, rgba(65, 222, 167, .05) 12px 24px) !important;
            border-color: rgba(66, 215, 166, .42) !important;
        }

        .product-analyzer-page .upload-card .drop-zone h4 {
            color: #dffbef !important;
        }

        .product-analyzer-page .upload-card .drop-zone p,
        .product-analyzer-page .upload-card .text-slate-500 {
            color: #8fb9aa !important;
        }

        .product-analyzer-page .upload-card .drop-zone > div:first-of-type {
            background: rgba(39, 199, 145, .16) !important;
            color: #62e9bd !important;
            box-shadow: 0 0 24px rgba(39, 199, 145, .16);
        }

        .product-analyzer-page .pipeline-card .pipeline-step,
        .product-analyzer-page .pipeline-card .pipeline-step.is-complete {
            background: rgba(6, 54, 41, .58) !important;
            border-left-color: rgba(62, 204, 157, .28) !important;
        }

        .product-analyzer-page .pipeline-card .pipeline-step.is-active {
            background: rgba(21, 135, 96, .28) !important;
            border-left-color: #50e0ae !important;
            box-shadow: 0 0 18px rgba(38, 205, 151, .12);
