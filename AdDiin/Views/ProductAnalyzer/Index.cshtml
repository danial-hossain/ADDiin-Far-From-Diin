                rawOcr: "Ingredients: potatoes, sunflower oil, sea salt, paprika, natural aroma.",
                explanation: "No matching Haram or Mushbooh ingredient was found in the available knowledge base. Note that this knowledge base checks for known Haram/Mushbooh additives and does not grant official Halal certification.",
                ingredients: [],
                stats: { haram: 0, verify: 0, certified: "No (KB Match Check)" }
            },
            verify: {
                title: "Marshmallow Label (E471 / Emulsifiers)",
                status: "MUSHBOOH_DETECTED",
                statusHeading: "MUSHBOOH / REQUIRES VERIFICATION",
                statusSubtext: "An ingredient classified as Mushbooh was found in the available knowledge base.",
                confidence: "95.4%",
                rawOcr: "Ingredients: sugar, glucose syrup, water, E471 mono- and diglycerides, citric acid, natural flavors.",
                explanation: "E471 (Mono- and Diglycerides) is classified as Mushbooh in the available knowledge base because it may be derived from vegetable oils or animal fats. The source should be verified before making a halal determination.",
                ingredients: [
                    { 
                        name: "E471 – Mono- and Diglycerides", 
                        status: "Mushbooh (Requires Verification)", 
                        reason: "E471 may be produced from vegetable oils or animal fats. The source should be verified with the manufacturer.",
                        matchType: "EXACT",
                        ocrIngredient: "e471",
                        reference: "E-code halal/haram reference material"
                    }
                ],
                stats: { haram: 0, verify: 1, certified: "No (Requires Verification)" }
            },
            haram: {
                title: "Savory Snack Label (Pork Powder)",
                status: "HARAM_DETECTED",
                statusHeading: "HARAM DETECTED",
                statusSubtext: "An explicitly classified Haram ingredient was found in the available knowledge base.",
                confidence: "98.7%",
                rawOcr: "Ingredients: wheat flour, palm oil, pork powder, salt, flavor enhancer.",
                explanation: "The product contains pork powder, which is explicitly classified as Haram. Ingredients derived from pigs or swine are strictly prohibited in Islamic dietary law (Quran 2:173; Quran 5:3; Quran 6:145; Quran 16:115).",
                ingredients: [
                    { 
                        name: "Pork / Swine", 
                        status: "Haram", 
                        reason: "Ingredients explicitly derived from pig or swine, including pork meat and pork powder, are classified as Haram.",
                        matchType: "EXACT",
                        ocrIngredient: "pork powder",
                        reference: "Quran 2:173; Quran 5:3; Quran 6:145; Quran 16:115"
                    }
                ],
                stats: { haram: 1, verify: 0, certified: "No (Haram Detected)" }
            }
        };

        let currentActiveDataset = samplePresets.verify;
        let activeInputMode = 'image';

        // Safe Element Getters
        function getEl(id) { return document.getElementById(id); }

        // Mode Switcher - Exposed globally
        window.switchAnalysisMode = function(mode) {
            activeInputMode = mode;
            const tabImg = getEl('tabModeImage');
            const tabTxt = getEl('tabModeText');
            const imgCard = getEl('imageModeCard');
            const txtCard = getEl('textModeCard');
            const ocrHead = getEl('ocrSectionHeading');
            const ocrSub = getEl('ocrSectionSubtext');
            const manIn = getEl('manualIngredientsInput');

            if (mode === 'image') {
                if (tabImg) {
                    tabImg.className = 'flex-1 sm:flex-initial py-2.5 px-6 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 bg-white text-slate-900 shadow-sm border border-slate-200/60';
                }
                if (tabTxt) {
                    tabTxt.className = 'flex-1 sm:flex-initial py-2.5 px-6 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 text-slate-600 hover:text-slate-900';
                }
                if (imgCard) imgCard.classList.remove('hidden');
                if (txtCard) txtCard.classList.add('hidden');
                if (ocrHead) ocrHead.textContent = 'View Extracted Label Text (OCR)';
                if (ocrSub) ocrSub.textContent = 'Raw text parsed from product label image via EasyOCR';
            } else {
                if (tabTxt) {
                    tabTxt.className = 'flex-1 sm:flex-initial py-2.5 px-6 rounded-xl text-xs font-black transition-all flex items-center justify-center gap-2 bg-white text-slate-900 shadow-sm border border-slate-200/60';
                }
                if (tabImg) {
                    tabImg.className = 'flex-1 sm:flex-initial py-2.5 px-6 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 text-slate-600 hover:text-slate-900';
                }
                if (txtCard) txtCard.classList.remove('hidden');
                if (imgCard) imgCard.classList.add('hidden');
                if (ocrHead) ocrHead.textContent = 'View Inputted Ingredients Text';
                if (ocrSub) ocrSub.textContent = 'Ingredients text submitted for ChromaDB and Decision Engine verification';
                setTimeout(() => {
                    if (manIn) manIn.focus();
                }, 100);
            }
        };

        window.triggerFileInput = function(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const input = getEl('productImageInput');
            if (input) input.click();
        };

        window.clearManualText = function() {
            const manIn = getEl('manualIngredientsInput');
            const charDisp = getEl('charCountDisplay');
            if (manIn) {
                manIn.value = '';
                if (charDisp) charDisp.textContent = '0 characters';
            }
        };

        function setupEventListeners() {
            const dropZone = getEl('dropZoneContainer');
            const fileInput = getEl('productImageInput');
            const manualInput = getEl('manualIngredientsInput');
            const charCountDisplay = getEl('charCountDisplay');

            if (manualInput && charCountDisplay) {
                manualInput.addEventListener('input', () => {
                    const len = manualInput.value.length;
                    charCountDisplay.textContent = `${len} character${len === 1 ? '' : 's'}`;
                });
            }

            if (dropZone) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    dropZone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZone.classList.add('dragover');
                    });
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropZone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZone.classList.remove('dragover');
                    });
                });

                dropZone.addEventListener('drop', (e) => {
                    const files = e.dataTransfer.files;
                    if (files && files.length > 0) {
                        handleFileSelect(files[0]);
                    }
                });
            }

            if (fileInput) {
                fileInput.addEventListener('change', (e) => {
                    if (e.target.files && e.target.files.length > 0) {
                        handleFileSelect(e.target.files[0]);
                    }
                });
            }
        }

        let selectedFile = null;

        function handleFileSelect(file) {
            if (!file || !file.type.match('image.*')) {
                alert('Please upload a valid image file (JPG, PNG, WEBP).');
                return;
            }

            selectedFile = file;
            const reader = new FileReader();
            reader.onload = function(e) {
                const previewImg = getEl('previewImg');
                const dropZone = getEl('dropZoneContainer');
                const previewContainer = getEl('imagePreviewContainer');
                if (previewImg) previewImg.src = e.target.result;
                if (dropZone) dropZone.classList.add('hidden');
                if (previewContainer) previewContainer.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }

        function resetImageSelection() {
            selectedFile = null;
            const fileInput = getEl('productImageInput');
            const previewImg = getEl('previewImg');
            const dropZone = getEl('dropZoneContainer');
            const previewContainer = getEl('imagePreviewContainer');
            const scannerLaser = getEl('scannerLaser');
            const btnAnalyzeAI = getEl('btnAnalyzeAI');

            if (fileInput) fileInput.value = '';
            if (previewImg) previewImg.src = '';
            if (dropZone) dropZone.classList.remove('hidden');
            if (previewContainer) previewContainer.classList.add('hidden');
            if (scannerLaser) scannerLaser.classList.add('hidden');
            if (btnAnalyzeAI) btnAnalyzeAI.disabled = false;
        }

        // Helper to convert text to high-contrast label image for OCR & AI analysis
        function createTextLabelBlob(text) {
            return new Promise((resolve) => {
                const canvas = document.createElement('canvas');
                canvas.width = 1000;
                canvas.height = 500;
                const ctx = canvas.getContext('2d');

                // White background
                ctx.fillStyle = '#FFFFFF';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Black text
                ctx.fillStyle = '#000000';
                ctx.font = 'bold 24px Arial, Helvetica, sans-serif';
                ctx.fillText('INGREDIENTS:', 40, 50);

                ctx.font = 'bold 20px Arial, Helvetica, sans-serif';

                // Word wrap
                const words = text.split(/\s+/);
                let line = '';
                let y = 110;
                for (let n = 0; n < words.length; n++) {
                    const testLine = line + (line ? ' ' : '') + words[n];
                    const metrics = ctx.measureText(testLine);
                    if (metrics.width > 900 && n > 0) {
                        ctx.fillText(line, 40, y);
                        line = words[n];
                        y += 36;
                    } else {
                        line = testLine;
                    }
                }
                if (line) {
                    ctx.fillText(line, 40, y);
                }

                canvas.toBlob((blob) => {
                    resolve(blob ? new File([blob], 'ingredients_label.png', { type: 'image/png' }) : null);
                }, 'image/png');
            });
        }

        // Demo sample loader
        function loadSamplePreset(presetKey) {
            currentActiveDataset = samplePresets[presetKey];
            const manualInput = getEl('manualIngredientsInput');
            const charCountDisplay = getEl('charCountDisplay');
            const previewImg = getEl('previewImg');
            const dropZone = getEl('dropZoneContainer');
            const previewContainer = getEl('imagePreviewContainer');
            const textCard = getEl('textModeCard');
            
            // 1. Populate Manual Text Area
            if (manualInput) {
                manualInput.value = currentActiveDataset.rawOcr;
                const len = manualInput.value.length;
                if (charCountDisplay) charCountDisplay.textContent = `${len} characters`;
            }

            // 2. Populate Image Canvas
            let sampleBg = '#fef3c7';
            let emoji = '⚠️';
            if (presetKey === 'halal') { sampleBg = '#f0f9ff'; emoji = '🔍'; }
            if (presetKey === 'haram') { sampleBg = '#ffe4e6'; emoji = '🥩'; }

            const canvas = document.createElement('canvas');
            canvas.width = 1000;
            canvas.height = 500;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = sampleBg;
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0f172a';
            ctx.font = 'bold 24px Arial, sans-serif';
            ctx.fillText(currentActiveDataset.title, 40, 60);
            ctx.font = 'bold 20px Arial, sans-serif';
            ctx.fillStyle = '#1e293b';
            
            const words = currentActiveDataset.rawOcr.split(/\s+/);
            let line = '';
            let y = 120;
            for (let n = 0; n < words.length; n++) {
                const testLine = line + (line ? ' ' : '') + words[n];
                const metrics = ctx.measureText(testLine);
                if (metrics.width > 880 && n > 0) {
                    ctx.fillText(line, 40, y);
                    line = words[n];
                    y += 36;
                } else {
                    line = testLine;
                }
            }
            if (line) {
                ctx.fillText(line, 40, y);
            }

            ctx.font = '64px serif';
            ctx.fillText(emoji, 880, 80);

            if (previewImg) previewImg.src = canvas.toDataURL('image/png');
            
            // Convert preset canvas to actual blob for backend transmission
            canvas.toBlob((blob) => {
                if (blob) {
                    selectedFile = new File([blob], `${presetKey}_preset.png`, { type: 'image/png' });
                }
            }, 'image/png');

            if (dropZone) dropZone.classList.add('hidden');
            if (previewContainer) previewContainer.classList.remove('hidden');

            if (activeInputMode === 'image') {
                if (previewContainer) previewContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                if (textCard) textCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // Pipeline animation & AI execution
        async function startAIAnalysis() {
            const manualInput = getEl('manualIngredientsInput');
            const btnAnalyzeAI = getEl('btnAnalyzeAI');
            const btnAnalyzeText = getEl('btnAnalyzeText');
            const scannerLaser = getEl('scannerLaser');
            const pipelineStatusBadge = getEl('pipelineStatusBadge');

            if (activeInputMode === 'image' && !selectedFile) {
                alert('Please select or upload a product ingredients image first.');
                return;
            }

            let textVal = '';
            if (activeInputMode === 'text') {
                textVal = manualInput ? manualInput.value.trim() : '';
                if (!textVal) {
                    alert('Please enter ingredients text to analyze.');
                    return;
                }
                if (textVal.length < 3) {
                    alert('Please enter a meaningful ingredient list.');
                    return;
                }
            }

            if (btnAnalyzeAI) btnAnalyzeAI.disabled = true;
            if (btnAnalyzeText) btnAnalyzeText.disabled = true;

            if (activeInputMode === 'image' && scannerLaser) {
                scannerLaser.classList.remove('hidden');
            }

            if (pipelineStatusBadge) {
                pipelineStatusBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 animate-pulse';
                pipelineStatusBadge.textContent = activeInputMode === 'image' ? 'Analyzing Image...' : 'Analyzing Ingredients Text...';
            }

            const steps = [
                { id: 'step1', delay: 400 },
                { id: 'step2', delay: 400 },
                { id: 'step3', delay: 400 },
                { id: 'step4', delay: 400 },
                { id: 'step5', delay: 400 }
            ];

            // Reset step indicators
            for (let i = 1; i <= 5; i++) {
                const el = getEl(`step${i}`);
                if (el) {
                    el.className = 'flex items-start gap-3.5 p-3 rounded-2xl border border-slate-100 bg-slate-50/60 transition-all';
                    const ind = el.querySelector('.step-indicator');
                    if (ind) ind.className = 'w-8 h-8 rounded-xl border border-slate-200 bg-white flex items-center justify-center text-xs font-bold text-slate-500 shrink-0 step-indicator';
                }
            }

            // Animate through pipeline steps sequentially
            const stepPromise = (async () => {
                for (let i = 0; i < steps.length; i++) {
                    const stepEl = getEl(steps[i].id);
                    if (stepEl) {
                        const indicator = stepEl.querySelector('.step-indicator');
                        stepEl.className = 'flex items-start gap-3.5 p-3 rounded-2xl border border-emerald-300 bg-emerald-50/80 transition-all shadow-xs';
                        if (indicator) indicator.className = 'w-8 h-8 rounded-xl border border-emerald-500 bg-emerald-600 text-white flex items-center justify-center text-xs font-bold shrink-0 step-indicator';
                    }
                    await new Promise(r => setTimeout(r, steps[i].delay));
                }
            })();

            try {
                let res;
                if (activeInputMode === 'image') {
                    const formData = new FormData();
                    if (selectedFile) {
                        formData.append('image', selectedFile);
                    }
                    res = await fetch('/api/product-analyzer/analyze', {
                        method: 'POST',
                        body: formData
                    });
                } else {
                    res = await fetch('/api/product-analyzer/analyze-text', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ text: textVal })
                    });
                }

                let json = null;
                try {
                    json = await res.json();
                } catch (e) {
                    console.warn("Could not parse backend json:", e);
                }

                await stepPromise;

                if (res.ok && json && json.success) {
                    if (pipelineStatusBadge) {
                        pipelineStatusBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-600 text-white';
                        pipelineStatusBadge.textContent = 'Analysis Complete';
                    }
                    
                    const mappedData = mapBackendResultToUi(json);
                    renderAnalysisReport(mappedData);
                } else {
                    const errorMsg = (json && (json.error || json.errorMessage || json.message)) || `Server returned status ${res.status}`;
                    if (pipelineStatusBadge) {
                        pipelineStatusBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-rose-600 text-white';
                        pipelineStatusBadge.textContent = 'Analysis Error';
                    }
                    alert(`Analysis Failed: ${errorMsg}`);
                }
            } catch (err) {
                console.error("Analysis network error:", err);
                await stepPromise;
                if (pipelineStatusBadge) {
                    pipelineStatusBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-rose-600 text-white';
                    pipelineStatusBadge.textContent = 'Connection Error';
                }
                alert("Connection to Halal/Haram AI server failed. Please check network connection and try again.");
            } finally {
                if (scannerLaser) scannerLaser.classList.add('hidden');
                if (btnAnalyzeAI) btnAnalyzeAI.disabled = false;
                if (btnAnalyzeText) btnAnalyzeText.disabled = false;
                const resContainer = document.getElementById('resultsMainContainer');
                if (resContainer) {
                    resContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        }

        function mapBackendResultToUi(apiData) {
            const rawStatus = (apiData.status || (apiData.decision && apiData.decision.status) || '').toUpperCase();
            
            let status = 'NO_HARAM_MATCH';
            let heading = 'NO HARAM / MUSHBOOH MATCH FOUND';
            let subtext = 'No matching Haram or Mushbooh ingredient was found in the available knowledge base. This does NOT mean the product is certified Halal.';
            
            if (rawStatus === 'HARAM_DETECTED') {
                status = 'HARAM_DETECTED';
                heading = 'HARAM DETECTED';
                subtext = (apiData.decision && apiData.decision.reason) || apiData.explanation || 'An explicitly classified Haram ingredient was found in the available knowledge base.';
            } else if (rawStatus === 'MUSHBOOH_DETECTED') {
                status = 'MUSHBOOH_DETECTED';
                heading = 'MUSHBOOH / REQUIRES VERIFICATION';
                subtext = (apiData.decision && apiData.decision.reason) || apiData.explanation || 'An ingredient classified as Mushbooh was found in the available knowledge base and requires verification.';
            } else if (rawStatus === 'INSUFFICIENT_OCR') {
                status = 'INSUFFICIENT_OCR';
                heading = 'INSUFFICIENT INFORMATION';
                subtext = 'The product label or text could not be processed sufficiently. Please check the ingredients input.';
            } else {
                status = 'NO_HARAM_MATCH';
                heading = 'NO HARAM / MUSHBOOH MATCH FOUND';
                subtext = (apiData.decision && apiData.decision.reason) || apiData.explanation || 'No matching Haram or Mushbooh ingredient was found in the available knowledge base. This does NOT mean the product is certified Halal.';
            }

            let confVal = 0.0;
            if (apiData.ocr && apiData.ocr.confidence !== undefined) {
                confVal = apiData.ocr.confidence;
            } else if (apiData.confidence !== undefined) {
                confVal = apiData.confidence;
            }

            const confScore = confVal > 0 
                ? (confVal > 1 ? `${confVal.toFixed(1)}%` : `${(confVal * 100).toFixed(1)}%`)
                : (activeInputMode === 'text' ? '100% (Direct Text)' : 'N/A');

            // Extract evidence lists
            const haramEvidence = (apiData.decision && apiData.decision.haram_evidence) || [];
            const mushboohEvidence = (apiData.decision && apiData.decision.mushbooh_evidence) || [];
            
            const ingredients = [];
            
            haramEvidence.forEach(h => {
                ingredients.push({
                    name: h.ingredient || 'Haram Substance',
                    status: 'Haram',
                    reason: h.description || 'Forbidden in Islamic dietary law',
                    matchType: h.match_type || 'EXACT',
                    ocrIngredient: h.ocr_ingredient || '',
                    reference: h.reference || ''
                });
            });

            mushboohEvidence.forEach(m => {
                ingredients.push({
                    name: m.ingredient || 'Mushbooh Substance',
                    status: 'Mushbooh (Requires Verification)',
                    reason: m.description || 'Requires verification of animal vs plant origin',
                    matchType: m.match_type || 'EXACT',
                    ocrIngredient: m.ocr_ingredient || '',
                    reference: m.reference || ''
                });
            });

            const manualInputEl = getEl('manualIngredientsInput');
            const ocrText = (apiData.ocr && apiData.ocr.text) || apiData.rawOcr || (manualInputEl ? manualInputEl.value : 'No text available.');
            const explanation = apiData.explanation || (apiData.decision && apiData.decision.reason) || subtext;

            return {
                status: status,
                statusHeading: heading,
                statusSubtext: subtext,
                confidence: confScore,
                rawOcr: ocrText,
                explanation: explanation,
                ingredients: ingredients,
                stats: {
                    haram: haramEvidence.length,
                    verify: mushboohEvidence.length,
                    certified: "No (KB Match Check)"
                }
            };
        }

        function renderAnalysisReport(data) {
            const card = document.getElementById('masterStatusCard');
            const iconBox = document.getElementById('statusIconBox');
            const pill = document.getElementById('statusPill');
            const heading = document.getElementById('statusHeading');
            const subtext = document.getElementById('statusSubtext');
            const confDisplay = document.getElementById('confidenceScoreDisplay');
            const confLabel = document.getElementById('confidenceLabel');

            confDisplay.textContent = data.confidence;
            heading.textContent = data.statusHeading;
            subtext.textContent = data.statusSubtext;

            if (data.status === 'HARAM_DETECTED') {
                card.className = 'rounded-3xl p-8 border shadow-lg transition-all duration-500 bg-rose-50/90 border-rose-200 text-rose-950';
                iconBox.className = 'w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shadow-md bg-rose-600 text-white';
                iconBox.innerHTML = '<i class="bi bi-x-circle-fill"></i>';
                pill.className = 'inline-flex items-center gap-2 px-3 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-rose-200 text-rose-900';
                pill.textContent = 'STATUS: HARAM DETECTED';
                confLabel.textContent = activeInputMode === 'text' ? 'Input Accuracy' : 'OCR Token Confidence';
            } else if (data.status === 'MUSHBOOH_DETECTED') {
                card.className = 'rounded-3xl p-8 border shadow-lg transition-all duration-500 bg-amber-50/90 border-amber-200 text-amber-950';
                iconBox.className = 'w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shadow-md bg-amber-500 text-white';
                iconBox.innerHTML = '<i class="bi bi-question-diamond-fill"></i>';
                pill.className = 'inline-flex items-center gap-2 px-3 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-200 text-amber-900';
                pill.textContent = 'STATUS: MUSHBOOH / REQUIRES VERIFICATION';
                confLabel.textContent = activeInputMode === 'text' ? 'Input Accuracy' : 'OCR Token Confidence';
            } else if (data.status === 'INSUFFICIENT_OCR') {
                card.className = 'rounded-3xl p-8 border shadow-lg transition-all duration-500 bg-slate-100 border-slate-300 text-slate-900';
                iconBox.className = 'w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shadow-md bg-slate-600 text-white';
                iconBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i>';
                pill.className = 'inline-flex items-center gap-2 px-3 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-slate-200 text-slate-800';
                pill.textContent = 'STATUS: INSUFFICIENT INFORMATION';
                confLabel.textContent = 'Low OCR Readability';
            } else {
                // NO_HARAM_MATCH
                card.className = 'rounded-3xl p-8 border shadow-lg transition-all duration-500 bg-sky-50/90 border-sky-200 text-sky-950';
                iconBox.className = 'w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shadow-md bg-sky-600 text-white';
                iconBox.innerHTML = '<i class="bi bi-shield-check"></i>';
                pill.className = 'inline-flex items-center gap-2 px-3 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-sky-200 text-sky-900';
                pill.textContent = 'STATUS: NO HARAM / MUSHBOOH MATCH FOUND';
                confLabel.textContent = activeInputMode === 'text' ? 'Input Accuracy' : 'OCR Token Confidence';
            }

            // OCR text
            document.getElementById('ocrRawTextDisplay').textContent = data.rawOcr;
            document.getElementById('ocrConfidenceText').textContent = data.confidence;

            // AI explanation
            document.getElementById('aiExplanationText').textContent = data.explanation;
            document.getElementById('statHaramCount').textContent = data.stats.haram;
            document.getElementById('statVerifyCount').textContent = data.stats.verify;
            document.getElementById('statHalalCertified').textContent = data.stats.certified;
            document.getElementById('ingredientCountBadge').textContent = `${data.ingredients.length} Evidence Detected`;

            // Table rows
            const tbody = document.getElementById('ingredientTableBody');
            tbody.innerHTML = '';

            if (data.ingredients.length === 0) {
                const emptyTr = document.createElement('tr');
                if (data.status === 'INSUFFICIENT_OCR') {
                    emptyTr.innerHTML = `
                        <td colspan="3" class="py-6 text-center text-slate-500 text-xs">
                            <i class="bi bi-exclamation-circle text-amber-500 text-lg block mb-1"></i>
                            The label text was not sufficiently readable to evaluate ingredients. Please upload a clearer image.
                        </td>
                    `;
                } else {
                    emptyTr.innerHTML = `
                        <td colspan="3" class="py-6 text-center text-slate-500 text-xs">
                            <i class="bi bi-check2-circle text-sky-500 text-lg block mb-1"></i>
                            No explicit Haram or Mushbooh additives were identified from the extracted label text.
                        </td>
                    `;
                }
                tbody.appendChild(emptyTr);
            } else {
                data.ingredients.forEach(item => {
                    let badgeClass = 'bg-amber-100 text-amber-900 border-amber-200';
                    let icon = 'bi-question-diamond-fill text-amber-600';
                    
                    if (item.status.toLowerCase().includes('haram')) {
                        badgeClass = 'bg-rose-100 text-rose-800 border-rose-200';
                        icon = 'bi-x-circle-fill text-rose-600';
                    }

                    const matchTypeBadge = item.matchType ? `<span class="text-[10px] uppercase font-bold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded ml-1">${item.matchType}</span>` : '';
                    const ocrMatchedText = item.ocrIngredient ? `<div class="text-[11px] text-slate-400 mt-0.5 font-mono">Matched Ingredient: "${item.ocrIngredient}"</div>` : '';
                    const refText = item.reference ? `<div class="text-[11px] text-emerald-700 mt-1 font-semibold flex items-center gap-1"><i class="bi bi-book"></i> Ref: ${item.reference}</div>` : '';

                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50/80 transition-colors';
                    tr.innerHTML = `
                        <td class="py-3.5 px-2 font-bold text-slate-900">
                            <div class="flex items-center gap-2">
                                <i class="bi ${icon}"></i>
                                <span>${item.name}</span>
                                ${matchTypeBadge}
                            </div>
                            ${ocrMatchedText}
                        </td>
                        <td class="py-3.5 px-2">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-extrabold border ${badgeClass}">
                                ${item.status}
                            </span>
                        </td>
                        <td class="py-3.5 px-2 text-xs text-slate-600">
                            <div>${item.reason}</div>
                            ${refText}
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }
        }

        function toggleOcrAccordion() {
            const content = document.getElementById('ocrContentArea');
            const chevron = document.getElementById('ocrChevron');
            content.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function clearHistoryDemo() {
            document.getElementById('historyCardsContainer').innerHTML = `
                <div class="col-span-full py-8 text-center text-slate-400 text-xs bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                    No recent analyses found. Upload an image or enter ingredients to start a new analysis.
                </div>
            `;
        }

        // Explicit global window bindings for inline HTML onclick handlers
        window.loadSamplePreset = loadSamplePreset;
        window.startAIAnalysis = startAIAnalysis;
        window.resetImageSelection = resetImageSelection;
        window.handleFileSelect = handleFileSelect;
        window.toggleOcrAccordion = toggleOcrAccordion;
        window.clearHistoryDemo = clearHistoryDemo;

        document.addEventListener('DOMContentLoaded', () => {
            setupEventListeners();
            renderAnalysisReport(samplePresets.verify);
        });

        // Also call setup immediately in case script executes after DOMContentLoaded
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            setupEventListeners();
        }
    </script>
}
