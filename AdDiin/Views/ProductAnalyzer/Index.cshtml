@section Scripts {
    <script>
        // Preset Sample Datasets for Demo / Exhibition
        const samplePresets = {
            halal: {
                title: "Potato Crisps Label (Vegetable Oils & Salt)",
                status: "NO_HARAM_MATCH",
                statusHeading: "NO HARAM / MUSHBOOH MATCH FOUND",
