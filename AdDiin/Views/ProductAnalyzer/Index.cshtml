            width: min(100%, 24rem);
            height: .35rem;
            margin: 1.25rem auto .8rem;
            overflow: hidden;
            border-radius: 999px;
            background: rgba(127, 211, 183, .14);
        }

        .product-analyzer-page .analysis-progress-bar::after {
            content: "";
            display: block;
            width: 38%;
            height: 100%;
            border-radius: inherit;
            background: #49ddb0;
            box-shadow: 0 0 16px rgba(73, 221, 176, .65);
