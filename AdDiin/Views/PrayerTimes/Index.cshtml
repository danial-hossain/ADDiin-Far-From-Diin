@model IEnumerable<AdDiin.Models.Entities.PrayerTime>
@{
    ViewData["Title"] = "Daily Prayer Schedule & Azan Reminders | ADDiin";
    var fardPrayers = Model.Where(p => (p.Category == "fard" || p.PrayerType == "fard" || p.PrayerType == "azan") && p.PrayerType != "jamaat").OrderBy(p => p.DisplayOrder).ToList();
    var naflPrayers = Model.Where(p => (p.Category == "nafl" || p.PrayerType == "optional" || p.Category == "sunnah") && p.PrayerType != "jamaat").OrderBy(p => p.DisplayOrder).ToList();
}

@section Styles {
<style>
    .prayer-page {
        position: relative;
        isolation: isolate;
        background:
            radial-gradient(circle at 8% 4%, rgba(16, 185, 129, .08), transparent 28rem),
            radial-gradient(circle at 92% 22%, rgba(201, 164, 78, .08), transparent 26rem);
    }
    .prayer-page::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: .35;
        background-image:
            linear-gradient(135deg, rgba(15, 118, 88, .035) 25%, transparent 25%),
            linear-gradient(315deg, rgba(201, 164, 78, .025) 25%, transparent 25%);
        background-size: 42px 42px;
    }
    .prayer-hero {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(110, 231, 183, .2);
        background:
            radial-gradient(circle at 82% 18%, rgba(226, 203, 144, .18), transparent 16rem),
            linear-gradient(135deg, #03251d 0%, #07513d 52%, #071f1b 100%);
        box-shadow: 0 24px 55px rgba(3, 37, 29, .22);
    }
    .prayer-hero::before {
        content: "";
        position: absolute;
        width: 20rem;
        height: 20rem;
        right: -7rem;
        top: -8rem;
        border: 1px solid rgba(226, 203, 144, .2);
        border-radius: 50%;
        box-shadow: 0 0 0 2rem rgba(226, 203, 144, .025), 0 0 0 5rem rgba(226, 203, 144, .018);
        transform: rotateX(60deg);
    }
    .prayer-hero::after {
        content: "✦";
        position: absolute;
        right: 12%;
        bottom: 12%;
        color: rgba(226, 203, 144, .24);
        font-size: 3rem;
        transform: rotate(18deg);
    }
    .prayer-surface {
        border: 1px solid rgba(15, 118, 88, .12);
        background:
            linear-gradient(145deg, rgba(26, 46, 36, .98), rgba(16, 38, 29, .96));
        border-color: rgba(127, 217, 181, .18);
        color: #f5f1e8;
        box-shadow: 0 18px 42px rgba(0, 0, 0, .2);
        backdrop-filter: blur(14px);
    }
    .prayer-surface .text-slate-900,
    .prayer-surface .text-slate-800 {
        color: #f5f1e8 !important;
    }
    .prayer-surface .text-slate-600,
    .prayer-surface .text-slate-500,
    .prayer-surface .text-slate-400 {
        color: #b9c9bf !important;
    }
    .prayer-surface .border-slate-100,
    .prayer-surface .border-slate-200 {
        border-color: rgba(127, 217, 181, .16) !important;
    }
    .prayer-select {
        background: #102a20 !important;
        color: #f5f1e8 !important;
        border-color: rgba(127, 217, 181, .28) !important;
    }
    .prayer-select option {
        background: #102a20;
        color: #f5f1e8;
    }
    .prayer-next {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(110, 231, 183, .32);
        background:
            radial-gradient(circle at 12% 8%, rgba(255,255,255,.12), transparent 14rem),
            linear-gradient(115deg, #063f30, #0b8060 58%, #063126);
        box-shadow: 0 22px 48px rgba(4, 65, 48, .22);
    }
    .prayer-next::after {
        content: "";
        position: absolute;
        width: 22rem;
        height: 22rem;
        right: -12rem;
        bottom: -15rem;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 50%;
        box-shadow: 0 0 0 2rem rgba(255,255,255,.025), 0 0 0 4rem rgba(255,255,255,.018);
        pointer-events: none;
    }
    .prayer-card {
        position: relative;
        overflow: hidden;
        min-height: 10.5rem;
        border-color: rgba(127, 217, 181, .2) !important;
        background: linear-gradient(145deg, #203d30, #162d23) !important;
        color: #f5f1e8;
        transform: translateZ(0);
        transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s ease, border-color .35s ease;
    }
    .prayer-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(127,217,181,.12), transparent 44%);
        pointer-events: none;
    }
    .prayer-card .text-slate-900 {
        color: #f5f1e8 !important;
    }
    .prayer-card .text-slate-400 {
        color: #b9c9bf !important;
    }
    .prayer-card .text-emerald-900 {
        color: #7fd9b5 !important;
    }
    .prayer-card .text-purple-900 {
        color: #e8ce7a !important;
    }
    .prayer-surface .bg-emerald-100,
    .prayer-card .bg-emerald-100 {
        background: rgba(47, 169, 124, .18) !important;
        color: #b9efd5 !important;
    }
    .prayer-surface .bg-purple-100,
    .prayer-card .bg-purple-100 {
        background: rgba(168, 120, 220, .18) !important;
        color: #e2c8ff !important;
    }
    .prayer-card:hover {
        transform: translateY(-7px) rotateX(2deg) rotateY(-2deg);
        border-color: rgba(16, 185, 129, .42);
        box-shadow: 0 18px 35px rgba(6, 78, 59, .14);
    }
    .prayer-card .prayer-orb {
        position: absolute;
        width: 5rem;
        height: 5rem;
        right: -1.7rem;
        top: -1.8rem;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(226,203,144,.25), rgba(226,203,144,0) 70%);
    }
    .prayer-section-title {
        letter-spacing: -.025em;
    }
    .prayer-select {
        box-shadow: inset 0 1px 2px rgba(16,52,41,.04);
    }
    @@media (max-width: 640px) {
        .prayer-card { min-height: 9.5rem; }
        .prayer-hero::after { right: 5%; bottom: 7%; font-size: 2rem; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .prayer-card { transition: none; }
        .prayer-card:hover { transform: none; }
    }
</style>
}

<div class="prayer-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header Banner -->
    <div class="prayer-hero rounded-[2rem] p-8 sm:p-10 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
            <span class="px-3.5 py-1 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold rounded-full uppercase tracking-wider">
                <i class="bi bi-geo-alt-fill me-1"></i> বিভাগভিত্তিক সময়সূচী (Division-Based Timing)
            </span>
            <h1 class="relative z-10 text-3xl sm:text-4xl font-extrabold tracking-tight">Daily Prayer Schedule & Azan</h1>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed" id="location-description">
                ইসলামিক ফাউন্ডেশন বাংলাদেশ মান অনুযায়ী <strong class="text-emerald-300" id="current-location-text">ঢাকা বিভাগ (Dhaka Division)</strong> এর সঠিক আযান ও নামাযের সময়সূচী।
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="button" id="btn-detect-location" class="px-4 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-2xl shadow-md transition flex items-center gap-2">
                <i class="bi bi-crosshair"></i> <span>Detect My Division</span>
            </button>
            <a href="/my-deen" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-2xl shadow-md transition flex items-center gap-2 border border-slate-700">
                <i class="bi bi-check2-all"></i> Check In to My Deen
            </a>
        </div>
    </div>

    <!-- Bangladesh 8 Divisions Selector Controls -->
    <div class="prayer-surface rounded-3xl p-5 sm:p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
            <div>
                <label class="block text-xs font-extrabold text-slate-600 uppercase tracking-wider mb-1.5">
                    <i class="bi bi-pin-map-fill text-emerald-600 me-1"></i> বিভাগ নির্বাচন করুন (Select Division)
                </label>
                <select id="division-select" class="prayer-select w-full bg-slate-50 border border-slate-300 text-slate-800 text-sm font-semibold rounded-xl px-3.5 py-2.5 focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
                    <option value="Dhaka" data-offset="0" data-name-bn="ঢাকা বিভাগ" selected>ঢাকা (Dhaka) - Standard</option>
                    <option value="Chittagong" data-offset="-5" data-name-bn="চট্টগ্রাম বিভাগ">চট্টগ্রাম (Chittagong) [-5m]</option>
                    <option value="Sylhet" data-offset="-6" data-name-bn="সিলেট বিভাগ">সিলেট (Sylhet) [-6m]</option>
                    <option value="Rajshahi" data-offset="6" data-name-bn="রাজশাহী বিভাগ">রাজশাহী (Rajshahi) [+6m]</option>
                    <option value="Khulna" data-offset="4" data-name-bn="খুলনা বিভাগ">খুলনা (Khulna) [+4m]</option>
                    <option value="Barisal" data-offset="1" data-name-bn="বরিশাল বিভাগ">বরিশাল (Barisal) [+1m]</option>
                    <option value="Rangpur" data-offset="5" data-name-bn="রংপুর বিভাগ">রংপুর (Rangpur) [+5m]</option>
                    <option value="Mymensingh" data-offset="-1" data-name-bn="ময়মনসিংহ বিভাগ">ময়মনসিংহ (Mymensingh) [-1m]</option>
                </select>
            </div>

            <div class="flex flex-col justify-center space-y-1">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">সময় গণনা পদ্ধতি (Islamic Foundation Bangladesh)</span>
                <p class="text-xs text-slate-600">
                    ইসলামিক ফাউন্ডেশনের সার্বজনীন চার্ট অনুযায়ী বাংলাদেশের ৮টি বিভাগের জন্য সঠিক ওয়াক্ত ও আযানের সময়সূচী।
                </p>
            </div>
        </div>

        <div id="status-indicator" class="mt-3 text-xs text-slate-500 flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="status-text">ঢাকা বিভাগের আযান ও নামাযের সময়সূচী সক্রিয় রয়েছে</span>
        </div>
    </div>

    <!-- Live Next Prayer Alert Banner -->
    <div class="prayer-next rounded-[2rem] p-6 sm:p-7 text-white flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center text-2xl border border-white/15 shrink-0">
                <i class="bi bi-alarm-fill text-amber-300 animate-bounce"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 bg-amber-400/20 border border-amber-300/30 text-amber-300 text-[10px] font-extrabold rounded-full uppercase tracking-wider">
                        Next Prayer Alert
                    </span>
                    <span class="text-xs text-emerald-200" id="live-clock">--:--:--</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-black text-white mt-1 flex items-center gap-2">
                    <span id="next-prayer-name">Calculating...</span>
                    <span class="text-sm font-normal text-emerald-200 font-arabic" id="next-prayer-bn"></span>
                </h3>
                <p class="text-xs text-emerald-100/90 mt-0.5">
                    Azan scheduled at <strong class="text-amber-300" id="next-prayer-time">--:--</strong>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
            <div class="bg-black/30 backdrop-blur-md px-4 py-2.5 rounded-2xl border border-white/10 text-center">
                <span class="text-[10px] uppercase font-bold text-slate-300 block">Time Remaining</span>
                <span class="text-xl sm:text-2xl font-black font-mono text-amber-300" id="next-prayer-countdown">--:--:--</span>
            </div>
            <button type="button" id="btn-toggle-azan-sound" onclick="toggleAzanAudio()" class="px-4 py-3 bg-white/15 hover:bg-white/25 text-white font-bold text-xs rounded-2xl border border-white/20 transition flex items-center gap-2">
                <i class="bi bi-volume-up-fill" id="azan-sound-icon"></i>
                <span id="azan-sound-text">Azan Tone: ON</span>
            </button>
        </div>
    </div>

    <!-- Obligatory Daily Prayers (Fard / Azan) -->
    <div class="prayer-surface rounded-[2rem] p-6 sm:p-8 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
                <h3 class="font-extrabold text-slate-900 text-lg">ফারদ্ব নামাযের আযান (Obligatory Daily Prayers)</h3>
                <p class="text-xs text-slate-500">The pillar of Islam and primary daily connection with Allah (SWT)</p>
            </div>
            <span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full">
                @fardPrayers.Count Daily Prayers
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            @foreach (var prayer in fardPrayers)
            {
                var time12 = DateTime.Today.Add(prayer.PrayerTimeValue).ToString("hh:mm tt");
                <div class="prayer-card p-5 rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/70 to-teal-50/35 text-center space-y-2">
                    <div class="prayer-orb" aria-hidden="true"></div>
                    <span class="text-xs uppercase font-bold text-slate-400">@prayer.DisplayNameBn</span>
                    <h4 class="text-lg font-black text-slate-900">@prayer.DisplayNameEn</h4>
                    <div id="prayer-time-@prayer.Id" data-prayer-id="@prayer.Id" data-base-time="@prayer.PrayerTimeValue.ToString(@"hh\:mm")" class="dynamic-prayer-time text-2xl sm:text-3xl font-black text-emerald-900 font-mono py-1">
                        @time12
                    </div>
                    <span class="inline-block px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">
                        Azan Time
                    </span>
                </div>
            }
        </div>
    </div>

    <!-- Voluntary Sunnah & Nafl Prayers -->
    @if (naflPrayers.Any())
    {
        <div class="prayer-surface rounded-[2rem] p-6 sm:p-8 space-y-6">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div>
                    <h3 class="font-extrabold text-slate-900 text-lg">সুন্নাত ও নফল নামায (Sunnah & Nafl Prayers)</h3>
                    <p class="text-xs text-slate-500">Recommended Prophetic prayers for immense spiritual rewards and elevated ranks</p>
                </div>
                <span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-full">
                    @naflPrayers.Count Voluntary Prayers
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var prayer in naflPrayers)
                {
                    var time12 = DateTime.Today.Add(prayer.PrayerTimeValue).ToString("hh:mm tt");
                    <div class="prayer-card p-5 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-purple-50/30 text-center space-y-2">
                        <div class="prayer-orb" aria-hidden="true"></div>
                        <span class="text-xs uppercase font-bold text-slate-400">@prayer.DisplayNameBn</span>
                        <h4 class="text-base font-bold text-slate-900">@prayer.DisplayNameEn</h4>
                        <div id="prayer-time-@prayer.Id" data-prayer-id="@prayer.Id" data-base-time="@prayer.PrayerTimeValue.ToString(@"hh\:mm")" class="dynamic-prayer-time text-2xl font-black text-purple-900 font-mono py-1">
                            @time12
                        </div>
                        <span class="inline-block px-2.5 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded-full">
                            Recommended Nafl
                        </span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const divisionSelect = document.getElementById('division-select');
        const btnDetectLocation = document.getElementById('btn-detect-location');
        const currentLocationText = document.getElementById('current-location-text');
        const statusText = document.getElementById('status-text');

        function addMinutesToTime12(timeStr, minutesToAdd) {
            if (!timeStr) return '--:-- --';
            const [hours, mins] = timeStr.split(':').map(Number);
            let totalMins = hours * 60 + mins + minutesToAdd;
            if (totalMins < 0) totalMins += 24 * 60;
            totalMins %= (24 * 60);

            const resH = Math.floor(totalMins / 60);
            const resM = totalMins % 60;
            const ampm = resH >= 12 ? 'PM' : 'AM';
            const displayH = resH % 12 === 0 ? 12 : resH % 12;
            return String(displayH).padStart(2, '0') + ':' + String(resM).padStart(2, '0') + ' ' + ampm;
        }

        function applyDivisionTimes(divisionKey, divisionBn, offsetMinutes) {
            const timeElements = document.querySelectorAll('.dynamic-prayer-time');
            timeElements.forEach(el => {
                const baseTime = el.getAttribute('data-base-time');
                if (baseTime) {
                    el.innerText = addMinutesToTime12(baseTime, offsetMinutes);
                }
            });

            const offsetLabel = offsetMinutes === 0 ? 'ঢাকা মান সময়' : (offsetMinutes > 0 ? `+${offsetMinutes} মিনিট যোগ` : `${offsetMinutes} মিনিট বিয়োগ`);
            currentLocationText.innerText = `${divisionBn} (${divisionKey})`;
            statusText.innerText = `${divisionBn} এর আযান ও নামাযের সময়সূচী সক্রিয় রয়েছে (${offsetLabel})`;
            localStorage.setItem('user_selected_bd_division', divisionKey);
        }

        // Handle Division Dropdown Change
        divisionSelect.addEventListener('change', () => {
            const selectedOpt = divisionSelect.options[divisionSelect.selectedIndex];
            const offset = parseInt(selectedOpt.getAttribute('data-offset') || '0', 10);
            const divisionBn = selectedOpt.getAttribute('data-name-bn') || selectedOpt.value;
            applyDivisionTimes(selectedOpt.value, divisionBn, offset);
        });

        // GPS Auto-detection for Bangladesh Divisions
        btnDetectLocation.addEventListener('click', () => {
            if (!navigator.geolocation) {
                alert('আপনার ব্রাউজারে লোকেশন সনাক্তকরণ সমর্থিত নয়।');
                return;
            }
            statusText.innerText = 'আপনার বিভাগ সনাক্ত করা হচ্ছে...';
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    
                    let detectedDivision = "Dhaka";
                    if (lat > 25.0) detectedDivision = "Rangpur";
                    else if (lat > 24.3 && lng > 91.0) detectedDivision = "Sylhet";
                    else if (lat > 24.3 && lng < 89.5) detectedDivision = "Rajshahi";
                    else if (lat > 24.3) detectedDivision = "Mymensingh";
                    else if (lng > 91.2) detectedDivision = "Chittagong";
                    else if (lat < 23.0 && lng < 90.0) detectedDivision = "Khulna";
                    else if (lat < 23.0) detectedDivision = "Barisal";

                    divisionSelect.value = detectedDivision;
                    divisionSelect.dispatchEvent(new Event('change'));
                },
                (err) => {
                    statusText.innerText = 'লোকেশন অনুমতি পাওয়া যায়নি। ঢাকা বিভাগ সক্রিয় রয়েছে।';
                }
            );
        });

        // Restore saved preference
        const savedDivision = localStorage.getItem('user_selected_bd_division');
        if (savedDivision && divisionSelect.querySelector(`option[value="${savedDivision}"]`)) {
            divisionSelect.value = savedDivision;
            divisionSelect.dispatchEvent(new Event('change'));
        }

        // --- Real-time Next Prayer Alert & Live Countdown ---
        const prayersList = [
            @foreach(var p in fardPrayers) {
                <text>{ id: @p.Id, nameEn: "@Html.Raw(p.DisplayNameEn)", nameBn: "@Html.Raw(p.DisplayNameBn)", baseTime: "@p.PrayerTimeValue.ToString(@"hh\:mm")" },</text>
            }
        ];

        function getDivisionOffset() {
            const selectedOpt = divisionSelect.options[divisionSelect.selectedIndex];
            return parseInt(selectedOpt.getAttribute('data-offset') || '0', 10);
        }

        function updateLivePrayerAlert() {
            const now = new Date();
            const offset = getDivisionOffset();

            // Format Live Clock
            document.getElementById('live-clock').innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

            // Calculate prayer dates for today
            let nextP = null;
            let minDiffSeconds = Infinity;
            let nextPrayerDate = null;

            for (const p of prayersList) {
                const [h, m] = p.baseTime.split(':').map(Number);
                let prayerMin = h * 60 + m + offset;
                const pH = Math.floor(prayerMin / 60);
                const pM = prayerMin % 60;

                const pDate = new Date(now.getFullYear(), now.getMonth(), now.getDate(), pH, pM, 0);
                let diff = (pDate - now) / 1000;

                if (diff > 0 && diff < minDiffSeconds) {
                    minDiffSeconds = diff;
                    nextP = p;
                    nextPrayerDate = pDate;
                }
            }

            // If all prayers passed for today, next is tomorrow's Fajr
            if (!nextP && prayersList.length > 0) {
                nextP = prayersList[0];
                const [h, m] = nextP.baseTime.split(':').map(Number);
                let prayerMin = h * 60 + m + offset;
                const pH = Math.floor(prayerMin / 60);
                const pM = prayerMin % 60;
                nextPrayerDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, pH, pM, 0);
                minDiffSeconds = (nextPrayerDate - now) / 1000;
            }

            if (nextP && nextPrayerDate) {
                document.getElementById('next-prayer-name').innerText = nextP.nameEn;
                document.getElementById('next-prayer-bn').innerText = nextP.nameBn;
                document.getElementById('next-prayer-time').innerText = nextPrayerDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                const totalSec = Math.max(0, Math.floor(minDiffSeconds));
                const hours = Math.floor(totalSec / 3600);
                const mins = Math.floor((totalSec % 3600) / 60);
                const secs = totalSec % 60;

                document.getElementById('next-prayer-countdown').innerText = 
                    String(hours).padStart(2, '0') + ':' + String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');

                // Trigger Azan Alert when it reaches 0
                if (totalSec === 0) {
                    playAzanAlert(nextP.nameEn);
                }
            }
        }

        // Run every second
        setInterval(updateLivePrayerAlert, 1000);
        updateLivePrayerAlert();

        divisionSelect.addEventListener('change', updateLivePrayerAlert);
    });

    let azanSoundEnabled = localStorage.getItem('azan_sound_pref') !== 'false';
    function updateSoundUi() {
        const icon = document.getElementById('azan-sound-icon');
        const text = document.getElementById('azan-sound-text');
        if (icon && text) {
            if (azanSoundEnabled) {
                icon.className = 'bi bi-volume-up-fill';
                text.innerText = 'Azan Alert: ON';
            } else {
                icon.className = 'bi bi-volume-mute-fill text-slate-400';
                text.innerText = 'Azan Alert: MUTED';
            }
        }
    }

    function toggleAzanAudio() {
        azanSoundEnabled = !azanSoundEnabled;
        localStorage.setItem('azan_sound_pref', azanSoundEnabled);
        updateSoundUi();
        if (azanSoundEnabled) {
            playBeepTone(); // gentle test chime
        }
    }

    function playBeepTone() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5 chime
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.2);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 1.2);
        } catch(e) {}
    }

    function playAzanAlert(prayerName) {
        if (azanSoundEnabled) {
            playBeepTone();
        }
        if ("Notification" in window && Notification.permission === "granted") {
            new Notification(`🕌 Time for ${prayerName} Prayer`, {
                body: `The time for ${prayerName} has arrived. Come to prayer!`,
                icon: '/favicon.ico'
            });
        }
    }

    // Request browser notification permission if not yet requested
    if ("Notification" in window && Notification.permission === "default") {
        Notification.requestPermission();
    }
</script>
}
