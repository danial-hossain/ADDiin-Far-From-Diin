@model IEnumerable<AdDiin.Models.Entities.PrayerTime>
@{
    ViewData["Title"] = "Daily Prayer Schedule & Azan Reminders | ADDiin";
    var fardPrayers = Model.Where(p => (p.Category == "fard" || p.PrayerType == "fard" || p.PrayerType == "azan") && p.PrayerType != "jamaat").OrderBy(p => p.DisplayOrder).ToList();
    var naflPrayers = Model.Where(p => (p.Category == "nafl" || p.PrayerType == "optional" || p.Category == "sunnah") && p.PrayerType != "jamaat").OrderBy(p => p.DisplayOrder).ToList();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-emerald-950 via-teal-950 to-slate-900 rounded-3xl p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
            <span class="px-3.5 py-1 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold rounded-full uppercase tracking-wider">
                <i class="bi bi-geo-alt-fill me-1"></i> বিভাগভিত্তিক সময়সূচী (Division-Based Timing)
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Daily Prayer Schedule & Azan</h1>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed" id="location-description">
                ইসলামিক ফাউন্ডেশন বাংলাদেশ মান অনুযায়ী <strong class="text-emerald-300" id="current-location-text">ঢাকা বিভাগ (Dhaka Division)</strong> এর সঠিক আযান ও নামাযের সময়সূচী।
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="button" id="btn-detect-location" class="px-4 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-2xl shadow-md transition flex items-center gap-2">
                <i class="bi bi-crosshair"></i> <span>Detect My Division</span>
            </button>
            <a href="/my-deen" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-2xl shadow-md transition flex items-center gap-2 border border-slate-700">
                <i class="bi bi-check2-all"></i> Check In to My Deen
            </a>
        </div>
    </div>

    <!-- Bangladesh 8 Divisions Selector Controls -->
    <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-slate-200">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
            <div>
                <label class="block text-xs font-extrabold text-slate-600 uppercase tracking-wider mb-1.5">
                    <i class="bi bi-pin-map-fill text-emerald-600 me-1"></i> বিভাগ নির্বাচন করুন (Select Division)
                </label>
                <select id="division-select" class="w-full bg-slate-50 border border-slate-300 text-slate-800 text-sm font-semibold rounded-xl px-3.5 py-2.5 focus:ring-2 focus:ring-emerald-500 focus:outline-none transition">
                    <option value="Dhaka" data-offset="0" data-name-bn="ঢাকা বিভাগ" selected>ঢাকা (Dhaka) - Standard</option>
                    <option value="Chittagong" data-offset="-5" data-name-bn="চট্টগ্রাম বিভাগ">চট্টগ্রাম (Chittagong) [-5m]</option>
                    <option value="Sylhet" data-offset="-6" data-name-bn="সিলেট বিভাগ">সিলেট (Sylhet) [-6m]</option>
                    <option value="Rajshahi" data-offset="6" data-name-bn="রাজশাহী বিভাগ">রাজশাহী (Rajshahi) [+6m]</option>
                    <option value="Khulna" data-offset="4" data-name-bn="খুলনা বিভাগ">খুলনা (Khulna) [+4m]</option>
                    <option value="Barisal" data-offset="1" data-name-bn="বরিশাল বিভাগ">বরিশাল (Barisal) [+1m]</option>
                    <option value="Rangpur" data-offset="5" data-name-bn="রংপুর বিভাগ">রংপুর (Rangpur) [+5m]</option>
                    <option value="Mymensingh" data-offset="-1" data-name-bn="ময়মনসিংহ বিভাগ">ময়মনসিংহ (Mymensingh) [-1m]</option>
                </select>
            </div>

            <div class="flex flex-col justify-center space-y-1">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">সময় গণনা পদ্ধতি (Islamic Foundation Bangladesh)</span>
                <p class="text-xs text-slate-600">
                    ইসলামিক ফাউন্ডেশনের সার্বজনীন চার্ট অনুযায়ী বাংলাদেশের ৮টি বিভাগের জন্য সঠিক ওয়াক্ত ও আযানের সময়সূচী।
                </p>
            </div>
        </div>

        <div id="status-indicator" class="mt-3 text-xs text-slate-500 flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="status-text">ঢাকা বিভাগের আযান ও নামাযের সময়সূচী সক্রিয় রয়েছে</span>
        </div>
    </div>

    <!-- Five Obligatory Prayers (Fard/Azan) -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
                <h3 class="font-extrabold text-slate-900 text-lg">Five Obligatory Daily Prayers (Azan Times)</h3>
                <p class="text-xs text-slate-500">The pillar of Islam and primary daily connection with Allah (SWT)</p>
            </div>
            <span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full">
                5 Fard Prayers
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="p-5 rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/50 to-teal-50/30 text-center space-y-2 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">ফজর</span>
                <h4 class="text-lg font-black text-slate-900">Fajr</h4>
                <div id="time-fajr" class="text-3xl font-black text-emerald-900 font-mono py-1">
                    @(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("fajr"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "05:00")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">
                    Azan Time
                </span>
            </div>

            <div class="p-5 rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/50 to-teal-50/30 text-center space-y-2 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">যোহর</span>
                <h4 class="text-lg font-black text-slate-900">Dhuhr</h4>
                <div id="time-dhuhr" class="text-3xl font-black text-emerald-900 font-mono py-1">
                    @(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("dhuhr"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "12:15")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">
                    Azan Time
                </span>
            </div>

            <div class="p-5 rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/50 to-teal-50/30 text-center space-y-2 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">আসর</span>
                <h4 class="text-lg font-black text-slate-900">Asr</h4>
                <div id="time-asr" class="text-3xl font-black text-emerald-900 font-mono py-1">
                    @(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("asr"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "15:45")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">
                    Azan Time
                </span>
            </div>

            <div class="p-5 rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/50 to-teal-50/30 text-center space-y-2 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">মাগরিব</span>
                <h4 class="text-lg font-black text-slate-900">Maghrib</h4>
                <div id="time-maghrib" class="text-3xl font-black text-emerald-900 font-mono py-1">
                    @(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("maghrib"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "18:30")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">
                    Azan Time
                </span>
            </div>

            <div class="p-5 rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/50 to-teal-50/30 text-center space-y-2 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">এশা</span>
                <h4 class="text-lg font-black text-slate-900">Isha</h4>
                <div id="time-isha" class="text-3xl font-black text-emerald-900 font-mono py-1">
                    @(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("isha"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "20:00")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">
                    Azan Time
                </span>
            </div>
        </div>
    </div>

    <!-- Voluntary Nafl Prayers -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
                <h3 class="font-extrabold text-slate-900 text-lg">Sunnah & Voluntary Prayers (Nafl)</h3>
                <p class="text-xs text-slate-500">Recommended Prophetic prayers for immense spiritual rewards and elevated ranks</p>
            </div>
            <span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-full">
                Voluntary Sunnah
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-5 rounded-2xl border border-slate-200 bg-slate-50 text-center space-y-2 hover:bg-white hover:border-purple-300 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">তাহাজ্জুদ</span>
                <h4 class="text-base font-bold text-slate-900">Tahajjud (Night Vigil)</h4>
                <div id="time-tahajjud" class="text-2xl font-black text-purple-900 font-mono py-1">
                    @(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("tahajju"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "02:30")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded-full">
                    Recommended Nafl
                </span>
            </div>

            <div class="p-5 rounded-2xl border border-slate-200 bg-slate-50 text-center space-y-2 hover:bg-white hover:border-purple-300 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">ইশরাক</span>
                <h4 class="text-base font-bold text-slate-900">Ishraq (Post-Sunrise)</h4>
                <div id="time-ishraq" class="text-2xl font-black text-purple-900 font-mono py-1">
                    @(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("ishraq"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "05:45")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded-full">
                    Recommended Nafl
                </span>
            </div>

            <div class="p-5 rounded-2xl border border-slate-200 bg-slate-50 text-center space-y-2 hover:bg-white hover:border-purple-300 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">চাশত / দুহা</span>
                <h4 class="text-base font-bold text-slate-900">Duha / Chasht</h4>
                <div id="time-duha" class="text-2xl font-black text-purple-900 font-mono py-1">
                    @(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("duha"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "08:00")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded-full">
                    Recommended Nafl
                </span>
            </div>

            <div class="p-5 rounded-2xl border border-slate-200 bg-slate-50 text-center space-y-2 hover:bg-white hover:border-purple-300 hover:shadow-md transition">
                <span class="text-xs uppercase font-bold text-slate-400">আউওয়াবিন</span>
                <h4 class="text-base font-bold text-slate-900">Awwabin</h4>
                <div id="time-awwabin" class="text-2xl font-black text-purple-900 font-mono py-1">
                    @(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("awwabin"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "18:45")
                </div>
                <span class="inline-block px-2.5 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded-full">
                    Recommended Nafl
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const divisionSelect = document.getElementById('division-select');
        const btnDetectLocation = document.getElementById('btn-detect-location');
        const currentLocationText = document.getElementById('current-location-text');
        const statusText = document.getElementById('status-text');

        // Base timings for Dhaka Standard
        const baseTimings = {
            fajr: "@(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("fajr"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "05:00")",
            dhuhr: "@(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("dhuhr"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "12:15")",
            asr: "@(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("asr"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "15:45")",
            maghrib: "@(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("maghrib"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "18:30")",
            isha: "@(fardPrayers.FirstOrDefault(p => p.PrayerName.Contains("isha"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "20:00")",
            tahajjud: "@(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("tahajju"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "02:30")",
            ishraq: "@(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("ishraq"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "05:45")",
            duha: "@(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("duha"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "08:00")",
            awwabin: "@(naflPrayers.FirstOrDefault(p => p.PrayerName.Contains("awwabin"))?.PrayerTimeValue.ToString(@"hh\:mm") ?? "18:45")"
        };

        function addMinutesToTime(timeStr, minutesToAdd) {
            if (!timeStr) return '--:--';
            const [hours, mins] = timeStr.split(':').map(Number);
            let totalMins = hours * 60 + mins + minutesToAdd;
            if (totalMins < 0) totalMins += 24 * 60;
            totalMins %= (24 * 60);

            const resH = Math.floor(totalMins / 60);
            const resM = totalMins % 60;
            return String(resH).padStart(2, '0') + ':' + String(resM).padStart(2, '0');
        }

        function applyDivisionTimes(divisionKey, divisionBn, offsetMinutes) {
            document.getElementById('time-fajr').innerText = addMinutesToTime(baseTimings.fajr, offsetMinutes);
            document.getElementById('time-dhuhr').innerText = addMinutesToTime(baseTimings.dhuhr, offsetMinutes);
            document.getElementById('time-asr').innerText = addMinutesToTime(baseTimings.asr, offsetMinutes);
            document.getElementById('time-maghrib').innerText = addMinutesToTime(baseTimings.maghrib, offsetMinutes);
            document.getElementById('time-isha').innerText = addMinutesToTime(baseTimings.isha, offsetMinutes);

            document.getElementById('time-tahajjud').innerText = addMinutesToTime(baseTimings.tahajjud, offsetMinutes);
            document.getElementById('time-ishraq').innerText = addMinutesToTime(baseTimings.ishraq, offsetMinutes);
            document.getElementById('time-duha').innerText = addMinutesToTime(baseTimings.duha, offsetMinutes);
            document.getElementById('time-awwabin').innerText = addMinutesToTime(baseTimings.awwabin, offsetMinutes);

            const offsetLabel = offsetMinutes === 0 ? 'ঢাকা মান সময়' : (offsetMinutes > 0 ? `+${offsetMinutes} মিনিট যোগ` : `${offsetMinutes} মিনিট বিয়োগ`);
            currentLocationText.innerText = `${divisionBn} (${divisionKey})`;
            statusText.innerText = `${divisionBn} এর আযান ও নামাযের সময়সূচী সক্রিয় রয়েছে (${offsetLabel})`;
            localStorage.setItem('user_selected_bd_division', divisionKey);
        }

        // Handle Division Dropdown Change
        divisionSelect.addEventListener('change', () => {
            const selectedOpt = divisionSelect.options[divisionSelect.selectedIndex];
            const offset = parseInt(selectedOpt.getAttribute('data-offset') || '0', 10);
            const divisionBn = selectedOpt.getAttribute('data-name-bn') || selectedOpt.value;
            applyDivisionTimes(selectedOpt.value, divisionBn, offset);
        });

        // GPS Auto-detection for Bangladesh Divisions
        btnDetectLocation.addEventListener('click', () => {
            if (!navigator.geolocation) {
                alert('আপনার ব্রাউজারে লোকেশন সনাক্তকরণ সমর্থিত নয়।');
                return;
            }
            statusText.innerText = 'আপনার বিভাগ সনাক্ত করা হচ্ছে...';
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    
                    let detectedDivision = "Dhaka";
                    if (lat > 25.0) detectedDivision = "Rangpur";
                    else if (lat > 24.3 && lng > 91.0) detectedDivision = "Sylhet";
                    else if (lat > 24.3 && lng < 89.5) detectedDivision = "Rajshahi";
                    else if (lat > 24.3) detectedDivision = "Mymensingh";
                    else if (lng > 91.2) detectedDivision = "Chittagong";
                    else if (lat < 23.0 && lng < 90.0) detectedDivision = "Khulna";
                    else if (lat < 23.0) detectedDivision = "Barisal";

                    divisionSelect.value = detectedDivision;
                    divisionSelect.dispatchEvent(new Event('change'));
                },
                (err) => {
                    statusText.innerText = 'লোকেশন অনুমতি পাওয়া যায়নি। ঢাকা বিভাগ সক্রিয় রয়েছে।';
                }
            );
        });

        // Restore saved preference
        const savedDivision = localStorage.getItem('user_selected_bd_division');
        if (savedDivision && divisionSelect.querySelector(`option[value="${savedDivision}"]`)) {
            divisionSelect.value = savedDivision;
            divisionSelect.dispatchEvent(new Event('change'));
        }
    });
</script>
}
