@model List<AdDiin.Models.Entities.PrayerTime>
@{
    ViewData["Title"] = "Daily Prayer Schedule & Jamaat Timings";
    var nextPrayer = ViewBag.NextPrayer as AdDiin.Models.Entities.PrayerTime;
    var fardAzan = Model.Where(p => p.Category == "fard" && p.PrayerType == "azan").OrderBy(p => p.DisplayOrder).ToList();
    var fardJamaat = Model.Where(p => p.Category == "fard" && p.PrayerType == "jamaat").OrderBy(p => p.DisplayOrder).ToList();
    var naflPrayers = Model.Where(p => p.Category == "nafl").OrderBy(p => p.DisplayOrder).ToList();
}

<div class="bg-emerald-dark text-white py-5">
    <div class="container text-center py-3">
        <h1 class="display-5 fw-extrabold mb-2">🕌 Daily Prayer Schedules</h1>
        <p class="text-white-75 max-w-700 mx-auto">
            Live congregation & azan schedules updated in real time by the mosque administration.
        </p>
    </div>
</div>

<div class="container my-5">
    <!-- Next Prayer Countdown Banner -->
    @if (nextPrayer != null)
    {
        <div class="card card-custom p-4 bg-emerald text-white border-0 shadow-lg rounded-4 mb-5">
            <div class="row align-items-center g-3 text-center text-md-start">
                <div class="col-md-7">
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">NEXT JAMAAT PRAYER</span>
                    <h2 class="fw-extrabold mb-1">@nextPrayer.DisplayNameEn (@nextPrayer.DisplayNameBn)</h2>
                    <p class="text-white-75 mb-0">Please perform Wudu and reach the mosque prior to the Iqamah.</p>
                </div>
                <div class="col-md-5 text-center text-md-end">
                    <div class="display-4 fw-extrabold text-warning">
                        @nextPrayer.PrayerTimeValue.ToString(@"hh\:mm")
                    </div>
                    <small class="text-white-75">Congregation Time (Dhaka Standard Time)</small>
                </div>
            </div>
        </div>
    }

    <!-- Fard Prayers Table -->
    <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-fill text-emerald me-2"></i> Daily Five Fard Prayers</h4>
            <span class="badge bg-emerald-light text-emerald px-3 py-2 rounded-pill fw-semibold">Fard (Obligatory)</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="py-3">Prayer Name</th>
                        <th class="py-3">বাংলা নাম</th>
                        <th class="py-3 text-center">Azan Time</th>
                        <th class="py-3 text-center">Jamaat (Iqamah)</th>
                        <th class="py-3 text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var prayerNames = new[] { "fajr", "dhuhr", "asr", "maghrib", "isha" };
                    }
                    @foreach (var name in prayerNames)
                    {
                        var azan = fardAzan.FirstOrDefault(p => p.PrayerName.StartsWith(name));
                        var jamaat = fardJamaat.FirstOrDefault(p => p.PrayerName.StartsWith(name));
                        var isNext = nextPrayer != null && jamaat != null && nextPrayer.Id == jamaat.Id;

                        <tr class="@(isNext ? "table-success fw-bold" : "")">
                            <td class="py-3">
                                <span class="fs-6 fw-semibold">@(jamaat?.DisplayNameEn ?? azan?.DisplayNameEn ?? name)</span>
                                @if (isNext)
                                {
                                    <span class="badge bg-emerald text-white ms-2">Current Next</span>
                                }
                            </td>
                            <td class="py-3 text-muted">@(jamaat?.DisplayNameBn ?? azan?.DisplayNameBn)</td>
                            <td class="py-3 text-center">
                                <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                                    @(azan != null ? azan.PrayerTimeValue.ToString(@"hh\:mm") : "--:--")
                                </span>
                            </td>
                            <td class="py-3 text-center">
                                <span class="badge bg-emerald text-white px-3 py-2 fs-6">
                                    @(jamaat != null ? jamaat.PrayerTimeValue.ToString(@"hh\:mm") : "--:--")
                                </span>
                            </td>
                            <td class="py-3 text-center">
                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Active</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Nafl / Sunnah Prayers -->
    <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-moon-stars-fill text-warning me-2"></i> Nafl & Voluntary Prayers</h4>
            <span class="badge bg-warning bg-opacity-15 text-dark px-3 py-2 rounded-pill fw-semibold">Nafl / Mustahab</span>
        </div>

        <div class="row g-3">
            @foreach (var nafl in naflPrayers)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="p-4 border rounded-4 bg-light text-center h-100">
                        <div class="text-muted small text-uppercase fw-bold">@nafl.DisplayNameEn</div>
                        <div class="text-dark fw-bold mb-2">@nafl.DisplayNameBn</div>
                        <div class="display-6 fw-extrabold text-emerald mb-2">
                            @nafl.PrayerTimeValue.ToString(@"hh\:mm")
                        </div>
                        <span class="badge bg-white border text-muted small">Recommended Time</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>