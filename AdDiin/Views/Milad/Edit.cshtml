@model AdDiin.Models.ViewModels.MiladCreateViewModel
@{
    ViewData["Title"] = "Edit Milad Booking";
    var reqId = ViewBag.RequestId;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm">
                <h4 class="fw-bold mb-4 text-dark">Edit Milad Booking Details</h4>

                <form asp-action="Edit" asp-route-id="@reqId" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Event Title *</label>
                        <input asp-for="Name" class="form-control py-2" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Contact Phone Number *</label>
                            <input asp-for="Phone" class="form-control py-2" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MiladDate" class="form-label fw-semibold">Preferred Event Date *</label>
                            <input asp-for="MiladDate" class="form-control py-2" />
                            <span asp-validation-for="MiladDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Purpose & Venue Details *</label>
                        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-emerald-gradient flex-grow-1 py-2 rounded-pill fw-bold">
                            Save Changes
                        </button>
                        <a asp-action="MyRequests" class="btn btn-outline-secondary py-2 rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>