@model AdDiin.Models.ViewModels.MiladCreateViewModel
@{
    ViewData["Title"] = "Book a Milad & Dua Mehfil";
}

<div class="bg-emerald-dark text-white py-5">
    <div class="container text-center py-3">
        <h1 class="display-5 fw-extrabold mb-2">🤲 Milad & Dua Mehfil Booking</h1>
        <p class="text-white-75 max-w-700 mx-auto">
            Book an Imam or Khatib for family Shukrana, Khatam-e-Quran, Milad-un-Nabi, or special family supplications.
        </p>
    </div>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-custom p-4 p-md-5 border rounded-4 bg-white shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0 text-dark">Submit Booking Request</h4>
                    <a asp-action="MyRequests" class="btn btn-outline-secondary btn-sm rounded-pill">
                        <i class="bi bi-clock-history me-1"></i> My Bookings
                    </a>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Event / Occasion Title *</label>
                        <input asp-for="Name" class="form-control py-2" placeholder="e.g. Shukrana Milad for Family Recovery / Khatam" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Contact Phone Number *</label>
                            <input asp-for="Phone" class="form-control py-2" placeholder="+880 1XXXXXXXXX" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MiladDate" class="form-label fw-semibold">Preferred Event Date *</label>
                            <input asp-for="MiladDate" class="form-control py-2" />
                            <span asp-validation-for="MiladDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Purpose & Venue / Address Details *</label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Provide event venue (Mosque hall vs Home residence), preferred timing (e.g. After Maghrib or Asr), and intentions..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-emerald-gradient w-100 py-3 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Submit Milad Booking Request
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>