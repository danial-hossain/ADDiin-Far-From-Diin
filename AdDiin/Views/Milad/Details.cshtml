@model AdDiin.Models.Entities.MiladRequest
@{
    ViewData["Title"] = "Milad Booking Details";
}

<div class="container my-5">
    <div class="card card-custom p-5 border rounded-4 bg-white shadow-sm max-w-700 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0 text-dark">Milad Booking #@Model.Id</h4>
            <a asp-action="MyRequests" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="p-4 bg-light rounded-4 border mb-4">
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted">Status:</span>
                <span class="badge bg-emerald text-white px-3 py-1 text-uppercase">@Model.Status</span>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted">Occasion:</span>
                <strong class="text-dark">@Model.Name</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted">Date:</span>
                <strong class="text-dark">@Model.MiladDate.ToString("dd MMMM, yyyy")</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <span class="text-muted">Contact Phone:</span>
                <span>@Model.Phone</span>
            </div>
            <div>
                <span class="text-muted d-block mb-1">Details / Venue:</span>
                <p class="text-dark mb-0 small leading-relaxed">@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.AdminRemark))
        {
            <div class="p-3 bg-emerald-light rounded-3 border border-emerald border-opacity-25 mb-3">
                <strong class="text-emerald-dark small d-block mb-1"><i class="bi bi-chat-quote-fill me-1"></i> Mosque Imam / Admin Remark:</strong>
                <p class="mb-0 small text-dark">@Model.AdminRemark</p>
            </div>
        }
    </div>
</div>