{
  "manifest_version": 3,
  "name": "ADDiin Focus Shield - Far Mode",
  "version": "1.0.2",
  "description": "Syncs with your ADDiin Focus Hub to block or unblock social media when Shield is ON/OFF.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5091/*",
        "https://localhost:7198/*",
        "https://localhost:7214/*"
      ],
      "js": ["sync_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ADDiin Focus Shield"
  }
}
